{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block title %}{{ routine.name|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {
        title: routine.name,
        subtitle: app.user.nickname|formatInitials,
    } only %}
{% endblock %}

{% block state %}
    <div class="flex-1 overflow-y-auto px-7 pt-6 pb-[120px] max-md:px-4 max-md:pb-[160px]">
        <div class="max-w-[960px] mx-auto">

            {{ component('Breadcrumb:Breadcrumb', {
                items: [
                    {label: 'routine.list.title'|trans({}, 'navigation'), url: 'app_routine_list'},
                    {label: routine.name, url: null},
                ]
            }) }}

            <header class="mb-7">
                <h1 class="font-rajdhani text-[28px] font-bold text-[#f1f5f9] mb-1">
                    {{ routine.name }}
                </h1>
                {% if routine.description %}
                    <p class="mt-3 text-sm leading-relaxed text-slate-400">
                        {{ routine.description }}
                    </p>
                {% endif %}
            </header>

            {% if hasBodyweightWarning %}
                <div class="flex items-start gap-2.5 mb-6 px-4 py-3.5 bg-[rgba(244,63,94,0.06)] border border-[rgba(244,63,94,0.25)] rounded-xl text-[13px] text-[#f0f4ff]">
                    <svg class="w-4.5 h-4.5 mt-0.5 flex-shrink-0 text-[#f43f5e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>
                        {{ 'routine.show.bodyweight_warning'|trans({}, 'navigation') }}
                        <a href="{{ path('app_settings') }}#fieldBodyweight" class="underline text-[#f43f5e] hover:text-[#ff6b85]">
                            {{ 'settings.bodyweight.label'|trans({}, 'navigation') }}
                        </a>
                    </span>
                </div>
            {% endif %}

            {% include 'routine/show/_muscles.html.twig' with {
                allPrimarySvgIds: allPrimarySvgIds,
                allSecondarySvgIds: allSecondarySvgIds,
                user: user,
            } only %}

            {% include 'routine/show/_exercises.html.twig' with {
                routineExercises: routineExercises,
            } only %}

            {% if not hasUsage %}
                <div class="bg-bg-card border border-white/[0.07] rounded-2xl p-10 text-center">
                    <p class="text-sm text-[#64748b]">{{ 'routine.show.empty_usage'|trans({}, 'navigation') }}</p>
                </div>
            {% else %}
                {% include 'routine/show/_stats.html.twig' with {
                    usageCount: usageCount,
                    lastUsedAt: lastUsedAt,
                    averageDurationMinutes: averageDurationMinutes,
                } only %}

                {% include 'routine/show/_usage_periods.html.twig' with {
                    weekCount: weekCount,
                    monthCount: monthCount,
                    yearCount: yearCount,
                } only %}
            {% endif %}

        </div>
    </div>
{% endblock %}
