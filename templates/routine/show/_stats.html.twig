{#
templates/routine/show/_stats.html.twig

Paramètres (via `only`) :
  - usageCount : int
  - lastUsedAt : ?DateTimeImmutable
  - averageDurationMinutes : ?int
#}
<section class="mb-7">
    <h2 class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4] mb-3">
        {{ 'routine.show.usage.title'|trans({}, 'navigation') }}
    </h2>

    <div class="grid {{ averageDurationMinutes is not null ? 'grid-cols-3' : 'grid-cols-2' }} gap-3 max-md:grid-cols-1">
        <div class="bg-bg-card border border-white/[0.07] rounded-2xl p-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.5px] text-[#64748b] mb-1.5">
                {{ 'routine.show.usage.count_label'|trans({}, 'navigation') }}
            </div>
            <div class="font-rajdhani text-[22px] font-bold text-[#f1f5f9]">
                {{ usageCount }}
            </div>
        </div>

        <div class="bg-bg-card border border-white/[0.07] rounded-2xl p-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.5px] text-[#64748b] mb-1.5">
                {{ 'routine.show.usage.last_used_label'|trans({}, 'navigation') }}
            </div>
            <div class="font-rajdhani text-[16px] font-bold text-[#f1f5f9]">
                {% if lastUsedAt %}
                    {{ lastUsedAt|format_date('medium', locale=app.request.locale) }}
                {% else %}
                    —
                {% endif %}
            </div>
        </div>

        {% if averageDurationMinutes is not null %}
            <div class="bg-bg-card border border-white/[0.07] rounded-2xl p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.5px] text-[#64748b] mb-1.5">
                    {{ 'routine.show.usage.average_duration_label'|trans({}, 'navigation') }}
                </div>
                <div class="font-rajdhani text-[22px] font-bold text-[#f1f5f9]">
                    {{ averageDurationMinutes|format_hour }}
                </div>
            </div>
        {% endif %}
    </div>
</section>
