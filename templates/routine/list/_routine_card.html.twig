{#
templates/routine/list/_routine_card.html.twig

Paramètres :
  - routine              : Routine
  - hasBodyweightWarning : bool
  - workoutCount         : int (séances basées sur cette routine)
#}
{% set exercises = routine.routineExercises %}
{% set total = exercises|length %}
{% set max_displayed = 10 %}
{% set displayed = exercises|slice(0, max_displayed) %}
{% set remaining = total - max_displayed %}

<div class="routine-card">

    <div class="routine-card__header">
        <div class="routine-card__meta">
            <h2 class="routine-card__name">
                {{ routine.name }}
                {% if hasBodyweightWarning %}
                    <span class="routine-card__bodyweight-warning"
                          title="{{ 'routine.show.bodyweight_warning'|trans({}, 'navigation') }}"
                          aria-label="{{ 'routine.show.bodyweight_warning'|trans({}, 'navigation') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </span>
                {% endif %}
            </h2>
            <div class="flex flex-wrap items-center gap-1.5">
                <span class="routine-card__count">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                    </svg>
                    {{ 'routine.list.exercise_count'|trans({count: total}, 'navigation') }}
                </span>
                {% if routine.archived %}
                    <span class="routine-card__count">
                        {{ 'routine.list.workout_count'|trans({count: workoutCount}, 'navigation') }}
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="routine-card__actions">
            {% if routine.archived %}
                {% include 'routine/list/_restore_action.html.twig' with {routine: routine} only %}
            {% else %}
                {% include 'routine/list/_routine_actions.html.twig' with {routine: routine, workoutCount: workoutCount} only %}
            {% endif %}
        </div>
    </div>

    <ul class="routine-card__exercises">
        {% for routine_exercise in displayed %}
            {% set exercise = routine_exercise.exercise %}
            <li>
                {{ exercise.isPublic ? (exercise.name|trans({}, 'exercise')) : exercise.name }}
            </li>
        {% endfor %}
    </ul>

    {% if remaining > 0 %}
        <p class="routine-card__more">
            {{ 'routine.list.more_exercises'|trans({count: remaining}, 'navigation') }}
        </p>
    {% endif %}

    <div class="routine-card__divider"></div>

    <p class="routine-card__date">
        {{ 'routine.list.created_at'|trans({date: routine.createdAt|date('d/m/Y')}, 'navigation') }}
    </p>

</div>
