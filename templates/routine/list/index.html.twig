{#
    templates/routine/list/index.html.twig

    Page liste des routines de l'utilisateur.
    Controller : RoutineListController (GET /{_locale}/mes-routines)

    Variables passées par le controller :
      - pagination         : PaginationInterface<int, Routine>
      - count              : int (nombre total de routines, toutes pages confondues)
      - countLabels        : list<string> (libellé traduit du compteur pour chaque valeur de 0 à count)
      - limitAllowed       : int[]
      - bodyweightWarnings : array<string, bool> (routine.id => routine contient un exercice PDC
                              alors que l'utilisateur n'a pas de poids corporel renseigné)
      - workoutCounts      : array<string, int> (routine.id => nombre de séances, absent si aucune)
      - archivedCount      : int (nombre total de routines archivées)
      - showArchived       : bool (onglet « Archivées » ouvert)
#}
{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/routine-list.css') }}">
{% endblock %}

{% block title %}{{ 'routine.list.title'|trans({}, 'navigation')|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {
        title: 'routine.list.title'|trans({}, 'navigation'),
        subtitle: app.user.nickname|formatInitials,
        action: {
            label: 'routine.list.create_btn'|trans({}, 'navigation'),
            url: path('app_routine_create'),
        },
    } only %}
{% endblock %}

{% block state %}
    <div class="flex-1 relative overflow-y-auto overflow-x-hidden px-7 pt-6 pb-[120px] max-md:px-4 max-md:pb-4">

        {% if archivedCount > 0 %}
            {% include 'routine/list/_tabs.html.twig' with {showArchived: showArchived, archivedCount: archivedCount} only %}
        {% endif %}

        {% if pagination.getTotalItemCount() == 0 %}
            {% include 'routine/list/_empty_state.html.twig' only %}
        {% else %}
            {% include 'routine/list/_routine_count.html.twig' with {count: count, countLabels: countLabels} only %}

            <div class="routines-grid mt-5">
                {% for routine in pagination %}
                    {% include 'routine/list/_routine_card.html.twig' with {
                        routine: routine,
                        hasBodyweightWarning: bodyweightWarnings[routine.id] ?? false,
                        workoutCount: workoutCounts[routine.id] ?? 0,
                    } only %}
                {% endfor %}
            </div>

            {% include '_pagination/_pagination.html.twig' with {
                'pagination': pagination,
                'route': 'app_routine_list',
                'routeParams': showArchived ? {view: 'archived'} : {},
                'limitAllowed': limitAllowed,
            } only %}
        {% endif %}

    </div>
{% endblock %}
