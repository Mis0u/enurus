{#
templates/routine/list/_routine_actions.html.twig

Une routine déjà utilisée est archivée plutôt que supprimée (RoutineDeletionService) : la pop-up
l'annonce avant de confirmer.

Paramètres :
  - routine      : Routine
  - workoutCount : int
#}
{% set will_archive = workoutCount > 0 %}

<a
    href="{{ path('app_routine_show', {id: routine.id}) }}"
    class="routine-action-btn show"
    title="{{ 'routine.list.actions.show'|trans({}, 'navigation') }}"
    aria-label="{{ 'routine.list.actions.show'|trans({}, 'navigation') }} {{ routine.name }}"
>
    {% include 'partials/_svg/_chart.html.twig' with {'width': 3.75, 'height': 3.75, 'ariaHidden': true} only %}
</a>

<a
    href="{{ path('app_routine_edit', {id: routine.id}) }}"
    class="routine-action-btn edit"
    title="{{ 'field.form.button.edit'|trans({}, 'common') }}"
>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
    </svg>
</a>

<div
    data-controller="routine--delete"
    data-routine--delete-url-value="{{ path('app_routine_delete', {id: routine.id}) }}"
    data-routine--delete-csrf-token-value="{{ csrf_token('routine_delete_' ~ routine.id) }}"
    data-routine--delete-confirm-title-value="{{ will_archive ? 'routine.delete.archive_confirm_title'|trans({}, 'navigation') : 'routine.delete.confirm_title'|trans({}, 'navigation') }}"
    data-routine--delete-confirm-text-value="{{ will_archive ? 'routine.delete.archive_confirm_text'|trans({name: routine.name, count: workoutCount}, 'navigation') : 'routine.delete.confirm_text'|trans({name: routine.name, gender: app.user.gender.value}, 'navigation') }}"
    data-routine--delete-confirm-button-value="{{ will_archive ? 'routine.delete.archive_confirm_button'|trans({}, 'navigation') : 'routine.delete.confirm_button'|trans({}, 'navigation') }}"
    data-routine--delete-cancel-button-value="{{ 'routine.delete.cancel_button'|trans({}, 'navigation') }}"
    data-routine--delete-error-text-value="{{ 'routine.delete.error_text'|trans({}, 'navigation') }}"
>
    <button
        type="button"
        class="routine-action-btn delete"
        title="{{ 'field.form.button.delete'|trans({}, 'common') }}"
        data-action="click->routine--delete#confirmDelete"
    >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
    </button>
</div>
