{#
    templates/routine/edit/_selected_exercises.html.twig

    Colonne droite édition — exercices pré-remplis + boutons.
    Spécifique à l'édition car les items sont rendus côté Twig (pré-remplissage).

    Paramètres :
      - form           : FormView
      - controllerName : string
      - cancelUrl      : string
      - routine        : Routine
#}
<div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-[22px] flex flex-col">

    {# Header dynamique mis à jour par Stimulus #}
    <div class="flex items-center justify-between gap-3 mb-4">
        <h2 class="font-rajdhani text-base font-bold text-[#f0f4ff]">
            {{ 'routine.form.your_routine'|trans({}, 'navigation') }}
        </h2>
        <div class="flex items-center gap-2 min-w-0">
            <span
                class="text-[12px] text-[#8b9bb4] font-medium truncate max-w-[120px]"
                data-{{ controllerName }}-target="summaryName"
            >{{ routine.name }}</span>
            <span
                class="flex-shrink-0 inline-flex items-center px-2 py-[2px] rounded-[6px] text-[11px] font-semibold bg-white/[0.06] border border-white/[0.10] text-[#8b9bb4]"
                data-{{ controllerName }}-target="summaryCount"
            ></span>
        </div>
    </div>

    {# Input hidden — JSON des exercices ordonnés #}
    {{ form_widget(form.exercises) }}

    {# État vide — masqué par défaut si des exercices existent #}
    <div
        class="flex flex-col items-center justify-center gap-2 py-8 text-[13px] text-[#4a5568] italic text-center border border-dashed border-white/[0.08] rounded-[10px]"
        data-{{ controllerName }}-target="emptyState"
        {% if routine.routineExercises is not empty %}hidden{% endif %}
    >
        <svg class="w-7 h-7 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
        </svg>
        <span>{{ 'routine.form.empty_selection'|trans({}, 'navigation') }}</span>
    </div>

    {# Liste triable SortableJS — pré-remplie avec les exercices existants #}
    <div
        class="flex flex-col gap-2"
        data-{{ controllerName }}-target="selectedList"
    >
        {% for routine_exercise in routine.routineExercises %}
            {% set exercise = routine_exercise.exercise %}
            {% set exercise_name = exercise.isPublic ? (exercise.name|trans({}, 'exercise')) : exercise.name %}
            <div
                class="routine-selected-item-enter flex items-center gap-2.5 bg-[#080e1a] border border-white/[0.07] rounded-[10px] px-3.5 py-[11px] transition-colors duration-200 hover:border-white/[0.12]"
                data-exercise-id="{{ exercise.id }}"
            >
                <div class="routine-drag-handle cursor-grab text-[#4a5568] p-0.5 flex-shrink-0 hover:text-[#8b9bb4] active:cursor-grabbing">
                    <svg class="w-3.5 h-5" viewBox="0 0 14 20" fill="currentColor">
                        <circle cx="4" cy="4" r="1.5"></circle><circle cx="10" cy="4" r="1.5"></circle>
                        <circle cx="4" cy="10" r="1.5"></circle><circle cx="10" cy="10" r="1.5"></circle>
                        <circle cx="4" cy="16" r="1.5"></circle><circle cx="10" cy="16" r="1.5"></circle>
                    </svg>
                </div>
                <span
                    class="font-rajdhani text-[13px] font-bold text-rose-500/50 w-5 text-center flex-shrink-0"
                    data-{{ controllerName }}-target="itemPosition"
                >#{{ loop.index }}</span>
                <div class="flex-1 min-w-0">
                    <p class="text-[13.5px] font-medium text-[#f0f4ff] truncate mb-[3px]">{{ exercise_name }}</p>
                    <div class="flex gap-1 flex-wrap">
                        {% for em in exercise.exerciseMuscles %}
                            {% if em.type.value == 'primary' %}
                                <span data-muscle-type="primary" class="inline-flex px-[7px] py-[2px] rounded-[5px] text-[10.5px] font-medium bg-rose-500/[0.10] border border-rose-500/20 text-rose-400">
                                    {{ em.muscleGroup.name|trans({}, 'muscle') }}
                                </span>
                            {% else %}
                                <span data-muscle-type="secondary" class="inline-flex px-[7px] py-[2px] rounded-[5px] text-[10.5px] font-medium bg-orange-500/[0.10] border border-orange-500/20 text-orange-400">
                                    {{ em.muscleGroup.name|trans({}, 'muscle') }}
                                </span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                <button
                    type="button"
                    class="w-[26px] h-[26px] rounded-[6px] border border-transparent bg-transparent text-[#4a5568] flex items-center justify-center flex-shrink-0 cursor-pointer transition-all duration-200 hover:bg-rose-500/[0.12] hover:border-rose-500/30 hover:text-rose-500"
                    data-action="click->{{ controllerName }}#removeExercise"
                    data-exercise-id="{{ exercise.id }}"
                >
                    <svg class="w-[13px] h-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        {% endfor %}
    </div>

    <div class="h-px bg-white/[0.05] my-4"></div>

    <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
        <a
            href="{{ cancelUrl }}"
            class="inline-flex items-center justify-center px-5 py-[11px] bg-transparent border border-white/[0.07] rounded-[10px] text-[#8b9bb4] font-dm-sans text-[13.5px] font-medium no-underline transition-all duration-200 hover:border-white/[0.15] hover:text-[#f0f4ff] whitespace-nowrap"
        >
            {{ 'field.form.button.cancel'|trans({}, 'common') }}
        </a>
        <button
            type="submit"
            class="cursor-pointer inline-flex items-center justify-center gap-2 py-[11px] px-5 bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white text-[13.5px] font-bold rounded-[10px] shadow-lg shadow-rose-500/30 hover:shadow-rose-500/50 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2 focus:ring-offset-slate-900 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none"
            data-{{ controllerName }}-target="submitBtn"
        >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            {{ 'routine.edit.submit'|trans({}, 'navigation') }}
        </button>
    </div>

</div>
