{#
    templates/routine/create/_form_info.html.twig

    Section "Infos de la routine" — Nom + Description (accordéon optionnel).
    Réutilisée en création ET en édition via controllerName.

    Paramètres :
      - form           : FormView
      - controllerName : string
#}
<div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-[22px]">

    {{ form_label(form.name) }}
    {{ form_widget(form.name) }}
    {{ form_errors(form.name) }}

    <div class="h-px bg-white/[0.05] my-[18px]"></div>

    {# Accordéon description — optionnel #}
    <button
        type="button"
        class="flex items-center justify-between w-full bg-transparent border-none cursor-pointer p-0 text-left group"
        data-action="click->{{ controllerName }}#toggleAccordion"
        aria-expanded="false"
        aria-controls="description-body"
    >
        <div class="flex items-center gap-2.5">
            <span class="text-sm font-medium text-[#64748b] transition-colors duration-200 group-hover:text-[#f1f5f9]">
                {{ 'routine.form.description_label'|trans({}, 'navigation') }}
            </span>
            <span class="text-[11px] font-semibold px-2 py-px rounded bg-[rgba(6,182,212,0.12)] text-[#06b6d4] border border-[rgba(6,182,212,0.3)]">
                {{ 'routine.form.optional'|trans({}, 'navigation') }}
            </span>
        </div>
        <span class="text-[#64748b] transition-transform duration-200" aria-hidden="true">
        {% include 'partials/_svg/_down_arrow.html.twig' %}
    </span>
    </button>

    <div
        id="description-body"
        data-{{ controllerName }}-target="accordionBody"
        style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;"
    >
        <div class="pt-3">
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
    </div>

</div>
