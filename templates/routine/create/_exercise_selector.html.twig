{#
    templates/routine/create/_exercise_selector.html.twig

    Paramètres :
      - controllerName          : string
      - muscleGroups            : list<MuscleGroup> (triés alphabétiquement)
      - exercises               : list<Exercise>
      - primaryMuscleIds        : array<string, string> exerciseId => IDs SVG des muscles primaires séparés par virgule
      - secondaryMuscleIds      : array<string, string> exerciseId => IDs SVG des muscles secondaires séparés par virgule
      - primaryMuscleGroupIds   : array<string, string> exerciseId => IDs (UUID) des groupes musculaires primaires séparés par virgule
      - secondaryMuscleGroupIds : array<string, string> exerciseId => IDs (UUID) des groupes musculaires secondaires séparés par virgule
#}
<div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-[22px] flex flex-col min-w-0 overflow-visible">

    <div class="flex items-center gap-2.5 mb-4">
        <h2 class="font-rajdhani text-base font-bold text-[#f0f4ff]">
            {{ 'routine.form.exercises_label'|trans({}, 'navigation') }}
        </h2>
    </div>

    {# Barre de recherche #}
    <div class="relative mb-3.5">
        {% include 'partials/_svg/_magnifying_glass.html.twig' with {'width': 4, 'height': 4, 'extraClass': 'absolute left-3 top-1/2 -translate-y-1/2 text-[#4a5568] pointer-events-none'} only %}
        <input
            type="text"
            class="w-full bg-[#080e1a] border border-white/[0.07] rounded-[10px] pl-[38px] pr-4 py-3 text-[#f0f4ff] font-dm-sans text-sm outline-none transition-all duration-200 placeholder:text-[#4a5568] focus:border-rose-500/50 focus:shadow-[0_0_0_3px_rgba(244,63,94,0.08)]"
            placeholder="{{ 'routine.form.search_placeholder'|trans({}, 'navigation') }}"
            data-{{ controllerName }}-target="searchInput"
            data-action="input->{{ controllerName }}#filterExercises"
        >
    </div>

    {# Filtre par muscle — 1er clic = primaire (rouge), 2e clic = secondaire (cyan), 3e clic = aucun #}
    <details class="mb-3.5">
        <summary class="cursor-pointer text-[13px] font-medium text-white/60 hover:text-white/80 select-none">
            {{ 'routine.form.muscle_filter.toggle'|trans({}, 'navigation') }}
            <span data-{{ controllerName }}-target="muscleFilterCount" hidden class="text-[#f43f5e]"></span>
        </summary>
        <div class="flex flex-wrap gap-2 mt-3">
            {% for muscle_group in muscleGroups %}
                <button
                    type="button"
                    class="muscle-filter-chip inline-flex items-center px-3 py-1.5 rounded-full text-[13px] font-medium border border-white/[0.07] bg-[#080e1a] text-white/70 transition-colors duration-150 cursor-pointer select-none"
                    data-state="none"
                    data-muscle-id="{{ muscle_group.id }}"
                    data-{{ controllerName }}-target="muscleFilterChip"
                    data-action="click->{{ controllerName }}#cycleMuscleFilter"
                >
                    {{ muscle_group.name|trans({}, 'muscle') }}
                </button>
            {% endfor %}
        </div>
    </details>

    {# Liste d'exercices scrollable #}
    <div
        class="flex flex-col gap-2 overflow-y-auto"
        style="max-height: 380px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.07) transparent;"
        data-{{ controllerName }}-target="exerciseList"
    >
        {% for exercise in exercises %}
            {% set exercise_name = exercise.isPublic ? (exercise.name|trans({}, 'exercise')) : exercise.name %}
            <div
                class="flex items-center gap-3 bg-[#080e1a] border border-white/[0.07] rounded-[10px] px-3.5 py-[11px] transition-all duration-200"
                data-{{ controllerName }}-target="exerciseItem"
                data-exercise-id="{{ exercise.id }}"
                data-exercise-name="{{ exercise_name }}"
                data-muscle-ids="{{ primaryMuscleIds[exercise.id] ?? '' }}"
                data-secondary-muscle-ids="{{ secondaryMuscleIds[exercise.id] ?? '' }}"
                data-primary-muscle-group-ids="{{ primaryMuscleGroupIds[exercise.id] ?? '' }}"
                data-secondary-muscle-group-ids="{{ secondaryMuscleGroupIds[exercise.id] ?? '' }}"
            >
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[13.5px] font-medium text-[#f0f4ff] truncate">
                            {{ exercise_name }}
                        </span>
                        {% if exercise.isPublic %}
                            <span class="text-[10px] font-semibold text-cyan-400 whitespace-nowrap flex-shrink-0">
                                {{ 'routine.badge.base'|trans({}, 'navigation') }}
                            </span>
                        {% else %}
                            <span class="text-[10px] font-semibold text-rose-500 whitespace-nowrap flex-shrink-0">
                                {{ 'routine.badge.mine'|trans({}, 'navigation') }}
                            </span>
                        {% endif %}
                    </div>
                    {# data-muscle-type permet au JS de récupérer les labels sans parsing CSS #}
                    <div class="flex gap-1 flex-wrap">
                        {% for em in exercise.exerciseMuscles %}
                            {% if em.type.value == 'primary' %}
                                <span
                                    data-muscle-type="primary"
                                    class="inline-flex px-[7px] py-[2px] rounded-[5px] text-[10.5px] font-medium bg-rose-500/[0.10] border border-rose-500/20 text-rose-400"
                                >{{ em.muscleGroup.name|trans({}, 'muscle') }}</span>
                            {% else %}
                                <span
                                    data-muscle-type="secondary"
                                    class="inline-flex px-[7px] py-[2px] rounded-[5px] text-[10.5px] font-medium bg-cyan-500/[0.10] border border-cyan-500/20 text-cyan-400"
                                >{{ em.muscleGroup.name|trans({}, 'muscle') }}</span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                <button
                    type="button"
                    class="w-7 h-7 rounded-[7px] border border-white/[0.07] bg-white/[0.04] text-[#8b9bb4] flex items-center justify-center flex-shrink-0 cursor-pointer transition-all duration-200 hover:bg-rose-500/[0.15] hover:border-rose-500/40 hover:text-rose-500 hover:scale-[1.06]"
                    data-{{ controllerName }}-target="addButton"
                    data-action="click->{{ controllerName }}#toggleExercise"
                    data-exercise-id="{{ exercise.id }}"
                >
                    {% include 'partials/_svg/_add.html.twig' with {'width': 3.5, 'height': 3.5} only %}
                </button>
            </div>
        {% endfor %}
    </div>

    <p
        class="text-center text-[13px] text-white/40 py-6"
        data-{{ controllerName }}-target="searchEmptyState"
        hidden
    >
        {{ 'routine.form.no_result'|trans({}, 'navigation') }}
    </p>

</div>
