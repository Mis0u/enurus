{#
    Une section de la page Aide, repliable. L'`id` est l'ancre de la section (HelpSectionEnum::value).
    Variables attendues (via `only`) :
    - section : HelpSectionEnum
    - open    : bool — ouverte au chargement (la première : « Par où commencer »)
    - pointParams : map — paramètres ICU passés à chaque point (HelpController::pointParams())
#}
{% set title_key = 'section.' ~ section.value ~ '.title' %}
<details id="{{ section.value }}"
         class="group/collapsible bg-bg-card border border-white/[0.07] rounded-2xl p-4 md:p-[22px] scroll-mt-4"
         data-help--sections-target="section"
         {% if open %}open{% endif %}>
    <summary class="flex items-center gap-3 max-md:min-h-11 cursor-pointer list-none select-none rounded-lg [&::-webkit-details-marker]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-rose-ft">
        <span class="shrink-0 text-rose-ft [&>svg]:w-[18px] [&>svg]:h-[18px]" aria-hidden="true">
            {% include 'partials/_svg/_' ~ section.icon ~ '.html.twig' only %}
        </span>
        <h2 class="flex-1 font-rajdhani text-lg font-bold text-[#f0f4ff]">{{ title_key|trans({}, 'help') }}</h2>
        <span class="shrink-0 text-[#8b9bb4] transition-transform duration-200 group-open/collapsible:rotate-180" aria-hidden="true">
            {% include 'partials/_svg/_down_arrow.html.twig' only %}
        </span>
    </summary>

    <p class="text-sm text-[#cbd5e1] leading-relaxed mt-3">
        {{ ('section.' ~ section.value ~ '.intro')|trans({}, 'help') }}
    </p>

    <ul class="flex flex-col gap-2.5 mt-3">
        {% for point in section.points %}
            <li class="flex gap-2.5 text-sm text-[#8b9bb4] leading-relaxed">
                <span class="shrink-0 mt-[9px] w-1.5 h-1.5 rounded-full bg-rose-ft" aria-hidden="true"></span>
                <span>{{ ('section.' ~ section.value ~ '.points.' ~ point)|trans(pointParams, 'help') }}</span>
            </li>
        {% endfor %}
    </ul>

    <a href="{{ path(section.route) }}"
       class="mt-4 inline-flex items-center gap-1.5 max-md:min-h-11 text-[13px] font-semibold text-rose-ft hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-ft rounded">
        {{ ('section.' ~ section.value ~ '.open')|trans({}, 'help') }} <span aria-hidden="true">→</span>
    </a>
</details>
