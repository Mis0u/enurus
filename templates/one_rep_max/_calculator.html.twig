{#
    Saisie de la série et 1RM estimé, calculé par one_rep_max/calculator_controller.js.

    Paramètres :
      - unit : UnitOfMeasureEnum — unité de départ (celle du compte, kg pour un visiteur).
      - units : list<UnitOfMeasureEnum>
      - exampleWeight : int — série d'exemple, pour montrer un résultat sans rien saisir.
      - exampleReps : int
#}
<div class="flex-[1_1_440px] min-w-0 flex flex-col gap-5 p-6 rounded-2xl border border-white/[0.07] bg-bg-card">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-rajdhani font-bold text-[22px] text-slate-50">{{ 'form.title'|trans({}, 'one_rep_max') }}</h2>
        <div role="group" aria-label="{{ 'form.unit'|trans({}, 'one_rep_max') }}" class="flex gap-1 p-1 rounded-[10px] bg-white/[0.04]">
            {% for option in units %}
                <button type="button"
                        aria-pressed="{{ option == unit ? 'true' : 'false' }}"
                        data-one-rep-max--calculator-target="unitButton"
                        data-one-rep-max--calculator-unit-param="{{ option.value }}"
                        data-action="one-rep-max--calculator#pickUnit"
                        class="min-w-14 min-h-11 px-3 rounded-lg text-sm font-medium text-slate-400 cursor-pointer transition-colors hover:text-white aria-pressed:bg-rose-ft aria-pressed:font-bold aria-pressed:text-white">
                    {{ option.value }}
                </button>
            {% endfor %}
        </div>
    </div>

    <div class="flex flex-wrap gap-4">
        <div class="flex-[1_1_160px] min-w-0 flex flex-col gap-2">
            <label for="one-rep-max-weight" class="text-xs font-bold uppercase tracking-[0.5px] text-slate-400">{{ 'form.weight'|trans({}, 'one_rep_max') }}</label>
            <div class="relative">
                <input id="one-rep-max-weight" type="number" inputmode="decimal" min="0" step="0.5" value="{{ exampleWeight }}"
                       data-one-rep-max--calculator-target="weight"
                       data-action="input->one-rep-max--calculator#compute"
                       class="w-full h-13 pl-4 pr-14 rounded-[10px] border border-slate-700 bg-bg-base font-rajdhani font-bold text-2xl text-slate-50 focus:outline-none focus:border-cyan-400">
                <span data-one-rep-max--calculator-target="unitLabel" class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-medium text-slate-400">{{ unit.value }}</span>
            </div>
        </div>
        <div class="flex-[1_1_160px] min-w-0 flex flex-col gap-2">
            <label for="one-rep-max-reps" class="text-xs font-bold uppercase tracking-[0.5px] text-slate-400">{{ 'form.reps'|trans({}, 'one_rep_max') }}</label>
            <input id="one-rep-max-reps" type="number" inputmode="numeric" min="1" step="1" value="{{ exampleReps }}"
                   aria-describedby="one-rep-max-reps-hint"
                   data-one-rep-max--calculator-target="reps"
                   data-action="input->one-rep-max--calculator#compute"
                   class="w-full h-13 px-4 rounded-[10px] border border-slate-700 bg-bg-base font-rajdhani font-bold text-2xl text-slate-50 focus:outline-none focus:border-cyan-400">
            <span id="one-rep-max-reps-hint" class="text-xs text-slate-400">{{ 'form.reps_hint'|trans({}, 'one_rep_max') }}</span>
        </div>
    </div>

    <div aria-live="polite" class="pt-5 border-t border-white/[0.07]">
        <div data-one-rep-max--calculator-target="result" hidden class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.5px] text-slate-400">{{ 'result.label'|trans({}, 'one_rep_max') }}</span>
            <p class="flex items-baseline gap-2">
                <span data-one-rep-max--calculator-target="oneRepMax" class="font-rajdhani font-bold text-[64px] leading-none text-rose-ft"></span>
                <span data-one-rep-max--calculator-target="unitLabel" class="font-rajdhani font-semibold text-2xl text-slate-50">{{ unit.value }}</span>
            </p>
            <span class="text-[13px] text-slate-400">{{ 'result.formula'|trans({}, 'one_rep_max') }}</span>
        </div>
        <p data-one-rep-max--calculator-target="invalid" hidden class="text-sm text-slate-300">{{ 'result.invalid'|trans({}, 'one_rep_max') }}</p>
    </div>

    <div data-one-rep-max--calculator-target="warning" hidden class="flex items-start gap-2.5 px-3.5 py-3 rounded-[10px] border border-amber-500/30 bg-amber-500/10">
        <svg class="w-4.5 h-4.5 shrink-0 mt-px text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"></path></svg>
        <p class="text-[13px] leading-normal text-amber-200">{{ 'result.warning'|trans({}, 'one_rep_max') }}</p>
    </div>
</div>
