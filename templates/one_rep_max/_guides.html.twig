{#
    Paramètres :
      - guideLinks : list<ExerciseGuideLink> — fiches des grands mouvements.
#}
<section aria-labelledby="one-rep-max-guides" class="flex flex-col gap-4">
    <h2 id="one-rep-max-guides" class="font-rajdhani font-bold text-3xl text-slate-50">{{ 'guides.title'|trans({}, 'one_rep_max') }}</h2>
    <ul class="flex flex-wrap gap-3">
        {% for guide_link in guideLinks %}
            <li class="flex-[1_1_220px] min-w-0">
                <a href="{{ path('app_exercise_guide_show', {slug: guide_link.slug}) }}" class="flex items-center justify-between gap-3 min-h-16 px-5 rounded-[14px] border border-white/[0.07] bg-bg-card font-medium text-slate-50 no-underline hover:bg-bg-card-hover">
                    {{ guide_link.nameKey|trans({}, 'exercise') }}
                    <svg class="w-4.5 h-4.5 shrink-0 text-rose-ft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
            </li>
        {% endfor %}
    </ul>
</section>
