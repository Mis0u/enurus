<!DOCTYPE html>
<html lang="{% block html_lang %}{{ app.request.locale }}{% endblock %}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{{ 'name'|trans({}, 'brand') }}{% endblock %}</title>
        {# Séparé du bloc `meta`, que certaines pages remplacent (ex. turbo-cache-control en création
           de séance) : la description reste présente partout. #}
        {% block seo %}
            {% include 'partials/_common/_seo_meta.html.twig' with {
                title: block('title'),
                description: 'seo.description'|trans({}, 'brand'),
            } only %}
        {% endblock %}
        {% block hreflang %}
            {% include 'partials/_common/_hreflang.html.twig' with {alternates: locale_alternates()} only %}
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon/favicon.ico') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon/favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/favicon/favicon-16x16.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/favicon/apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('images/favicon/android-chrome-192x192.png') }}">
        <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('images/favicon/android-chrome-512x512.png') }}">
        <link rel="manifest" href="/manifest.json">
        <meta name="theme-color" content="#f43f5e">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Enurus">
        {% block meta %}{% endblock %}
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            {# Polices du premier écran (texte courant, titres) préchargées : sans ça, le navigateur
               ne les découvre qu'après avoir lu fonts.css. #}
            <link rel="preload" href="{{ asset('fonts/dm-sans-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
            <link rel="preload" href="{{ asset('fonts/rajdhani-latin-700-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
            <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
