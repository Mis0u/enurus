{# Params: gender #}
<div class="bg-[#111827] border border-white/[0.07] rounded-xl p-6">
    <h2 class="font-rajdhani text-[17px] font-bold text-[#f1f5f9] mb-1">
        {{ 'exercise.form.preview_label'|trans({}, 'navigation') }}
    </h2>

    <div class="svg-body-container flex items-center justify-center gap-10 mb-4 max-md:gap-5">
        <div class="w-[160px] max-md:w-[120px] [&_svg]:!h-auto [&_svg]:max-h-[300px]">
            {% include 'SVG_BODY/' ~ gender.value ~ '/front.html.twig' %}
        </div>
        <div class="w-[160px] max-md:w-[120px] [&_svg]:!h-auto [&_svg]:max-h-[300px]">
            {% include 'SVG_BODY/' ~ gender.value ~ '/back.html.twig' %}
        </div>
    </div>

    <div class="flex items-center justify-center gap-6 text-[12.5px] text-[#64748b]">
        <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#f43f5e] shrink-0"></span>
            {{ 'exercise.form.legend_primary'|trans({}, 'navigation') }}
        </div>
        <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#f97316] shrink-0"></span>
            {{ 'exercise.form.legend_secondary'|trans({}, 'navigation') }}
        </div>
    </div>
</div>
