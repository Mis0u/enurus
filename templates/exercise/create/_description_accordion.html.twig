{# Params: form, controllerName #}
{% set toggle_action = 'click->%s#toggleAccordion'|format(controllerName) %}

<div class="bg-[#111827] border border-white/[0.07] rounded-xl p-6">
    <div id="description-accordion" data-{{ controllerName }}-target="accordion">

        <button
            type="button"
            class="flex items-center justify-between w-full bg-transparent border-none cursor-pointer p-0 text-left group"
            data-action="{{ toggle_action }}"
            aria-expanded="false"
            aria-controls="description-body"
        >
            <div class="flex items-center gap-2.5">
                <span class="text-sm font-medium text-[#64748b] transition-colors duration-200 group-hover:text-[#f1f5f9]">
                    {{ 'exercise.form.description_toggle'|trans({}, 'navigation') }}
                </span>
                <span class="text-[11px] font-semibold px-2 py-px rounded bg-[rgba(6,182,212,0.12)] text-[#06b6d4] border border-[rgba(6,182,212,0.3)]">
                    {{ 'exercise.form.optional'|trans({}, 'navigation') }}
                </span>
            </div>
            <span class="text-[#64748b] transition-transform duration-200 exercise-accordion-chevron" aria-hidden="true">
                {% include 'partials/_svg/_down_arrow.html.twig' only %}
            </span>
        </button>

        <div
            id="description-body"
            data-{{ controllerName }}-target="accordionBody"
            style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;"
        >
            {{ form_widget(form.description) }}
        </div>
    </div>
</div>
