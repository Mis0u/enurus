{#
    1RM estimé, sous le record actuel de la carte « Record actuel ».

    Paramètres :
      - oneRepMax : OneRepMaxEstimate — valeur et série d'origine, dans l'unité de l'utilisateur.
      - unitLabel : string
#}
<div id="exercise-history-one-rep-max" class="mt-3 pt-3 border-t border-white/[0.07]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.5px] text-slate-400 mb-1">
        {{ 'exercise.history.overview.one_rep_max.label'|trans({}, 'navigation') }}
    </div>
    <div class="flex flex-wrap items-baseline gap-x-2">
        <span class="font-rajdhani text-[22px] font-bold text-cyan-400">{{ oneRepMax.value|number_format(1, ',', ' ') }} {{ unitLabel }}</span>
        {% if oneRepMax.includesBodyweight %}
            <span class="text-xs text-slate-300">{{ 'exercise.history.overview.one_rep_max.includes_bodyweight'|trans({}, 'navigation') }}</span>
        {% endif %}
    </div>
    <div class="text-[11px] text-slate-400 mt-0.5">
        {{ 'exercise.history.overview.one_rep_max.source'|trans({
            weight: oneRepMax.weight|number_format(1, ',', ' '),
            unit: unitLabel,
            reps: oneRepMax.reps,
            date: oneRepMax.performedAt|format_date('medium', locale=app.request.locale),
        }, 'navigation') }}
    </div>
</div>
