{#
    1RM estimé, sous le record actuel de la carte « Record actuel ».

    Paramètres :
      - oneRepMax : OneRepMaxEstimate — valeur et série d'origine, dans l'unité de l'utilisateur.
      - unitLabel : string
#}
<div id="exercise-history-one-rep-max" class="mt-3 pt-3 border-t border-white/[0.07]">
    <div class="flex items-center justify-between gap-1.5 mb-1">
        <span class="text-[11px] font-semibold uppercase tracking-[0.5px] text-slate-400">{{ 'exercise.history.overview.one_rep_max.label'|trans({}, 'navigation') }}</span>
        <a href="{{ path('app_help') }}#library" aria-label="{{ 'exercise.history.overview.one_rep_max.help'|trans({}, 'navigation') }}" class="inline-flex items-center justify-center w-7 h-7 -my-1.5 -mr-1.5 max-md:w-11 max-md:h-11 max-md:-my-3.5 max-md:-mr-3.5 rounded-lg text-slate-400 hover:text-white">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
        </a>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-2">
        <span class="font-rajdhani text-[22px] font-bold text-cyan-400">{{ oneRepMax.value|number_format(1, ',', ' ') }} {{ unitLabel }}</span>
        {% if oneRepMax.includesBodyweight %}
            <span class="text-xs text-slate-300">{{ 'exercise.history.overview.one_rep_max.includes_bodyweight'|trans({}, 'navigation') }}</span>
        {% endif %}
    </div>
    <div class="text-[11px] text-slate-400 mt-0.5">
        {{ 'exercise.history.overview.one_rep_max.source'|trans({
            weight: oneRepMax.weight|number_format(1, ',', ' '),
            unit: unitLabel,
            reps: oneRepMax.reps,
            date: oneRepMax.performedAt|format_date('medium', locale=app.request.locale),
        }, 'navigation') }}
    </div>
</div>
