{# Exercice au poids de corps sans poids renseigné : sa charge réelle, donc son 1RM, est inconnue. #}
<div id="exercise-history-one-rep-max" class="mt-3 pt-3 border-t border-white/[0.07]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.5px] text-slate-400 mb-1.5">
        {{ 'exercise.history.overview.one_rep_max.label'|trans({}, 'navigation') }}
    </div>
    <p class="mb-1.5 text-xs leading-normal text-slate-300">
        {{ 'exercise.history.overview.one_rep_max.bodyweight_missing.text'|trans({}, 'navigation') }}
    </p>
    <a href="{{ path('app_settings') }}#fieldBodyweight" class="inline-flex items-center gap-1 min-h-7 text-xs font-bold text-cyan-400 no-underline hover:opacity-80">
        {{ 'exercise.history.overview.one_rep_max.bodyweight_missing.cta'|trans({}, 'navigation') }}
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
</div>
