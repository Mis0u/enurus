{% set is_custom = not exercise.isPublic %}
{% set exercise_name = is_custom ? exercise.name : exercise.name|trans({}, 'exercise')
%}

<div
    class="exercise-history-card {{ is_custom ? 'exercise-history-card--custom' : 'exercise-history-card--official' }}"
    data-type="{{ is_custom ? 'custom' : 'official' }}"
    data-name="{{ exercise_name|lower }}"
    data-exercise--history-target="card"
>
    {# En-tête : nom + badge #}
    <div class="flex items-start justify-between gap-2.5 pl-2.5">
        <span class="font-['Rajdhani'] text-[17px] font-bold text-[#f0f4ff] leading-snug flex-1">
            {{ exercise_name }}
        </span>

        {% if is_custom %}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium whitespace-nowrap
                         bg-rose-500/[0.12] border border-rose-500/[0.3] text-rose-400">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                {{ 'exercise.history.badge.mine'|trans({}, 'navigation') }}
            </span>
        {% else %}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium whitespace-nowrap
                         bg-cyan-500/[0.08] border border-cyan-500/[0.25] text-cyan-400">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                {{ 'exercise.history.badge.base'|trans({}, 'navigation') }}
            </span>
        {% endif %}
    </div>

    {# Muscles pills #}
    <div class="flex flex-wrap gap-1.5 mt-2.5 pl-2.5">
        {% for exercise_muscle in exercise.exerciseMuscles %}
            {% set is_primary = exercise_muscle.type.value == 'primary' %}
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium
                {{ is_primary ? 'bg-rose-500/[0.12] border border-rose-500/[0.3] text-rose-400' : 'bg-orange-500/[0.12] border border-orange-500/[0.3] text-orange-400' }}">
                {{ exercise_muscle.muscleGroup.name|trans({}, 'muscle') }}
            </span>
        {% endfor %}
    </div>

    {# Description — line-clamp sur mobile, complète sur desktop #}
    {% if exercise.description %}
        <p class="mt-2.5 pl-2.5 text-[13px] leading-relaxed text-slate-400
                   line-clamp-3 md:line-clamp-none exercise-history-desc">
            {% if exercise.isPublic %}
                {{ exercise.description|trans({}, 'exercise') }}
            {% else %}
                {{ exercise.description }}
            {% endif %}
        </p>
    {% endif %}

    {# Actions — custom uniquement #}
    {% if is_custom %}
        <div class="flex items-center gap-2 mt-3.5 pt-3 pl-2.5 border-t border-white/[0.07]">
            <a
                href="{{ path('app_exercise_edit', {id: exercise.id}) }}"
                class="exercise-action-btn exercise-action-btn--edit"
                title="{{ 'exercise.history.actions.edit'|trans({}, 'navigation') }}"
                aria-label="{{ 'exercise.history.actions.edit'|trans({}, 'navigation') }} {{ exercise_name }}"
            >
                <svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </a>

            <div
                data-controller="exercise--delete"
                data-exercise--delete-url-value="{{ path('app_exercise_delete', {id: exercise.id}) }}"
                data-exercise--delete-csrf-token-value="{{ csrf_token('exercise_delete_' ~ exercise.id) }}"
                data-exercise--delete-name-value="{{ exercise_name }}"
                data-exercise--delete-confirm-title-value="{{ 'exercise.delete.confirm_title'|trans({}, 'navigation') }}"
                data-exercise--delete-confirm-text-value="{{ 'exercise.delete.confirm_text'|trans({'name': exercise_name}, 'navigation') }}"
                data-exercise--delete-confirm-button-value="{{ 'exercise.delete.confirm_button'|trans({}, 'navigation') }}"
                data-exercise--delete-cancel-button-value="{{ 'exercise.delete.cancel_button'|trans({}, 'navigation') }}"
                data-exercise--delete-error-text-value="{{ 'exercise.delete.error_text'|trans({}, 'navigation') }}"
            >
                <button
                    type="button"
                    class="exercise-action-btn exercise-action-btn--delete"
                    title="{{ 'exercise.history.actions.delete'|trans({}, 'navigation') }}"
                    aria-label="{{ 'exercise.history.actions.delete'|trans({}, 'navigation') }} {{ exercise_name }}"
                    data-action="click->exercise--delete#confirmDelete"
                >
                    <svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    {% endif %}

</div>
