{% set is_custom = not exercise.isPublic %}
{% set exercise_name = is_custom ? exercise.name : exercise.name|trans({}, 'exercise')
%}
{% set card_type = exercise.archived ? 'archived' : (is_custom ? 'custom' : 'official') %}

<div
    class="exercise-list-card {{ is_custom ? 'exercise-list-card--custom' : 'exercise-list-card--official' }}"
    data-type="{{ card_type }}"
    data-name="{{ exercise_name|lower }}"
    data-primary-muscle-group-ids="{{ primaryMuscleGroupIds[exercise.id] ?? '' }}"
    data-secondary-muscle-group-ids="{{ secondaryMuscleGroupIds[exercise.id] ?? '' }}"
    data-exercise--list-target="card"
>
    {# En-tête : nom + badge #}
    <div class="flex items-start justify-between gap-2.5 pl-2.5">
        <span class="font-['Rajdhani'] text-[17px] font-bold text-[#f0f4ff] leading-snug flex-1">
            {{ exercise_name }}
            {% if exercise.bodyweightPercent is not null %}
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10.5px] font-medium bg-[rgba(244,63,94,0.1)] border border-[rgba(244,63,94,0.3)] text-[#f43f5e] align-middle ml-1">
                    {{ 'exercise.bodyweight_badge'|trans({percent: exercise.bodyweightPercent|number_format(0)}, 'navigation') }}
                </span>
            {% endif %}
        </span>

        {% if exercise.archived %}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium whitespace-nowrap
                         bg-white/[0.06] border border-white/[0.15] text-slate-400">
                {{ 'exercise.list.badge.archived'|trans({}, 'navigation') }}
            </span>
        {% elseif is_custom %}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium whitespace-nowrap
                         bg-rose-500/[0.12] border border-rose-500/[0.3] text-rose-400">
                {% include 'partials/_svg/_profile.html.twig' with {'width': 2.5, 'height': 2.5, 'ariaHidden': true} only %}
                {{ 'exercise.list.badge.mine'|trans({}, 'navigation') }}
            </span>
        {% else %}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium whitespace-nowrap
                         bg-cyan-500/[0.08] border border-cyan-500/[0.25] text-cyan-400">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                {{ 'exercise.list.badge.base'|trans({}, 'navigation') }}
            </span>
        {% endif %}
    </div>

    {# Muscles pills #}
    <div class="flex flex-wrap gap-1.5 mt-2.5 pl-2.5">
        {% for exercise_muscle in exercise.exerciseMuscles %}
            {% set is_primary = exercise_muscle.type.value == enum('App\\Enum\\Entity\\ExerciceMuscle\\MuscleTypeEnum').PRIMARY.value %}
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium
                {{ is_primary ? 'bg-rose-500/[0.12] border border-rose-500/[0.3] text-rose-400' : 'bg-cyan-500/[0.12] border border-cyan-500/[0.3] text-cyan-400' }}">
                {{ exercise_muscle.muscleGroup.name|trans({}, 'muscle') }}
            </span>
        {% endfor %}
    </div>

    {# Description — tronquée à 160 caractères, identique sur mobile et desktop #}
    {% if exercise.description %}
        <p class="mt-2.5 pl-2.5 text-[13px] leading-relaxed text-slate-400">
            {% if exercise.isPublic %}
                {{ exercise.description|trans({}, 'exercise')|truncate(160) }}
            {% else %}
                {{ exercise.description|truncate(160) }}
            {% endif %}
        </p>
    {% endif %}

    {# Actions #}
    {% if exercise.archived %}
        <div class="flex items-center gap-2 mt-3.5 pt-3 pl-2.5 border-t border-white/[0.07]">
            <div
                data-controller="exercise--restore"
                data-exercise--restore-url-value="{{ path('app_exercise_restore', {id: exercise.id}) }}"
                data-exercise--restore-csrf-token-value="{{ csrf_token('exercise_restore_' ~ exercise.id) }}"
                data-exercise--restore-error-text-value="{{ 'exercise.restore.error_text'|trans({}, 'navigation') }}"
            >
                <button
                    type="button"
                    class="exercise-action-btn exercise-action-btn--edit"
                    title="{{ 'exercise.list.actions.restore'|trans({}, 'navigation') }}"
                    aria-label="{{ 'exercise.list.actions.restore'|trans({}, 'navigation') }} {{ exercise_name }}"
                    data-action="click->exercise--restore#confirmRestore"
                >
                    {% include 'partials/_svg/_add.html.twig' with {'width': 3.75, 'height': 3.75, 'ariaHidden': true} only %}
                </button>
            </div>
        </div>
    {% elseif is_custom %}
        <div class="flex items-center gap-2 mt-3.5 pt-3 pl-2.5 border-t border-white/[0.07]">
            <a
                href="{{ path('app_exercise_history', {id: exercise.id}) }}"
                class="exercise-action-btn exercise-action-btn--history"
                title="{{ 'exercise.list.actions.history'|trans({}, 'navigation') }}"
                aria-label="{{ 'exercise.list.actions.history'|trans({}, 'navigation') }} {{ exercise_name }}"
            >
                {% include 'partials/_svg/_chart.html.twig' with {'width': 3.75, 'height': 3.75, 'ariaHidden': true} only %}
            </a>

            <a
                href="{{ path('app_exercise_edit', {id: exercise.id}) }}"
                class="exercise-action-btn exercise-action-btn--edit"
                title="{{ 'exercise.list.actions.edit'|trans({}, 'navigation') }}"
                aria-label="{{ 'exercise.list.actions.edit'|trans({}, 'navigation') }} {{ exercise_name }}"
            >
                {% include 'partials/_svg/_pen.html.twig' with {'weight': 3.75, 'height': 3.75, 'color': false, 'ariaHidden': true} only %}
            </a>

            <div
                data-controller="exercise--delete"
                data-exercise--delete-url-value="{{ path('app_exercise_delete', {id: exercise.id}) }}"
                data-exercise--delete-csrf-token-value="{{ csrf_token('exercise_delete_' ~ exercise.id) }}"
                data-exercise--delete-name-value="{{ exercise_name }}"
                data-exercise--delete-confirm-title-value="{{ 'exercise.delete.confirm_title'|trans({}, 'navigation') }}"
                data-exercise--delete-confirm-text-value="{{ 'exercise.delete.confirm_text'|trans({'name': exercise_name, 'gender': app.user.gender.value}, 'navigation') }}"
                data-exercise--delete-confirm-button-value="{{ 'exercise.delete.confirm_button'|trans({}, 'navigation') }}"
                data-exercise--delete-cancel-button-value="{{ 'exercise.delete.cancel_button'|trans({}, 'navigation') }}"
                data-exercise--delete-error-text-value="{{ 'exercise.delete.error_text'|trans({}, 'navigation') }}"
            >
                <button
                    type="button"
                    class="exercise-action-btn exercise-action-btn--delete"
                    title="{{ 'exercise.list.actions.delete'|trans({}, 'navigation') }}"
                    aria-label="{{ 'exercise.list.actions.delete'|trans({}, 'navigation') }} {{ exercise_name }}"
                    data-action="click->exercise--delete#confirmDelete"
                >
                    {% include 'partials/_svg/_trash.html.twig' with {'width': 3.75, 'height': 3.75, 'ariaHidden': true} only %}
                </button>
            </div>
        </div>
    {% else %}
        <div class="flex items-center gap-2 mt-3.5 pt-3 pl-2.5 border-t border-white/[0.07]">
            <a
                href="{{ path('app_exercise_history', {id: exercise.id}) }}"
                class="exercise-action-btn exercise-action-btn--history"
                title="{{ 'exercise.list.actions.history'|trans({}, 'navigation') }}"
                aria-label="{{ 'exercise.list.actions.history'|trans({}, 'navigation') }} {{ exercise_name }}"
            >
                {% include 'partials/_svg/_chart.html.twig' with {'width': 3.75, 'height': 3.75, 'ariaHidden': true} only %}
            </a>
        </div>
    {% endif %}

</div>
