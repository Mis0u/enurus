<div
    class="exercise-list-empty-state"
    hidden
    data-exercise--list-target="emptyState"
    aria-live="polite"
    aria-atomic="true"
>
    {% include 'partials/_svg/_magnifying_glass.html.twig' with {'width': 16, 'height': 16, 'extraClass': 'mb-5 text-slate-600', 'strokeWidth': 1.5, 'ariaHidden': true} only %}

    <h2 class="font-['Rajdhani'] text-xl font-bold text-[#f0f4ff] mb-2">
        {{ 'exercise.list.empty.title'|trans({}, 'navigation') }}
    </h2>

    <p class="text-[14px] text-slate-400 mb-5">
        {{ 'exercise.list.empty.subtitle'|trans({}, 'navigation') }}
    </p>

    <button
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-[13.5px] font-medium
               bg-transparent border border-rose-500/[0.4] text-rose-400
               hover:bg-rose-500/[0.08] transition-colors duration-200"
        data-action="click->exercise--list#resetFilters"
    >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        {{ 'exercise.list.empty.reset'|trans({}, 'navigation') }}
    </button>
</div>
