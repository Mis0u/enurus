<div class="flex flex-wrap items-center gap-3 mb-2">

    {# Recherche #}
    <div class="flex items-center gap-2.5 flex-1 min-w-[200px] px-3.5 py-2.5
                bg-[#0f1928] border border-white/[0.07] rounded-[10px]
                focus-within:border-white/[0.15] transition-colors duration-200">
        {% include 'partials/_svg/_magnifying_glass.html.twig' with {'width': 4, 'height': 4, 'extraClass': 'text-slate-500 shrink-0', 'ariaHidden': true} only %}
        <input
            type="text"
            class="bg-transparent border-none outline-none text-[#f0f4ff] text-[13.5px] w-full
                   placeholder:text-slate-500 font-['DM_Sans']"
            placeholder="{{ 'exercise.list.filter.search_placeholder'|trans({}, 'navigation') }}"
            aria-label="{{ 'exercise.list.filter.search_placeholder'|trans({}, 'navigation') }}"
            data-exercise--list-target="searchInput"
            data-action="input->exercise--list#onSearch"
        >
    </div>

    {# Boutons de filtrage par type #}
    <div class="flex flex-wrap gap-1.5">
        <button
            type="button"
            class="exercise-filter-btn"
            id="filterBase"
            data-filter-type="official"
            data-exercise--list-target="filterBtn"
            data-action="click->exercise--list#toggleFilter"
            aria-pressed="false"
        >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            {{ 'exercise.list.filter.base'|trans({}, 'navigation') }}
        </button>

        <button
            type="button"
            class="exercise-filter-btn"
            id="filterMine"
            data-filter-type="custom"
            data-exercise--list-target="filterBtn"
            data-action="click->exercise--list#toggleFilter"
            aria-pressed="false"
        >
            {% include 'partials/_svg/_profile.html.twig' with {'width': 3.5, 'height': 3.5, 'ariaHidden': true} only %}
            {{ 'exercise.list.filter.mine'|trans({}, 'navigation') }}
        </button>

        <button
            type="button"
            class="exercise-filter-btn"
            id="filterArchived"
            data-filter-type="archived"
            data-exercise--list-target="filterBtn"
            data-action="click->exercise--list#toggleFilter"
            aria-pressed="false"
        >
            {{ 'exercise.list.filter.archived'|trans({}, 'navigation') }}
        </button>
    </div>

    {# Bouton reset — masqué par défaut, affiché par Stimulus #}
    <button
        type="button"
        class="exercise-filter-btn"
        hidden
        data-exercise--list-target="resetBtn"
        data-action="click->exercise--list#resetFilters"
        aria-label="{{ 'exercise.list.filter.reset'|trans({}, 'navigation') }}"
    >
        {% include 'partials/_svg/_cross.html.twig' with {'ariaHidden': true} only %}
        {{ 'exercise.list.filter.reset'|trans({}, 'navigation') }}
    </button>

    {# Compteur dynamique #}
    <div
        class="flex items-center gap-1.5 px-3 py-1.5 ml-auto
               bg-cyan-500/[0.12] border border-cyan-500/[0.25] rounded-lg
               text-[12px] font-semibold text-cyan-400 whitespace-nowrap"
        data-exercise--list-target="counter"
        aria-live="polite"
        aria-atomic="true"
    >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <span data-exercise--list-target="counterText">
            {# Valeur initiale rendue par Twig — mise à jour par Stimulus #}
            {{ 'exercise.list.filter.count'|trans({count: totalCount}, 'navigation') }}
        </span>
    </div>

</div>

{% if muscleGroups is not empty %}
    {# Filtre par muscle — 1er clic = primaire (rose), 2e clic = secondaire (cyan), 3e clic = aucun #}
    <details class="mb-2">
        <summary class="cursor-pointer text-[13px] font-medium text-white/60 hover:text-white/80 select-none">
            {{ 'exercise.list.filter.muscle_label'|trans({}, 'navigation') }}
            <span data-exercise--list-target="muscleFilterCount" hidden class="text-[#f43f5e]"></span>
        </summary>
        <div class="flex flex-wrap gap-2 mt-3">
            {% for muscle_group in muscleGroups %}
                <button
                    type="button"
                    class="muscle-filter-chip inline-flex items-center px-3 py-1.5 rounded-full text-[13px] font-medium border border-white/[0.07] bg-[#0f1928] text-white/70 transition-colors duration-150 cursor-pointer select-none"
                    data-state="none"
                    data-muscle-id="{{ muscle_group.id }}"
                    data-exercise--list-target="muscleFilterChip"
                    data-action="click->exercise--list#cycleMuscleFilter"
                >
                    {{ muscle_group.name|trans({}, 'muscle') }}
                </button>
            {% endfor %}
        </div>
    </details>
{% endif %}
