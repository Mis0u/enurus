<div
    class="flex items-center justify-between mt-2 pt-5 border-t border-white/[0.07] max-md:flex-col max-md:items-stretch max-md:gap-3"
    data-exercise--list-target="paginationWrapper"
>
    {# Sélecteur de résultats par page #}
    <div class="flex items-center gap-2 text-[12px] text-slate-400 max-md:justify-center">
        <span>{{ 'exercise.list.pagination.show'|trans({}, 'navigation') }}</span>
        <select
            class="bg-[#0f1928] border border-white/[0.07] rounded-md px-2 py-1
                   text-[#f0f4ff] text-[12px] font-['DM_Sans'] outline-none cursor-pointer
                   hover:border-white/[0.12] transition-colors duration-200"
            aria-label="{{ 'exercise.list.pagination.per_page'|trans({}, 'navigation') }}"
            data-exercise--list-target="perPageSelect"
            data-action="change->exercise--list#onPerPageChange"
        >
            <option value="12" selected>12</option>
            <option value="24">24</option>
            <option value="48">48</option>
        </select>
        <span>{{ 'exercise.list.pagination.results'|trans({}, 'navigation') }}</span>
    </div>

    {# Navigation pages #}
    <div class="flex items-center gap-1 max-md:justify-center max-md:flex-wrap" role="navigation" aria-label="{{ 'exercise.list.pagination.navigation'|trans({}, 'navigation') }}">
        <button
            type="button"
            class="exercise-page-btn exercise-page-btn--nav"
            hidden
            data-exercise--list-target="firstBtn"
            data-action="click->exercise--list#goFirst"
            aria-label="{{ 'exercise.list.pagination.first'|trans({}, 'navigation') }}"
        >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="11 17 6 12 11 7"></polyline>
                <polyline points="18 17 13 12 18 7"></polyline>
            </svg>
        </button>

        <button
            type="button"
            class="exercise-page-btn exercise-page-btn--nav"
            disabled
            data-exercise--list-target="prevBtn"
            data-action="click->exercise--list#prevPage"
            aria-label="{{ 'exercise.list.pagination.previous'|trans({}, 'navigation') }}"
        >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
            </svg>
            {{ 'exercise.list.pagination.previous'|trans({}, 'navigation') }}
        </button>

        <div
            class="flex items-center gap-1"
            data-exercise--list-target="pageNumbers"
        >
            {# Les numéros de page sont injectés dynamiquement par Stimulus #}
        </div>

        <button
            type="button"
            class="exercise-page-btn exercise-page-btn--nav"
            data-exercise--list-target="nextBtn"
            data-action="click->exercise--list#nextPage"
            aria-label="{{ 'exercise.list.pagination.next'|trans({}, 'navigation') }}"
        >
            {{ 'exercise.list.pagination.next'|trans({}, 'navigation') }}
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
        </button>

        <button
            type="button"
            class="exercise-page-btn exercise-page-btn--nav"
            hidden
            data-exercise--list-target="lastBtn"
            data-action="click->exercise--list#goLast"
            aria-label="{{ 'exercise.list.pagination.last'|trans({}, 'navigation') }}"
        >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="13 17 18 12 13 7"></polyline>
                <polyline points="6 17 11 12 6 7"></polyline>
            </svg>
        </button>
    </div>
</div>
