{#
    Variables attendues (toutes via `only`) :
    - message : ContactThreadMessage
#}
<div class="rounded-2xl p-4.5 border {{ message.fromAdmin ? 'bg-[rgba(6,182,212,0.06)] border-[rgba(6,182,212,0.2)]' : 'bg-white/[0.03] border-white/[0.07]' }}">
    <div class="flex items-center justify-between gap-3 mb-2.5">
        <span class="text-[12.5px] font-semibold {{ message.fromAdmin ? 'text-[#06b6d4]' : 'text-[#f0f4ff]' }}">
            {{ message.fromAdmin ? 'messagerie.author.admin'|trans({}, 'navigation') : 'messagerie.author.you'|trans({}, 'navigation') }}
        </span>
        <span class="text-[11px] text-[#4a5568]">
            {{ message.createdAt|format_datetime(pattern: 'd MMM yyyy, HH:mm', locale: app.user.locale) }}
        </span>
    </div>

    <p class="text-[13.5px] text-[#c5d0e0] leading-relaxed whitespace-pre-line">{{ message.body }}</p>

    {% if message.imagePath %}
        <a href="/uploads/{{ message.imagePath }}" target="_blank" rel="noopener noreferrer" class="inline-block mt-3">
            <img src="/uploads/{{ message.imagePath }}" alt="" class="max-w-[220px] max-h-[160px] rounded-lg border border-white/[0.07] object-cover">
        </a>
    {% endif %}
</div>
