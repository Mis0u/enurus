{#
    Variables attendues (toutes via `only`) :
    - message : ContactThreadMessage

    message.fromAdmin = true  → auteur = Enurus (Micka), aligné à gauche.
    message.fromAdmin = false → auteur = l'utilisateur, aligné à droite.
#}
<div class="flex flex-col gap-1.5 {{ message.fromAdmin ? 'items-start' : 'items-end' }}">
    <span class="flex items-center gap-1.5 text-[11px] font-semibold px-1 {{ message.fromAdmin ? 'text-[#06b6d4]' : 'text-[#8b9bb4]' }}">
        {{ message.fromAdmin ? 'messagerie.author.admin'|trans({'brand': 'name'|trans({}, 'brand')}, 'navigation') : 'messagerie.author.you'|trans({}, 'navigation') }}
    </span>

    <div class="max-w-[78%] rounded-2xl px-4 py-3 border {{ message.fromAdmin ? 'bg-[rgba(6,182,212,0.06)] border-[rgba(6,182,212,0.2)] rounded-bl-md' : 'bg-[rgba(244,63,94,0.15)] border-[rgba(244,63,94,0.25)] rounded-br-md' }}">
        <div class="text-[13.5px] text-[#f0f4ff] leading-relaxed whitespace-pre-line [&_p]:mb-2 [&_p:last-child]:mb-0 [&_a]:underline">
            {{ message.fromAdmin ? message.body|raw : message.body }}
        </div>

        {% if message.imagePath %}
            <div class="inline-block mt-3 cursor-pointer group"
                 onclick="document.getElementById('message-photo-lightbox-{{ message.id.toRfc4122 }}').classList.remove('hidden'); document.getElementById('message-photo-lightbox-{{ message.id.toRfc4122 }}').classList.add('flex')">
                <img src="{{ message.imagePath|storage_url }}" alt="" class="max-w-[220px] max-h-[160px] rounded-lg border border-white/[0.07] object-cover transition-all duration-200 group-hover:brightness-90">
            </div>
        {% endif %}
    </div>

    <span class="text-[10.5px] text-[#4a5568] px-1"
          data-controller="local-datetime"
          data-local-datetime-iso-value="{{ message.createdAt|date('c') }}"
          data-local-datetime-locale-value="{{ app.user.locale }}"
          data-local-datetime-style-value="datetime">
        {{ message.createdAt|format_datetime(pattern: 'd MMM yyyy, HH:mm', locale: app.user.locale) }}
    </span>
</div>

{% if message.imagePath %}
    <div id="message-photo-lightbox-{{ message.id.toRfc4122 }}"
         onclick="this.classList.add('hidden'); this.classList.remove('flex')"
         class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm items-center justify-center p-4 cursor-pointer animate-[fadeIn_0.2s_ease] [&>img]:animate-[scaleIn_0.2s_ease]">
        <img src="{{ message.imagePath|storage_url }}" alt="" class="max-w-full max-h-full object-contain rounded-xl">
    </div>
{% endif %}
