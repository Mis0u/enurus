{#
    Variables attendues (toutes via `only`) :
    - thread : ContactThread
    - unreadCount : int
#}
{% if thread.status.value == 'closed' %}
    {% set status_label = 'messagerie.status.closed'|trans({}, 'navigation') %}
    {% set status_class = 'bg-white/[0.05] text-[#8b9bb4] border-white/[0.07]' %}
{% elseif thread.status.value == 'answered_by_admin' %}
    {% set status_label = 'messagerie.status.answered'|trans({}, 'navigation') %}
    {% set status_class = 'bg-[rgba(34,197,94,0.12)] text-[#22c55e] border-[rgba(34,197,94,0.3)]' %}
{% else %}
    {% set status_label = 'messagerie.status.awaiting_admin'|trans({}, 'navigation') %}
    {% set status_class = 'bg-[rgba(245,158,11,0.12)] text-[#f59e0b] border-[rgba(245,158,11,0.3)]' %}
{% endif %}

<a href="{{ path('app_contact_thread_show', {id: thread.id.toRfc4122}) }}"
   class="block bg-[#0f1928] border border-white/[0.07] rounded-2xl p-4.5 no-underline hover:border-white/[0.14] transition-all">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2 mb-1.5">
                {% if unreadCount > 0 %}
                    <span class="w-2 h-2 rounded-full bg-rose-ft shrink-0" aria-hidden="true"></span>
                {% endif %}
                <span class="text-[15px] font-semibold text-[#f0f4ff] truncate">{{ thread.subject }}</span>
            </div>
            <span class="text-[12px] text-[#4a5568]">
                {{ ('contact.category.' ~ thread.category.value)|trans({}, 'navigation') }}
                &middot;
                {{ thread.updatedAt|format_datetime(pattern: 'd MMMM yyyy', locale: app.user.locale) }}
            </span>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            {% if unreadCount > 0 %}
                <span class="min-w-[20px] h-5 px-1.5 rounded-full bg-rose-ft text-white text-[11px] font-bold flex items-center justify-center">
                    {{ unreadCount }}
                </span>
            {% endif %}
            <span class="px-2.5 py-1 rounded-full border text-[11px] font-semibold {{ status_class }}">
                {{ status_label }}
            </span>
        </div>
    </div>
</a>
