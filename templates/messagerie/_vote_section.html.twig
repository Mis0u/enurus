{#
    Variables attendues (toutes via `only`) :
    - thread : ContactThread
    - canVote : bool
    - voteForm : ?FormView — présent seulement si canVote est vrai
    - daysUntilPollCloses : int — jours pleins restants avant clôture, arrondi au jour supérieur,
      cf. ContactBroadcast::daysUntilPollCloses() — 0 seulement si le vote s'est clos entre-temps
      (n'arrive jamais côté formulaire, le Voter garantit déjà pollClosesAt > now à ce stade), dans
      ce cas la ligne ne s'affiche simplement pas plutôt que d'afficher une information trompeuse.
#}
{% if thread.pollVote is not null %}
    <div class="flex flex-col items-center gap-2 text-center py-2">
        <span class="text-3xl">🗳️</span>
        <p class="text-[13.5px] text-[#8b9bb4]">
            {{ 'messagerie.vote.confirmation'|trans({option: thread.pollVote.option.labelFor(thread.owner.locale)}, 'navigation') }}
        </p>
        {% if daysUntilPollCloses > 0 %}
            <p class="text-[12px] text-[#5c6b85]">
                {{ 'messagerie.vote.closes_in_days'|trans({days: daysUntilPollCloses}, 'navigation') }}
            </p>
        {% endif %}
    </div>
{% elseif canVote and voteForm is not null %}
    {% form_theme voteForm 'registration/theme/error_theme.html.twig' 'messagerie/theme/vote_option_theme.html.twig' %}

    {% if daysUntilPollCloses > 0 %}
        <p class="text-[12px] text-[#5c6b85] text-center mb-3">
            {{ 'messagerie.vote.closes_in_days'|trans({days: daysUntilPollCloses}, 'navigation') }}
        </p>
    {% endif %}

    {{ form_start(voteForm, {
        render_rest: false,
        action: path('app_contact_thread_vote', {id: thread.id.toRfc4122}),
    }) }}

    <div class="mb-[18px]">
        {{ form_widget(voteForm.option) }}
        {{ form_errors(voteForm.option) }}
    </div>

    {{ form_row(voteForm._token) }}

    <button type="submit"
            class="cursor-pointer w-full min-h-11 py-3 px-4 bg-gradient-to-r from-cyan-500 to-cyan-700 hover:from-cyan-600 hover:to-cyan-800 text-white font-bold rounded-xl shadow-lg shadow-cyan-500/30 hover:shadow-cyan-500/50 transition-all duration-200">
        {{ 'messagerie.vote.submit'|trans({}, 'navigation') }}
    </button>
    {{ form_end(voteForm, {render_rest: false}) }}
{% else %}
    <p class="text-[13.5px] text-[#8b9bb4] text-center">
        {{ 'messagerie.vote.closed'|trans({}, 'navigation') }}
    </p>
{% endif %}
