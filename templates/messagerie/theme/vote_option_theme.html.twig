{#
    `peer-checked:` ne réagit qu'aux frères directs de l'input (même parent) — la pastille et le
    libellé doivent donc être des enfants directs du <label>, pas imbriqués dans un wrapper
    intermédiaire. Le style de la carte elle-même (fond/bordure au survol du <label>) utilise
    `has-[:checked]:`, qui lui fonctionne sur n'importe quel descendant.
#}
{% block _contact_vote_form_option_widget %}
    <div class="space-y-2.5">
        {% for choice in choices %}
            <label class="relative flex items-center gap-3 cursor-pointer bg-white/5 border-2 border-white/10 rounded-xl px-4 py-3.5 transition-all duration-200 has-[:checked]:bg-cyan-500/[0.12] has-[:checked]:border-cyan-500 has-[:checked]:shadow-lg has-[:checked]:shadow-cyan-500/20 hover:border-white/25">
                <input
                    type="radio"
                    name="{{ full_name }}"
                    value="{{ choice.value }}"
                    class="peer sr-only"
                    {% if choice.value == value %}checked{% endif %}
                    {{ required ? 'required' : '' }}
                >
                <span class="flex-1 text-[14px] font-medium text-slate-200 peer-checked:text-cyan-200 transition-colors">
                    {{ choice.label }}
                </span>
                <span class="w-5 h-5 rounded-full border-2 border-white/20 flex items-center justify-center shrink-0 transition-all duration-200 peer-checked:border-cyan-500 peer-checked:bg-cyan-500">
                    <svg class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                </span>
            </label>
        {% endfor %}
    </div>
{% endblock %}
