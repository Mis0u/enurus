{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/messagerie.css') }}">
{% endblock %}

{% block title %}{{ thread.subject|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {
        title: thread.subject,
        subtitle: app.user.nickname|formatInitials,
    } only %}
{% endblock %}

{% block state %}
    {% set category_emoji = {
        bug: '🐞',
        suggestion: '💡',
        question: '❓',
        love: '❤️',
        other: '📁',
        informative: '📌',
        vote: '🗳️',
    }[thread.category.value] %}

    {% if thread.category.value == 'vote' %}
        {% set status_label = 'messagerie.status.vote'|trans({}, 'navigation') %}
        {% set status_class = 'bg-[rgba(6,182,212,0.12)] text-[#06b6d4] border-[rgba(6,182,212,0.3)]' %}
    {% elseif thread.category.value == 'informative' %}
        {% set status_label = 'messagerie.status.informative'|trans({}, 'navigation') %}
        {% set status_class = 'bg-[rgba(6,182,212,0.12)] text-[#06b6d4] border-[rgba(6,182,212,0.3)]' %}
    {% elseif thread.status.value == 'closed' %}
        {% set status_label = 'messagerie.status.closed'|trans({}, 'navigation') %}
        {% set status_class = 'bg-white/[0.05] text-[#8b9bb4] border-white/[0.07]' %}
    {% elseif thread.status.value == 'answered_by_admin' %}
        {% set status_label = 'messagerie.status.answered'|trans({}, 'navigation') %}
        {% set status_class = 'bg-[rgba(34,197,94,0.12)] text-[#22c55e] border-[rgba(34,197,94,0.3)]' %}
    {% else %}
        {% set status_label = 'messagerie.status.awaiting_admin'|trans({}, 'navigation') %}
        {% set status_class = 'bg-[rgba(245,158,11,0.12)] text-[#f59e0b] border-[rgba(245,158,11,0.3)]' %}
    {% endif %}

    <div class="flex-1 overflow-y-auto">
        <div class="max-w-[640px] mx-auto px-4 lg:px-8 py-6">

            <a href="{{ path('app_contact_thread_list') }}" class="inline-flex items-center gap-1.5 text-[13px] text-[#8b9bb4] hover:text-[#f0f4ff] no-underline mb-4 transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                {{ 'messagerie.back_to_list'|trans({}, 'navigation') }}
            </a>

            <div class="flex items-center justify-between gap-3 flex-wrap mb-6">
                <h2 class="font-['Rajdhani'] text-[19px] font-bold text-[#f0f4ff]">
                    {{ category_emoji }} {{ thread.subject }}
                </h2>

                <div class="flex items-center gap-2 shrink-0">
                    <span class="px-2.5 py-1 rounded-full border text-[11px] font-semibold {{ status_class }}">
                        {{ status_label }}
                    </span>

                    <button type="button"
                            data-controller="contact--delete"
                            data-contact--delete-url-value="{{ path('app_contact_thread_delete', {id: thread.id.toRfc4122}) }}"
                            data-contact--delete-csrf-token-value="{{ csrf_token('contact_thread_delete_' ~ thread.id.toRfc4122) }}"
                            data-contact--delete-redirect-url-value="{{ path('app_contact_thread_list') }}"
                            data-contact--delete-confirm-title-value="{{ 'messagerie.delete.confirm_title'|trans({}, 'navigation') }}"
                            data-contact--delete-confirm-text-value="{{ 'messagerie.delete.confirm_text'|trans({}, 'navigation') }}"
                            data-contact--delete-confirm-button-value="{{ 'messagerie.delete.confirm_button'|trans({}, 'navigation') }}"
                            data-contact--delete-cancel-button-value="{{ 'messagerie.delete.cancel_button'|trans({}, 'navigation') }}"
                            data-contact--delete-error-text-value="{{ 'messagerie.delete.error_text'|trans({}, 'navigation') }}"
                            data-action="click->contact--delete#confirmDelete"
                            aria-label="{{ 'messagerie.delete.confirm_button'|trans({}, 'navigation') }}"
                            class="w-8 h-8 rounded-lg border border-white/[0.07] bg-white/[0.03] text-[#8b9bb4] hover:text-[#f43f5e] hover:border-[rgba(244,63,94,0.3)] flex items-center justify-center transition-colors cursor-pointer">
                        {% include 'partials/_svg/_trash.html.twig' with {'width': 4, 'height': 4} only %}
                    </button>
                </div>
            </div>

            <div class="space-y-5 mb-6">
                {% for message in thread.messages %}
                    {% include 'messagerie/_message.html.twig' with {
                        message: message,
                    } only %}
                {% endfor %}
            </div>

            {% if canReply %}
                <section class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6">
                    {% include 'messagerie/_reply_form.html.twig' with {
                        thread: thread,
                        replyForm: replyForm,
                        imageMaxSizeBytes: imageMaxSizeBytes,
                        imageAllowedMimeTypes: imageAllowedMimeTypes,
                    } only %}
                </section>
            {% elseif thread.category.value == 'vote' %}
                <section class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6">
                    {% include 'messagerie/_vote_section.html.twig' with {
                        thread: thread,
                        canVote: canVote,
                        voteForm: voteForm,
                    } only %}
                </section>
            {% elseif thread.category.value == 'informative' %}
                <section class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-4.5 text-center">
                    <p class="text-[13px] text-[#8b9bb4]">{{ 'messagerie.reply_informative'|trans({}, 'navigation') }}</p>
                </section>
            {% elseif thread.status.value == 'closed' %}
                <section class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-4.5 text-center">
                    <p class="text-[13px] text-[#8b9bb4]">{{ 'messagerie.thread_closed'|trans({}, 'navigation') }}</p>
                </section>
            {% else %}
                <section class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-4.5 text-center">
                    <p class="text-[13px] text-[#8b9bb4]">{{ 'messagerie.reply_restricted'|trans({}, 'navigation') }}</p>
                </section>
            {% endif %}

        </div>
    </div>
{% endblock %}
