{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'admin.reregistration.subject'|trans({}, 'navigation', locale) }}{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 24px;">
        <span style="font-size: 64px;">⚠️</span>
    </div>

    <h2 style="margin: 0 0 16px; font-size: 22px; font-weight: bold; color: #ffffff; text-align: center;">
        {{ 'admin.reregistration.title'|trans({}, 'navigation', locale) }}
    </h2>

    <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #cbd5e1; text-align: center;">
        {{ 'admin.reregistration.body'|trans({
            'email': reregisteredEmail,
            'deletedAt': deletedAt|format_date('short', locale=locale),
        }, 'navigation', locale) }}
    </p>
{% endblock %}
