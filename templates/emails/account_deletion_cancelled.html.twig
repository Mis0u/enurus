{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'settings.account_deletion.cancelled.subject'|trans({}, 'security', locale) }}{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 24px;">
        <span style="font-size: 64px;">✅</span>
    </div>

    <h2 style="margin: 0 0 16px; font-size: 24px; font-weight: bold; color: #ffffff; text-align: center;">
        {{ 'settings.account_deletion.cancelled.title'|trans({}, 'security', locale) }}
    </h2>

    <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #cbd5e1; text-align: center;">
        {{ 'settings.account_deletion.cancelled.body'|trans({'nickname': user.nickname}, 'security', locale) }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding: 0 0 32px;">
                <a href="{{ url('app_dashboard') }}" style="display: inline-block; padding: 16px 32px; background: linear-gradient(135deg, #f43f5e 0%, #dc2626 100%); color: #ffffff; text-decoration: none; font-size: 16px; font-weight: bold; border-radius: 12px;">
                    💪 {{ 'sentence.log_workout'|trans({}, 'common', locale) }}
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
