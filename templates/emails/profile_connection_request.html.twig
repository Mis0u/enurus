{#
    Email envoyé au destinataire d'une demande de connexion (ProfileConnectionRequestNotifier).
    Variables : requesterNickname (string), locale (string — langue du destinataire).
#}
{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'profile_connection.email.request.subject'|trans({nickname: requesterNickname}, 'navigation', locale) }}{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 24px;">
        <span style="font-size: 64px;">🤝</span>
    </div>

    <h2 style="margin: 0 0 16px; font-size: 24px; font-weight: bold; color: #ffffff; text-align: center;">
        {{ 'profile_connection.email.request.title'|trans({nickname: requesterNickname}, 'navigation', locale) }}
    </h2>

    <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.6; color: #cbd5e1; text-align: center;">
        {{ 'profile_connection.email.request.body'|trans({nickname: requesterNickname, brand: brand_name}, 'navigation', locale) }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center">
                <a href="{{ url('app_profile_connection_list', {_locale: locale}) }}" style="display: inline-block; padding: 16px 32px; background: linear-gradient(135deg, #f43f5e 0%, #dc2626 100%); color: #ffffff; text-decoration: none; font-size: 16px; font-weight: bold; border-radius: 12px; box-shadow: 0 8px 20px rgba(244, 63, 94, 0.3);">
                    {{ 'profile_connection.email.request.cta'|trans({}, 'navigation', locale) }}
                </a>
            </td>
        </tr>
    </table>
{% endblock %}

{% block footer %}
    <p style="margin: 0 0 12px; font-size: 12px; line-height: 1.6; color: #64748b;">
        {{ 'profile_connection.email.request.why'|trans({}, 'navigation', locale) }}
        <a href="{{ url('app_profile_connection_list', {_locale: locale}) }}#notifications" style="color: #94a3b8; text-decoration: underline;">{{ 'profile_connection.email.request.unsubscribe'|trans({}, 'navigation', locale) }}</a>
    </p>
    {{ parent() }}
{% endblock %}
