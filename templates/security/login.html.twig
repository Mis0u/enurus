{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4 py-12">
        <div class="max-w-md w-full">

            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-rose-500 to-red-600 rounded-2xl mb-4 shadow-lg shadow-rose-500/30">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">{{ 'name'|trans({}, 'brand') }}</h1>
                <p class="text-slate-400">{{ 'baseline'|trans({}, 'brand') }}</p>
            </div>

            <div class="backdrop-blur-xl bg-white/10 rounded-3xl shadow-2xl border border-white/20 p-8">
                <form method="post" class="space-y-6">

                    {% if error %}
                        {% include 'components/_form/_error_message.html.twig' with {message: error.messageKey|trans(error.messageData, 'security')} %}
                    {% endif %}

                    <h2 class="text-2xl font-bold text-white mb-6">{{ 'login.connexion'|trans({}, 'security') }}</h2>

                    {% include 'security/_email_field.html.twig' %}

                    {% include 'security/_password_field.html.twig' %}

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    {% include 'security/_remember_me_field.html.twig' %}

                    {% include 'components/_form/_button_primary.html.twig' with {id: 'login-btn', message: 'login.connect'|trans({}, 'security')} %}

                    {% include 'security/_additionnal_link.html.twig' %}

                </form>
            </div>

            {% include 'components/_common/_footer.html.twig' %}
        </div>
    </div>
{% endblock %}
