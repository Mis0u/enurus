{#
    Widget Connexions — personnel : jamais affiché sur son dashboard vu par une connexion
    (`DashboardWidgetEnum::isShareable()`). Mêmes lignes que la page « Mes connexions », sans le
    bouton « Retirer » : la gestion reste sur la page, accessible par le lien en bas du widget.
    Variables attendues (toutes via `only`) :
    - connections          : list<ProfileConnectionEntry>
    - viewerIsDiscoverable : bool — partage de profil de celui qui regarde (lien bloqué sinon)
#}
<div class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] overflow-hidden relative transition-ft hover:border-white/[0.12] hover:shadow-[0_8px_30px_rgba(0,0,0,0.3)] flex flex-col"
     data-dashboard-widget="connections">

    <div class="flex items-center gap-[7px] mb-4 text-[#8b9bb4]">
        {% include 'partials/_svg/_add_people.html.twig' only %}
        <h2 class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase">
            {{ 'profile_connection.list.connections.title'|trans({}, 'navigation') }}
        </h2>
    </div>

    {# Même seuil que la page Connexions : au-delà de 5, hauteur fixe et scroll interne. #}
    <ul class="flex flex-col gap-3 {% if connections|length >= 5 %}max-h-[430px] overflow-y-auto pr-1 exercise-list-scroll{% endif %}">
        {% for entry in connections %}
            {% include 'profile_connection/list/_connection_row.html.twig' with {
                entry: entry,
                viewerIsDiscoverable: viewerIsDiscoverable,
                showRevoke: false,
            } only %}
        {% endfor %}
    </ul>

    <a href="{{ path('app_profile_connection_list') }}"
       class="mt-4 self-end inline-flex items-center max-md:min-h-11 text-[13px] font-semibold text-rose-ft hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-ft rounded">
        {{ 'dashboard.widget.connections.manage'|trans({}, 'navigation') }} →
    </a>
</div>
