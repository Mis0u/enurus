{#
    Contenu d'une carte d'objectif atteint — l'enveloppe (lien ou non) est posée par `_goals`.
    Variables attendues (toutes via `only`) :
    - card : array{exerciseName: string, targetLabel: string, achievedAt: ?\DateTimeImmutable}
#}
{# Mobile : valeur sous le nom, comme la carte d'objectif en cours #}
<div class="flex flex-col gap-0.5 md:flex-row md:items-center md:justify-between md:gap-2">
    <span class="text-[13px] font-medium text-[#f0f4ff] truncate">🏆 {{ card.exerciseName }}</span>
    <span class="text-[11px] md:text-[12px] text-cyan-ft shrink-0">{{ card.targetLabel }}</span>
</div>
{% if card.achievedAt is not null %}
    <p class="text-[12px] text-[#8b9bb4] mt-1">
        {{ 'dashboard.widget.goal.achieved_on'|trans({date: card.achievedAt|format_date('medium', locale=app.request.locale)}, 'navigation') }}
    </p>
{% endif %}
