{#
    Variables attendues (toutes via `only`) :
    - title : string — titre du widget
#}
<div class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] flex flex-col gap-4">
    <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold tracking-[1.5px] uppercase text-[#4a5568]">{{ title }}</span>
        <svg class="w-4 h-4 text-[#4a5568]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline stroke-linecap="round" stroke-linejoin="round" points="12 6 12 12 16 14"></polyline>
        </svg>
    </div>
    <span class="text-[13px] text-[#4a5568]">
        {{ 'dashboard.widget.coming_soon'|trans({}, 'navigation') }}
    </span>
</div>
