{#
    Contenu d'une carte d'objectif en cours — l'enveloppe (lien ou non) est posée par `_goals`.
    Variables attendues (toutes via `only`) :
    - card : array{exerciseName: string, currentLabel: string, targetLabel: string, percent: int}
#}
{# Mobile : valeurs sous le nom, sinon elles prennent toute la ligne et coupent le nom de l'exercice #}
<div class="flex flex-col gap-0.5 md:flex-row md:items-center md:justify-between md:gap-2 mb-1.5">
    <span class="text-[13px] font-medium text-[#f0f4ff] truncate">{{ card.exerciseName }}</span>
    <span class="text-[11px] md:text-[12px] text-[#8b9bb4] shrink-0">{{ card.currentLabel }} / {{ card.targetLabel }}</span>
</div>
<div class="h-1.5 rounded-full bg-white/[0.06] overflow-hidden">
    <div class="h-full rounded-full bg-rose-ft" style="width: {{ card.percent }}%;"></div>
</div>
