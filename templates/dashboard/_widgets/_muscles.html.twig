{#
    Variables attendues (toutes via `only`) :
    - user                    : User
    - muscleWeekMonthUnlocked : bool
    - sessionPrimary          : string[]
    - sessionSecondary        : string[]
    - weekPrimary             : string[]
    - weekSecondary           : string[]
    - monthPrimary            : string[]
    - monthSecondary          : string[]
    - sessionBars             : array{bars: array<array{name: string, sets: int, percentage: int, primarySets: int, secondarySets: int, primaryPercentage: int, secondaryPercentage: int, daysSinceLastSolicited: int|null}>, remainingCount: int}
    - weekBars                : array{bars: array<array{name: string, sets: int, percentage: int, primarySets: int, secondarySets: int, primaryPercentage: int, secondaryPercentage: int, daysSinceLastSolicited: int|null}>, remainingCount: int}
    - monthBars               : array{bars: array<array{name: string, sets: int, percentage: int, primarySets: int, secondarySets: int, primaryPercentage: int, secondaryPercentage: int, daysSinceLastSolicited: int|null}>, remainingCount: int}
#}
<div class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] overflow-hidden relative transition-ft hover:border-white/[0.12] hover:shadow-[0_8px_30px_rgba(0,0,0,0.3)] flex flex-col"
     data-controller="dashboard--muscles"
     data-dashboard--muscles-session-primary-value='{{ sessionPrimary|json_encode }}'
     data-dashboard--muscles-session-secondary-value='{{ sessionSecondary|json_encode }}'
     data-dashboard--muscles-week-primary-value='{{ weekPrimary|json_encode }}'
     data-dashboard--muscles-week-secondary-value='{{ weekSecondary|json_encode }}'
     data-dashboard--muscles-month-primary-value='{{ monthPrimary|json_encode }}'
     data-dashboard--muscles-month-secondary-value='{{ monthSecondary|json_encode }}'>

    {# En-tête #}
    <div class="flex items-center gap-[7px] mb-4">
        {% include 'partials/_svg/_profile.html.twig' with {'width': 3.75, 'height': 3.75, 'extraClass': 'text-[#8b9bb4]'} only %}
        <span class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
            {{ 'dashboard.widget.muscles.title'|trans({}, 'navigation') }}
        </span>
        <span class="inline-flex items-center justify-center w-4 h-4 shrink-0 cursor-help text-[#4a5568] hover:text-[#8b9bb4] transition-ft"
              title="{{ 'dashboard.widget.muscles.sort_info'|trans({}, 'navigation') }}">
            <svg class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
        </span>
    </div>

    <div class="flex-1 flex flex-col justify-center">
        {# Filtres (Semaine/Mois affichés uniquement si débloqués) #}
        {% if muscleWeekMonthUnlocked %}
        <div class="flex items-center gap-1 bg-white/[0.04] border border-white/[0.07] rounded-lg p-1 mb-5">
            <button type="button"
                    data-dashboard--muscles-target="tab"
                    data-filter="session"
                    data-action="click->dashboard--muscles#switchFilter"
                    class="dashboard-tab-active flex-1 px-3 py-1.5 text-[12px] font-semibold rounded-md transition-ft">
                {{ 'dashboard.widget.muscles.filter.session'|trans({}, 'navigation') }}
            </button>
            <button type="button"
                    data-dashboard--muscles-target="tab"
                    data-filter="week"
                    data-action="click->dashboard--muscles#switchFilter"
                    class="dashboard-tab-inactive flex-1 px-3 py-1.5 text-[12px] font-semibold rounded-md transition-ft">
                {{ 'dashboard.widget.muscles.filter.week'|trans({}, 'navigation') }}
            </button>
            <button type="button"
                    data-dashboard--muscles-target="tab"
                    data-filter="month"
                    data-action="click->dashboard--muscles#switchFilter"
                    class="dashboard-tab-inactive flex-1 px-3 py-1.5 text-[12px] font-semibold rounded-md transition-ft">
                {{ 'dashboard.widget.muscles.filter.month'|trans({}, 'navigation') }}
            </button>
        </div>
        {% endif %}

        {# Silhouettes SVG avant + dos #}
        <div class="flex items-center justify-center gap-6 mb-4">
            <div class="w-[120px] [&_svg]:!h-auto [&_svg]:max-h-[240px]">
                {% include 'SVG_BODY/' ~ user.gender.value ~ '/front.html.twig' only %}
            </div>
            <div class="w-[120px] [&_svg]:!h-auto [&_svg]:max-h-[240px]">
                {% include 'SVG_BODY/' ~ user.gender.value ~ '/back.html.twig' only %}
            </div>
        </div>

        {# Légende #}
        <div class="flex items-center justify-center gap-5 text-[11.5px] text-[#8b9bb4]">
            <div class="flex items-center gap-2">
                <span class="show-muscles-dot-primary w-2 h-2 rounded-full shrink-0"></span>
                {{ 'workout.show.muscles_primary'|trans({}, 'navigation') }}
            </div>
            <div class="flex items-center gap-2">
                <span class="show-muscles-dot-secondary w-2 h-2 rounded-full shrink-0"></span>
                {{ 'workout.show.muscles_secondary'|trans({}, 'navigation') }}
            </div>
        </div>

        {# Répartition par groupe musculaire (nombre de séries), un panneau par filtre #}
        {% include 'dashboard/_widgets/_muscle_bars_panel.html.twig' with {
            distribution: sessionBars,
            filter: 'session',
            active: true,
        } only %}
        {% include 'dashboard/_widgets/_muscle_bars_panel.html.twig' with {
            distribution: weekBars,
            filter: 'week',
            active: false,
        } only %}
        {% include 'dashboard/_widgets/_muscle_bars_panel.html.twig' with {
            distribution: monthBars,
            filter: 'month',
            active: false,
        } only %}
    </div>
</div>
