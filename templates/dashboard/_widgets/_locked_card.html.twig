{#
    Variables attendues (toutes via `only`) :
    - title        : string  — titre du widget
    - need_workouts: int     — séances manquantes (0 si condition atteinte)
    - need_days    : int     — jours d'ancienneté manquants (0 si condition atteinte ou non applicable)
#}
<div class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] flex flex-col gap-4 opacity-60 select-none">
    <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold tracking-[1.5px] uppercase text-[#4a5568]">{{ title }}</span>
        <svg class="w-4 h-4 text-[#4a5568]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"></path>
        </svg>
    </div>

    <div class="flex-1 flex flex-col items-center justify-center text-center gap-2">
        <span class="text-[32px] leading-none" aria-hidden="true">🕐</span>
        <div class="flex flex-col gap-[6px]">
            {% if need_workouts > 0 %}
                <span class="text-[13px] text-[#8b9bb4]">
                    {{ 'dashboard.widget.locked.need_workouts'|trans({count: need_workouts}, 'navigation') }}
                </span>
            {% endif %}
            {% if need_days > 0 %}
                <span class="text-[13px] text-[#8b9bb4]">
                    {{ 'dashboard.widget.locked.need_days'|trans({count: need_days}, 'navigation') }}
                </span>
            {% endif %}
        </div>
    </div>
</div>
