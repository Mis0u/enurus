{#
    Grille des widgets du dashboard, partagée entre le dashboard de l'utilisateur et celui d'une
    connexion. Variables attendues (toutes via `only`) :
    - data    : DashboardViewData — tout ce qui est affiché, déjà calculé
    - subject : User — propriétaire des données (la silhouette suit son genre)
    - readOnly: bool — dashboard d'une connexion : ni carte verrouillée, ni lien, ni renvoi vers les réglages
    - badgesUrl: string|null — cible du lien "Voir tous les badges" du widget Badges (page "Mes badges"
                 sur son propre dashboard, page des badges d'une connexion), null pour ne pas l'afficher
#}
<div class="grid md:grid-cols-2 gap-4 md:gap-5 items-stretch">

    {# Ordre choisi par le propriétaire en réglages (DashboardWidgetEnum::inOrder()), aussi vu par ses connexions. #}
    {% for widget in data.widgetOrder %}
        {% include 'dashboard/_widgets/_widget.html.twig' with {
            widget: widget,
            data: data,
            subject: subject,
            readOnly: readOnly,
            badgesUrl: badgesUrl,
        } only %}
    {% endfor %}

    {# Tous les widgets débloqués ont été masqués par l'utilisateur — évite un écran vide. En lecture
       seule la carte "verrouillé" de Régularité n'est jamais affichée : seule l'absence de widget
       visible compte, sans quoi la grille resterait blanche. #}
    {% if readOnly ? data.hasNoVisibleWidgets : data.hasNoVisibleContent %}
        {% include 'dashboard/_widgets/_no_visible_widgets_card.html.twig' with {
            readOnly: readOnly,
            subjectNickname: subject.nickname,
        } only %}
    {% endif %}

</div>
