{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans({}, 'navigation')|format_title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/guided-tour.css') }}">
{% endblock %}

{% block state %}
    <div class="flex-1 overflow-y-auto p-4 max-md:pb-4 md:p-[24px_28px]">
        {% if yearInReviewBannerYear is not null %}
            {% include 'year_in_review/_dashboard_banner.html.twig' with {year: yearInReviewBannerYear} only %}
        {% endif %}
        {% include 'dashboard/_dashboard_grid.html.twig' with {
            data: data,
            subject: user,
            readOnly: false,
            badgesUrl: path('app_badge_list'),
        } only %}
    </div>

    {% if guidedTourSteps is not empty %}
        {% include 'partials/_guided_tour/_guided_tour.html.twig' with {tourSteps: guidedTourSteps, hasWorkouts: true} only %}
    {% endif %}
{% endblock %}
