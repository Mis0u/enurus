<nav class="flex-1 px-[10px] py-[16px] flex flex-col gap-[3px] overflow-y-auto overflow-x-hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

    {% set unread_contact_count = contact_unread_count(app.user) %}

    <twig:Link:Primary:Primary link="{{ path('app_workout') }}" message="{{ 'dashboard.save_workout'|trans({}, 'navigation') }}" icon="add"/>

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_dashboard') }}"
        route="app_dashboard"
        menu="{{ 'dashboard.title'|trans({}, 'navigation') }}"
        icon="house"
    />
    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_workout_list') }}"
        route="app_workout_list"
        menu="{{ 'dashboard.my_workouts'|trans({}, 'navigation') }}"
        icon="calendar"
    />
    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_exercise_list') }}"
        route="app_exercise_list"
        menu="{{ 'dashboard.library'|trans({}, 'navigation') }}"
        icon="library"
    />
    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_routine_list') }}"
        route="app_routine_list"
        menu="{{ 'dashboard.my_routines'|trans({}, 'navigation') }}"
        icon="repeat"
    />

    <div class="h-px bg-white/[0.07] my-2 mx-1"></div>

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_contact_thread_list') }}"
        route="app_contact_thread_list"
        menu="{{ 'dashboard.messaging'|trans({}, 'navigation') }}"
        icon="messaging"
        badge="{{ unread_contact_count > 0 }}"
        totalNotification="{{ unread_contact_count }}"
    />
    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_contact') }}"
        route="app_contact"
        menu="{{ 'dashboard.contact'|trans({}, 'navigation') }}"
        icon="envelope"
    />
</nav>
