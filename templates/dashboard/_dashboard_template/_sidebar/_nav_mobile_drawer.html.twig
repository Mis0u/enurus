<div
    data-mobile-nav-target="overlay"
    class="hidden md:hidden fixed inset-0 bg-[rgba(8,14,26,0.85)] backdrop-blur-sm z-[110]"
    data-action="click->mobile-nav#close"
>
    {# `h-full` (hauteur visible de l'overlay `fixed inset-0`), jamais `h-screen` : 100vh inclut la
       zone sous la barre d'adresse des navigateurs mobiles, ce qui repoussait le pied du menu
       (Réglages, Déconnexion) hors de l'écran. #}
    <aside
        data-mobile-nav-target="panel"
        class="h-full w-[240px] bg-bg-card border-r border-white/[0.07] flex flex-col overflow-hidden -translate-x-full transition-transform duration-300"
        data-action="click->mobile-nav#stop"
    >
        <div class="relative">
            {% include 'dashboard/_dashboard_template/_sidebar/_logo.html.twig' only %}
            <button
                type="button"
                class="absolute top-1/2 right-2 -translate-y-1/2 flex items-center justify-center w-11 h-11 text-[#8b9bb4] hover:text-[#f0f4ff] transition-ft"
                data-action="click->mobile-nav#close"
                aria-label="{{ 'field.close_menu'|trans({}, 'common') }}"
            >
                {% include 'partials/_svg/_cross.html.twig' with {'width': 4.5, 'height': 4.5, 'ariaHidden': true} only %}
            </button>
        </div>
        {% include 'dashboard/_dashboard_template/_sidebar/_nav.html.twig' only %}
        {% include 'dashboard/_dashboard_template/_sidebar/_nav_footer.html.twig' only %}
    </aside>
</div>
