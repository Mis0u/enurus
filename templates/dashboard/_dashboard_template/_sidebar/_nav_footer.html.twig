<div class="px-[10px] py-[10px] border-t border-white/[0.07] flex flex-col gap-[3px]">
    {% if is_granted('ROLE_ADMIN') %}
        <twig:Navigation:Sidebar:NavigationItem
            link="{{ path('admin') }}"
            menu="Administration"
            icon="gear"
        />
    {% endif %}
    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_settings') }}"
        route="app_settings"
        menu="{{ 'dashboard.setting'|trans({}, 'navigation') }}"
        icon="gear"
    />
    <twig:Navigation:Sidebar:NavigationItem link="{{ logout_path() }}" menu="{{ 'dashboard.logout'|trans({}, 'navigation') }}" icon="logout" route="app_logout"/>
</div>
