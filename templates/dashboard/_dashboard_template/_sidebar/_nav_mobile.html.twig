{# Seule navigation sur mobile : les pages absentes de la barre sont dans le panneau « Plus »
   (composant Navigation:MobileMoreMenu). #}
<nav aria-label="{{ 'dashboard.main_navigation'|trans({}, 'navigation') }}"
     class="md:hidden flex items-center justify-around fixed bottom-0 left-0 right-0 h-[70px] bg-bg-card border-t border-white/[0.07] z-[100] px-2 shadow-[0_-4px_20px_rgba(0,0,0,0.3)]">

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_dashboard') }}"
        route="app_dashboard"
        menu="{{ 'dashboard.title'|trans({}, 'navigation') }}"
        icon="house"
        format="mobile"
    />

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_workout_list') }}"
        route="app_workout_list"
        menu="{{ 'dashboard.workout'|trans({}, 'navigation') }}"
        icon="calendar"
        format="mobile"
    />

    {# Masqué sur les formulaires de séance (enregistrement, édition) : il chevauchait leur barre
       d'action fixe (deux boutons rouges l'un sur l'autre). #}
    {% if app.request.attributes.get('_route') not in ['app_workout', 'app_workout_edit'] %}
        <a href="{{ path('app_workout') }}"
           aria-label="{{ 'dashboard.save_workout'|trans({}, 'navigation') }}"
           class="bottom-nav-cta flex items-center justify-center relative -top-5 w-16 h-16 bg-gradient-to-br from-rose-ft to-red-600 rounded-full shadow-[0_4px_20px_rgba(244,63,94,0.3)] border-4 border-bg-base no-underline transition-ft">
            {% include 'partials/_svg/_add.html.twig' with {'width': 6.5, 'height': 6.5, 'strokeColor': 'white'} only %}
        </a>
    {% endif %}

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_exercise_list') }}"
        route="app_exercise_list"
        menu="{{ 'dashboard.library'|trans({}, 'navigation') }}"
        icon="library"
        format="mobile"
    />

    <twig:Navigation:MobileMoreMenu/>
</nav>
