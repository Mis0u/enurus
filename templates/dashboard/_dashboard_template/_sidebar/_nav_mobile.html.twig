<nav class="md:hidden flex items-center justify-around fixed bottom-0 left-0 right-0 h-[70px] bg-bg-card border-t border-white/[0.07] z-[100] px-2 shadow-[0_-4px_20px_rgba(0,0,0,0.3)]">

    {% set unread_contact_count = contact_unread_count(app.user) %}

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_dashboard') }}"
        route="app_dashboard"
        menu="{{ 'dashboard.title'|trans({}, 'navigation') }}"
        icon="house"
        mobile="true"
    />

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_workout_list') }}"
        route="app_workout_list"
        menu="{{ 'dashboard.workout'|trans({}, 'navigation') }}"
        icon="calendar"
        mobile="true"
    />

    <a href="#"
       class="bottom-nav-cta flex items-center justify-center relative -top-5 w-16 h-16 bg-gradient-to-br from-rose-ft to-red-600 rounded-full shadow-[0_4px_20px_rgba(244,63,94,0.3)] border-4 border-bg-base no-underline transition-ft">
        {% include 'partials/_svg/_add.html.twig' with {'width': 6.5, 'height': 6.5, 'strokeColor': 'white'} only %}
    </a>

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_contact_thread_list') }}"
        route="app_contact_thread_list"
        menu="{{ 'dashboard.messaging'|trans({}, 'navigation') }}"
        icon="messaging"
        badge="{{ unread_contact_count > 0 }}"
        totalNotification="{{ unread_contact_count }}"
        mobile="true"
    />

    <twig:Navigation:Sidebar:NavigationItem
        link="{{ path('app_settings') }}"
        route="app_settings"
        menu="{{ 'dashboard.profile'|trans({}, 'navigation') }}"
        icon="profile"
        mobile="true"
    />
</nav>
