<div class="relative z-[5] bg-[rgba(8,14,26,0.85)] backdrop-blur-[12px] border-b border-white/[0.07] px-4 md:px-7 py-3 md:py-[14px] flex items-center justify-between gap-4 flex-shrink-0">
    <div>
        <h1 class="font-rajdhani text-lg md:text-[22px] font-bold">{{ title }}</h1>
        <p class="hidden md:block text-[12.5px] text-[#8b9bb4] mt-px">
            {{ 'now'|format_datetime(pattern: "EEEE d MMMM Y", locale: app.user.locale)|capitalize }}
        </p>
    </div>
    <div class="flex items-center gap-2 md:gap-3">
        {% if action is defined %}
            <a
                href="{{ action.url }}"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[10px] text-[13.5px] font-semibold text-white
                       bg-gradient-to-br from-rose-ft to-red-600
                       shadow-[0_4px_15px_rgba(244,63,94,0.3)]
                       hover:shadow-[0_6px_22px_rgba(244,63,94,0.5)] hover:-translate-y-px
                       transition-all duration-200 whitespace-nowrap"
            >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                {{ action.label }}
            </a>
        {% endif %}
        <div class="hidden md:flex w-9 h-9 rounded-full bg-gradient-to-br from-rose-ft to-cyan-ft items-center justify-center font-rajdhani font-bold text-[15px] border-2 border-[rgba(244,63,94,0.4)]">
            {{ subtitle }}
        </div>
    </div>
</div>
