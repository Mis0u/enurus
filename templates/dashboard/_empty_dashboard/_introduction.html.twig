<div class="hero-icon-wrap w-[60px] h-[60px] md:w-[72px] md:h-[72px] flex items-center justify-center mx-auto mb-5 md:mb-6">
    <img
        src="{{ asset('images/logo.png') }}"
        alt="logo {{ 'name'|trans({}, 'brand') }}"
        class="w-[44px] h-[44px] md:w-[40px] md:h-[40px] object-contain"
    >
</div>

<div class="anim-fade-1 text-[11px] md:text-[12px] font-semibold tracking-[1.5px] md:tracking-[2px] uppercase text-rose-ft mb-2">
    {{ 'sentence.welcome_to'|trans({'%brand%': 'name'|trans({}, 'brand')}, 'common') }}
</div>

<h2 class="hero-title anim-fade-2 font-rajdhani text-[28px] md:text-[36px] font-bold leading-[1.1] mb-[10px] md:mb-3">
    {{ 'word.hi'|trans({}, 'common') }} <span>{{ app.user.nickname }}</span>,<br>
    {{ 'sentence.ready'|trans({}, 'common')|lower }}
</h2>

<p class="anim-fade-3 text-[13px] md:text-sm text-[#8b9bb4] leading-[1.65] mb-6 md:mb-8 max-w-[360px] mx-auto">
    {{ 'sentence.empty_dashboard'|trans({}, 'common') }}
</p>

<a href="{{ path('app_workout') }}"
   class="anim-cta inline-flex items-center gap-[10px] px-7 md:px-9 py-[14px] md:py-4 bg-gradient-to-br from-rose-ft to-red-600 rounded-[14px] text-white text-[15px] md:text-base font-bold font-rajdhani tracking-[0.5px] no-underline shadow-[0_8px_28px_rgba(244,63,94,0.3)] transition-ft hover:-translate-y-0.5 hover:scale-[1.02] hover:shadow-[0_14px_38px_rgba(244,63,94,0.5)] active:scale-[0.98] mb-6 md:mb-8">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
    </svg>
    {{ 'sentence.log_first_workout'|trans({}, 'common') }}
</a>

<p class="anim-fade-4 text-[11px] md:text-xs text-[#4a5568] -mt-5 mb-5 md:mb-7">
    {{ 'sentence.less_time'|trans({}, 'common') }}
</p>
