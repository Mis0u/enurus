{#
    Paramètres :
      - variants : list<ExerciseGuideLink> — lien seulement vers une variante qui a sa propre fiche
#}
<section aria-labelledby="exercise-guide-variants" class="flex flex-col gap-4">
    <h2 id="exercise-guide-variants" class="font-rajdhani font-bold text-[28px] md:text-[32px] text-slate-50">{{ 'show.variants_title'|trans({}, 'exercise_guide') }}</h2>
    <ul class="flex flex-col gap-2.5">
        {% for variant in variants %}
            <li>
                {% if variant.slug is not null %}
                    <a href="{{ path('app_exercise_guide_show', {slug: variant.slug}) }}" class="flex items-center justify-between gap-4 px-5 py-4 rounded-2xl border border-slate-800 bg-bg-card text-slate-50 no-underline hover:border-slate-600">
                        <span class="flex flex-col gap-1">
                            <span class="font-semibold">{{ variant.nameKey|trans({}, 'exercise') }}</span>
                            <span class="text-sm text-slate-400">{{ variant.reasonKey|trans({}, 'exercise_guide') }}</span>
                        </span>
                        <svg class="w-[18px] h-[18px] shrink-0 text-cyan-ft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                    </a>
                {% else %}
                    <div class="flex flex-col gap-1 px-5 py-4 rounded-2xl border border-slate-800 bg-bg-card">
                        <span class="font-semibold text-slate-50">{{ variant.nameKey|trans({}, 'exercise') }}</span>
                        <span class="text-sm text-slate-400">{{ variant.reasonKey|trans({}, 'exercise_guide') }}</span>
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</section>
