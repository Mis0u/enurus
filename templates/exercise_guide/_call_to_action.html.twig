{#
    Appel à l'action des pages exercices publiques : inscription pour un visiteur, historique de
    l'exercice (ou dashboard sur l'index) pour un utilisateur connecté.

    Paramètres :
      - isLoggedIn : bool
      - exerciseId : string|null — exercice de la fiche, null sur l'index.
#}
<section aria-labelledby="exercise-guide-cta-title" class="rounded-[20px] p-px bg-gradient-to-r from-rose-ft to-cyan-ft">
    <div class="flex flex-wrap items-center justify-between gap-5 p-6 md:p-8 rounded-[19px] bg-bg-card">
        <div class="flex flex-col gap-1.5 max-w-xl">
            {% if isLoggedIn %}
                <h2 id="exercise-guide-cta-title" class="font-rajdhani font-bold text-2xl md:text-[28px] leading-tight text-slate-50">{{ 'call_to_action.logged_in.title'|trans({}, 'exercise_guide') }}</h2>
                <p class="text-slate-400">{{ 'call_to_action.logged_in.text'|trans({}, 'exercise_guide') }}</p>
            {% else %}
                <h2 id="exercise-guide-cta-title" class="font-rajdhani font-bold text-2xl md:text-[28px] leading-tight text-slate-50">{{ 'call_to_action.visitor.title'|trans({}, 'exercise_guide') }}</h2>
                <p class="text-slate-400">{{ 'call_to_action.visitor.text'|trans({}, 'exercise_guide') }}</p>
            {% endif %}
        </div>

        {% if not isLoggedIn %}
            <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center h-13 px-6 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold whitespace-nowrap no-underline transition-colors max-sm:w-full">
                {{ 'call_to_action.visitor.button'|trans({}, 'exercise_guide') }}
            </a>
        {% elseif exerciseId is not null %}
            <a href="{{ path('app_exercise_history', {id: exerciseId}) }}" class="inline-flex items-center justify-center h-13 px-6 rounded-xl bg-cyan-700 hover:bg-cyan-800 text-white font-semibold whitespace-nowrap no-underline transition-colors max-sm:w-full">
                {{ 'call_to_action.logged_in.history'|trans({}, 'exercise_guide') }}
            </a>
        {% else %}
            <a href="{{ path('app_dashboard') }}" class="inline-flex items-center justify-center h-13 px-6 rounded-xl bg-cyan-700 hover:bg-cyan-800 text-white font-semibold whitespace-nowrap no-underline transition-colors max-sm:w-full">
                {{ 'call_to_action.logged_in.dashboard'|trans({}, 'exercise_guide') }}
            </a>
        {% endif %}
    </div>
</section>
