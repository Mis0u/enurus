{% extends 'base.html.twig' %}

{% block title %}{{ 'index.title'|trans({}, 'exercise_guide')|format_title }}{% endblock %}

{% block meta_description %}{{ 'index.meta_description'|trans({}, 'exercise_guide') }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-bg-base text-slate-200 font-dm-sans">
        {% include 'home/_header.html.twig' with {locales: locales, currentLocale: currentLocale, isLoggedIn: isLoggedIn} only %}

        <main class="max-w-6xl mx-auto px-4 md:px-6 pb-12 md:pb-20">
            {% include 'exercise_guide/_breadcrumb.html.twig' with {currentNameKey: null} only %}

            <section class="flex flex-col gap-5 pt-2 pb-10 md:pb-14">
                <h1 class="font-rajdhani font-bold text-[40px] md:text-6xl leading-none text-slate-50">
                    {{ 'index.heading'|trans({}, 'exercise_guide') }}
                    <span class="block text-rose-ft">{{ 'index.heading_highlight'|trans({}, 'exercise_guide') }}</span>
                </h1>
                <p class="max-w-2xl text-lg text-slate-400">{{ 'index.intro'|trans({}, 'exercise_guide') }}</p>
            </section>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 pb-12">
                {% for muscle_group in muscleGroups %}
                    <section aria-labelledby="muscle-{{ loop.index }}" class="flex flex-col gap-3 p-5 rounded-2xl border border-slate-800 bg-bg-card">
                        <h2 id="muscle-{{ loop.index }}" class="font-rajdhani font-bold text-2xl text-slate-50">{{ muscle_group.muscleKey|trans({}, 'muscle') }}</h2>
                        <ul class="flex flex-col gap-1">
                            {% for exercise in muscle_group.exercises %}
                                <li>
                                    <a href="{{ path('app_exercise_guide_show', {slug: exercise.slug}) }}" class="flex items-center justify-between gap-3 min-h-11 px-3 -mx-3 rounded-lg text-slate-200 no-underline hover:bg-bg-card-hover hover:text-white">
                                        {{ exercise.nameKey|trans({}, 'exercise') }}
                                        <svg class="w-4 h-4 shrink-0 text-cyan-ft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
            </div>

            {% include 'exercise_guide/_call_to_action.html.twig' with {isLoggedIn: isLoggedIn, exerciseId: null} only %}
        </main>

        <footer class="px-4 pb-6">
            {% include 'partials/_common/_footer.html.twig' only %}
        </footer>
    </div>
{% endblock %}
