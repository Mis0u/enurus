<section class="max-w-6xl mx-auto px-4 md:px-6 pt-8 md:pt-20 pb-16 md:pb-28 flex flex-wrap items-center gap-14">
    <div class="flex-[1_1_460px] min-w-0 flex flex-col items-start gap-6">
        <p class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-green-ft/10 text-green-400 text-sm font-semibold">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            {{ 'home.hero.badge'|trans({}, 'home') }}
        </p>

        <h1 class="font-rajdhani font-bold text-[42px] md:text-6xl lg:text-[76px] leading-none text-slate-50">
            {{ 'home.hero.title'|trans({}, 'home') }}
            <span class="block text-rose-ft">{{ 'home.hero.title_highlight'|trans({}, 'home') }}</span>
        </h1>

        <p class="text-lg md:text-xl text-slate-400 max-w-xl">{{ 'home.hero.subtitle'|trans({}, 'home') }}</p>

        <div class="flex flex-wrap items-center gap-3">
            <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center h-14 px-7 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-[17px] font-semibold no-underline transition-colors">
                {{ 'home.hero.cta_register'|trans({}, 'home') }}
            </a>
            <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center h-14 px-2 text-slate-200 font-medium underline underline-offset-4 hover:text-white">
                {{ 'home.hero.cta_login'|trans({}, 'home') }}
            </a>
        </div>

        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-400">
            <li>{{ 'home.hero.perks.languages'|trans({}, 'home') }}</li>
            <li>{{ 'home.hero.perks.units'|trans({}, 'home') }}</li>
            <li>{{ 'home.hero.perks.install'|trans({}, 'home') }}</li>
        </ul>
    </div>

    <div class="flex-[1_1_400px] min-w-0 flex justify-center">
        {% include 'home/_workout_preview.html.twig' only %}
    </div>
</section>
