{#
    En-tête des pages publiques (accueil, fiches exercices).

    Paramètres :
      - locales : list<LocaleAllowedEnum> — langues proposées dans le sélecteur.
      - currentLocale : LocaleAllowedEnum — langue de la page.
      - isLoggedIn : bool — un utilisateur connecté voit son dashboard au lieu de la connexion.
#}
<header class="max-w-6xl mx-auto px-4 md:px-6 py-5 flex flex-wrap items-center justify-between gap-4">
    <a href="{{ path('app_home') }}">
        <img src="{{ asset('images/enurus_logo_horizontal.webp') }}" width="500" height="83" alt="{{ 'name'|trans({}, 'brand') }}" class="h-8 sm:h-9 md:h-11 w-auto">
    </a>

    <nav aria-label="{{ 'home.header.nav_label'|trans({}, 'home') }}" class="flex flex-wrap items-center gap-2 sm:gap-3">
        <a href="{{ path('app_exercise_guide_index') }}" class="inline-flex items-center h-11 px-3 sm:px-4 rounded-lg text-slate-200 font-medium no-underline hover:text-white hover:bg-bg-card transition-colors">
            {{ 'home.header.exercises'|trans({}, 'home') }}
        </a>

        {% include 'home/_language_menu.html.twig' with {locales: locales, currentLocale: currentLocale} only %}

        {% if isLoggedIn %}
            <a href="{{ path('app_dashboard') }}" class="inline-flex items-center h-11 px-3 sm:px-4 rounded-lg border border-slate-700 text-slate-200 font-medium no-underline hover:border-slate-500 hover:text-white transition-colors">
                {{ 'home.header.dashboard'|trans({}, 'home') }}
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" class="inline-flex items-center h-11 px-3 sm:px-4 rounded-lg border border-slate-700 text-slate-200 font-medium no-underline hover:border-slate-500 hover:text-white transition-colors">
                {{ 'home.header.login'|trans({}, 'home') }}
            </a>
        {% endif %}
    </nav>
</header>
