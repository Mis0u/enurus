<div class="flex flex-col gap-1.5 text-[13px]">
    <div class="grid grid-cols-3 text-xs text-slate-500">
        <span>{{ 'home.features.logging.set'|trans({}, 'home') }}</span>
        <span>{{ 'home.features.logging.weight'|trans({}, 'home') }}</span>
        <span>{{ 'home.features.logging.reps'|trans({}, 'home') }}</span>
    </div>
    {% for row in [
        {weight: 80, reps: 8},
        {weight: 82.5, reps: 8},
        {weight: 85, reps: 6},
    ] %}
        <div class="grid grid-cols-3 py-1 border-t border-slate-800 text-slate-200">
            <span>{{ loop.index }}</span>
            <span>{{ 'home.features.logging.weight_value'|trans({'weight': row.weight}, 'home') }}</span>
            <span>{{ row.reps }}</span>
        </div>
    {% endfor %}
</div>
