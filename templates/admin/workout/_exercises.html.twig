{% set fr = enum('App\\Enum\\Translations\\LocaleAllowedEnum').FR.value %}
{% for workout_exercise in field.value|sort((a, b) => a.position <=> b.position) %}
    <div class="admin-card">
        {{ workout_exercise.exercise.name }}
    </div>
{% else %}
    <p>{{ 'admin.workout.no_exercise'|trans({}, 'admin', fr) }}</p>
{% endfor %}
