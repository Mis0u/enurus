{% extends '@EasyAdmin/crud/detail.html.twig' %}
{% set fr = enum('App\\Enum\\Translations\\LocaleAllowedEnum').FR.value %}

{% form_theme replyForm with ea().crud.formThemes only %}

{% block main %}
    {{ parent() }}

    {% block reply_form %}
        <div class="content-panel">
            <div class="content-panel-header">
                <div class="content-panel-title">{{ 'admin.thread.action.reply'|trans({}, 'admin', fr) }}</div>
            </div>
            <div class="content-panel-body">
                {{ form_start(replyForm, {action: replyActionUrl, render_rest: false}) }}
                {{ form_errors(replyForm) }}

                {% include 'admin/contact_thread/_wysiwyg_field.html.twig' with {
                    field: replyForm.message,
                } only %}

                {% include 'admin/contact_thread/_image_field.html.twig' with {
                    fieldId: 'replyImage',
                } only %}

                {{ form_row(replyForm._token) }}

                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">{{ 'admin.thread.reply.send_button'|trans({}, 'admin', fr) }}</button>
                    <button type="submit" name="closeAfterReply" value="1" class="btn btn-secondary">{{ 'admin.thread.reply.send_and_close_button'|trans({}, 'admin', fr) }}</button>
                </div>
                {{ form_end(replyForm, {render_rest: false}) }}
            </div>
        </div>
    {% endblock reply_form %}
{% endblock %}
