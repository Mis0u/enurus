{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form with ea().crud.formThemes only %}

{% block content_title %}{{ 'admin.thread.reply.title'|trans({subject: thread.subject}, 'admin', 'fr') }}{% endblock %}

{% block main %}
    {% include 'admin/contact_thread/_messages.html.twig' with {field: {value: thread.messages}} only %}

    {{ form_start(form, {render_rest: false}) }}
    {{ form_errors(form) }}

    {% include 'admin/contact_thread/_wysiwyg_field.html.twig' with {
        field: form.message,
    } only %}

    {% include 'admin/contact_thread/_image_field.html.twig' with {
        fieldId: 'replyImage',
    } only %}

    {{ form_row(form._token) }}

    <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">{{ 'admin.thread.reply.send_button'|trans({}, 'admin', 'fr') }}</button>
        <button type="submit" name="closeAfterReply" value="1" class="btn btn-secondary">{{ 'admin.thread.reply.send_and_close_button'|trans({}, 'admin', 'fr') }}</button>
    </div>
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
