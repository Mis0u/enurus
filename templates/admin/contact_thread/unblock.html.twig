{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Débloquer {{ thread.owner.email }}{% endblock %}

{% block main %}
    <p>Confirmer le déblocage de cet utilisateur ?</p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('contact_thread_admin_unblock_' ~ thread.owner.id) }}">
        <button type="submit" class="btn btn-primary">Débloquer</button>
    </form>
{% endblock %}
