{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form with ea().crud.formThemes only %}

{% block content_title %}{{ 'admin.thread.compose.title'|trans({}, 'admin', 'fr') }}{% endblock %}

{% block main %}
    {{ form_start(form, {render_rest: false}) }}
    {{ form_errors(form) }}

    <div class="mb-3 admin-recipient-autocomplete"
         data-controller="admin--recipient-autocomplete"
         data-admin--recipient-autocomplete-search-url-value="{{ recipientSearchUrl }}"
         data-admin--recipient-autocomplete-locale-label-value="{{ 'admin.thread.compose.locale_label'|trans({}, 'admin', 'fr') }}">
        <label class="form-label">{{ 'admin.thread.compose.recipient_label'|trans({}, 'admin', 'fr') }}</label>
        <input type="text"
               class="form-control"
               placeholder="{{ 'admin.thread.compose.recipient_placeholder'|trans({}, 'admin', 'fr') }}"
               autocomplete="off"
               data-admin--recipient-autocomplete-target="query"
               data-action="input->admin--recipient-autocomplete#search">
        <div class="admin-recipient-autocomplete-results" data-admin--recipient-autocomplete-target="results" hidden></div>
        <p class="admin-recipient-autocomplete-locale" data-admin--recipient-autocomplete-target="localeDisplay"></p>
        {{ form_widget(form.recipientId, {
            attr: {
                'data-admin--recipient-autocomplete-target': 'hidden',
            },
        }) }}
    </div>

    {{ form_row(form.category) }}
    {{ form_row(form.subject) }}

    {% include 'admin/contact_thread/_wysiwyg_field.html.twig' with {
        field: form.body,
    } only %}

    {% include 'admin/contact_thread/_image_field.html.twig' with {
        fieldId: 'composeImage',
    } only %}

    {{ form_row(form._token) }}

    <button type="submit" class="btn btn-primary">{{ 'admin.field.send_button'|trans({}, 'admin', 'fr') }}</button>
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
