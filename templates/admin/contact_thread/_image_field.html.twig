{#
    Variables attendues (toutes via `only`) :
    - fieldId : string — id unique de l'input file sur la page
#}
{% set fr = enum('App\\Enum\\Translations\\LocaleAllowedEnum').FR.value %}
<div class="mb-3">
    <label class="form-label" for="{{ fieldId }}">{{ 'admin.thread.image_field.label'|trans({}, 'admin', fr) }}</label>
    <input type="file"
           id="{{ fieldId }}"
           name="image"
           accept="{{ constant('App\\Constraint\\ImageConstraints::ALLOWED_MIME_TYPES')|join(',') }}"
           class="form-control">
</div>
