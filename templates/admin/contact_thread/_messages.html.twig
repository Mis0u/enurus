{% for message in field.value %}
    <div style="margin-bottom: 1rem; padding: 0.75rem 1rem; border-radius: 6px; background-color: {{ message.fromAdmin ? '#eef2ff' : '#f3f4f6' }};">
        <div style="font-size: 0.85rem; color: #6b7280; margin-bottom: 0.25rem;">
            <strong>{{ message.fromAdmin ? 'Admin' : 'Utilisateur' }}</strong>
            — {{ message.createdAt|date('d/m/Y H:i') }}
        </div>
        <div style="white-space: pre-line;">{{ message.fromAdmin ? message.body|raw : message.body }}</div>
        {% if message.imagePath %}
            <div style="margin-top: 0.5rem;">
                <a href="/uploads/{{ message.imagePath }}" target="_blank" rel="noopener">
                    <img src="/uploads/{{ message.imagePath }}" alt="" style="max-width: 220px; max-height: 160px; border-radius: 6px; object-fit: cover;">
                </a>
            </div>
        {% endif %}
    </div>
{% else %}
    <p>Aucun message.</p>
{% endfor %}
