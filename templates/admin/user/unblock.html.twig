{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.user.unblock.title'|trans({email: user.email}, 'admin', 'fr') }}{% endblock %}

{% block main %}
    <p>{{ 'admin.user.unblock.confirm'|trans({}, 'admin', 'fr') }}</p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('user_admin_unblock_' ~ user.id) }}">
        <button type="submit" class="btn btn-primary">{{ 'admin.user.unblock.button'|trans({}, 'admin', 'fr') }}</button>
    </form>
{% endblock %}
