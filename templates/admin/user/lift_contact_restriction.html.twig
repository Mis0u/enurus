{% extends '@EasyAdmin/page/content.html.twig' %}
{% set fr = enum('App\\Enum\\Translations\\LocaleAllowedEnum').FR.value %}

{% block content_title %}{{ 'admin.user.lift_contact_restriction.title'|trans({email: user.email}, 'admin', fr) }}{% endblock %}

{% block main %}
    <p>{{ 'admin.user.lift_contact_restriction.confirm'|trans({}, 'admin', fr) }}</p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('user_admin_lift_contact_restriction_' ~ user.id) }}">
        <button type="submit" class="btn btn-primary">{{ 'admin.user.lift_contact_restriction.button'|trans({}, 'admin', fr) }}</button>
    </form>
{% endblock %}
