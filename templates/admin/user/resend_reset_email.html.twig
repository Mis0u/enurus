{% extends '@EasyAdmin/page/content.html.twig' %}
{% set fr = enum('App\\Enum\\Translations\\LocaleAllowedEnum').FR.value %}

{% block content_title %}{{ 'admin.user.resend_reset_email.title'|trans({email: user.email}, 'admin', fr) }}{% endblock %}

{% block main %}
    <p>{{ 'admin.user.resend_reset_email.confirm'|trans({email: user.email}, 'admin', fr) }}</p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('user_admin_resend_reset_email_' ~ user.id) }}">
        <button type="submit" class="btn btn-primary">{{ 'admin.user.resend_reset_email.button'|trans({}, 'admin', fr) }}</button>
    </form>
{% endblock %}
