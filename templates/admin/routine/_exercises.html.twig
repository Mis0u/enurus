{% set fr = enum('App\\Enum\\Translations\\LocaleAllowedEnum').FR.value %}
{% for routine_exercise in field.value|sort((a, b) => a.position <=> b.position) %}
    {% set exercise = routine_exercise.exercise %}
    <div class="admin-card">
        {{ exercise.isPublic ? exercise.name|trans({}, 'exercise', fr) : exercise.name }}
    </div>
{% else %}
    <p>{{ 'admin.routine.no_exercise'|trans({}, 'admin', fr) }}</p>
{% endfor %}
