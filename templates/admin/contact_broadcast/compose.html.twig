{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form with ea().crud.formThemes only %}

{% block content_title %}Nouvelle diffusion{% endblock %}

{% block main %}
    <style>
        .target-radios-horizontal .form-check {
            display: inline-flex;
            align-items: center;
            margin-right: 1.25rem;
            margin-bottom: 0.5rem;
        }
    </style>

    {{ form_start(form, {render_rest: false}) }}
    {{ form_errors(form) }}

    {{ form_row(form.target, {
        row_attr: {
            class: 'target-radios-horizontal',
        },
    }) }}
    {{ form_row(form.subject) }}

    {% include 'admin/contact_thread/_wysiwyg_field.html.twig' with {
        field: form.body,
    } only %}

    {% include 'admin/contact_thread/_image_field.html.twig' with {
        fieldId: 'broadcastImage',
    } only %}

    {{ form_row(form._token) }}

    <button type="submit" class="btn btn-primary">Envoyer</button>
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
