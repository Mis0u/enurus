<!DOCTYPE html>
<html lang={{ locale }}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {% set brand_name = 'name'|trans({}, 'brand', locale) %}
        <title>{{ 'registration.email.registration_confirm'|trans({'%brand%': '- %s'|replace({'%s': brand_name})}, 'security', locale) }}</title>
    </head>
    <body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #0f172a; color: #e2e8f0;">

        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #0f172a; padding: 40px 20px;">
            <tr>
                <td align="center">

                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; background: linear-gradient(135deg, #1e293b 0%, #334155 100%); border-radius: 24px; overflow: hidden; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);">
                        <tr>
                            <td style="padding: 40px 40px 30px; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <div style="text-align: center; margin-bottom: 16px;">
                                    <img src="{{ absolute_url(asset('images/logo.png')) }}" alt="logo {{ 'name'|trans({}, 'brand') }}" style="display: block; margin: 0 auto 8px; height: 160px;">
                                </div>
                                <h1 style="margin: 0; font-size: 28px; font-weight: bold; color: #ffffff;">{{ brand_name }}</h1>
                                <p style="margin: 8px 0 0; font-size: 14px; color: #94a3b8;">{{ 'sentence.welcome'|trans({}, 'common', locale) }}</p>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 40px;">
                                <h2 style="margin: 0 0 24px; font-size: 24px; font-weight: bold; color: #ffffff; text-align: center;">{{ 'registration.email.registration_confirm'|trans({'%brand%': ''}, 'security', locale) }}</h2>

                                <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #cbd5e1; text-align: center;">
                                    {{ 'registration.email.click_activate'|trans({}, 'security', locale) }}
                                </p>

                                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                    <tr>
                                        <td align="center" style="padding: 0 0 32px;">
                                            <a href="{{ signedUrl|raw }}" style="display: inline-block; padding: 16px 32px; background: linear-gradient(135deg, #f43f5e 0%, #dc2626 100%); color: #ffffff; text-decoration: none; font-size: 16px; font-weight: bold; border-radius: 12px; box-shadow: 0 8px 20px rgba(244, 63, 94, 0.3);">
                                                ✅ {{ 'registration.email.activate_account'|trans({}, 'security', locale) }}
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                                <div style="background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 16px; margin-bottom: 24px;">
                                    <p style="margin: 0 0 8px; font-size: 12px; color: #94a3b8; font-weight: 600;">
                                        {{ 'sentence.email.button_failed'|trans({}, 'common', locale) }} :
                                    </p>
                                    <p style="margin: 0; font-size: 12px; color: #06b6d4; word-break: break-all;">
                                        <a href="{{ signedUrl|raw }}" style="color: #06b6d4; text-decoration: none;">
                                            {{ signedUrl|raw }}
                                        </a>
                                    </p>
                                </div>

                                <div style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(245, 158, 11, 0.1) 100%); border-left: 4px solid #f59e0b; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
                                            <td width="24" valign="top">
                                                <svg style="width: 20px; height: 20px; margin-top: 2px;" fill="none" stroke="#fbbf24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                            </td>
                                            <td style="padding-left: 12px;">
                                                <p style="margin: 0; font-size: 14px; color: #fbbf24; font-weight: 600;">
                                                    {{ 'registration.email.info_link_life'|trans({'%hour%': expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle')}, 'security', locale) }}
                                                </p>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(8, 145, 178, 0.1) 100%); border-radius: 12px; padding: 20px; text-align: center;">
                                    <p style="margin: 0 0 8px; font-size: 18px; font-weight: bold; color: #22d3ee;">
                                        🎯 {{ 'sentence.ready_to_transform'|trans({}, 'common', locale) }}
                                    </p>
                                    <p style="margin: 0; font-size: 14px; color: #67e8f9; line-height: 1.5;">
                                        {{ 'baseline'|trans({}, 'brand', locale) }}
                                    </p>
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 30px 40px; border-top: 1px solid rgba(255, 255, 255, 0.1); text-align: center;">
                                <p style="margin: 0 0 16px; font-size: 14px; color: #64748b;">
                                    {{ 'sentence.need_help'|trans({}, 'common', locale) }} <a href="#" style="color: #06b6d4; text-decoration: none;">{{ 'sentence.contact_support'|trans({}, 'common', locale) }}</a>
                                </p>
                                <p style="margin: 0 0 8px; font-size: 12px; color: #475569;">
                                    {{ 'sentence.email.email_received_explanation'|trans({'%brand%': brand_name}, 'common', locale) }}
                                </p>
                                <p style="margin: 0; font-size: 12px; color: #475569;">
                                    {{ 'footer.copyright'|trans({'%year%': "now"|date("Y"), '%brand%': brand_name}, 'navigation', locale) }}
                                </p>
                            </td>
                        </tr>

                    </table>

                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin-top: 20px;">
                        <tr>
                            <td style="text-align: center; padding: 0 20px;">
                                <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #475569;">
                                    {{ 'registration.email.not_created_account'|trans({'%brand%': brand_name}, 'security', locale) }}
                                </p>
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
        </table>
    </body>
</html>
