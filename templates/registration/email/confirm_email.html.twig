{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'registration.confirm_email'|trans({}, 'navigation', locale) }}{% endblock %}

{% block content %}
    <h2 style="margin: 0 0 24px; font-size: 24px; font-weight: bold; color: #ffffff;">{{ 'registration.email.registration_confirm'|trans({'brand': brand_name}, 'navigation', locale) }}</h2>

    <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #cbd5e1;">
        {{ 'word.hello'|trans({}, 'common', locale) }} {{ user.nickname }},
    </p>

    <p style="margin: 0 0 32px; font-size: 16px; line-height: 1.6; color: #cbd5e1;">
        {{ 'registration.email.click_activate'|trans({}, 'navigation', locale) }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding: 0 0 32px;">
                <a href="{{ signature.signedUrl }}" style="display: inline-block; padding: 16px 32px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: #ffffff; text-decoration: none; font-size: 16px; font-weight: bold; border-radius: 12px; box-shadow: 0 8px 20px rgba(6, 182, 212, 0.3);">
                    {{ 'registration.email.activate_account'|trans({}, 'navigation', locale) }}
                </a>
            </td>
        </tr>
    </table>

    {{ include('registration/email/_info_expiration.html.twig') }}
    {{ include('registration/email/_security_note.html.twig') }}
{% endblock %}

{% block footer %}
    <p style="margin: 0 0 8px; font-size: 12px; color: #475569;">
        {{ 'registration.email.receive_email'|trans({'brand': brand_name, 'gender': user.gender.value}, 'navigation', locale) }}
    </p>
    <p style="margin: 0; font-size: 12px; color: #475569;">
        {{ 'footer.copyright'|trans({'year': "now"|date("Y"), 'brand': brand_name}, 'navigation', locale) }}
    </p>
{% endblock %}
