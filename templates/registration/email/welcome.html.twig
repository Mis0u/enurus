{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'sentence.welcome'|trans({}, 'common', locale) }}{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 24px;">
        <span style="font-size: 64px;">🎉</span>
    </div>

    <h2 style="margin: 0 0 16px; font-size: 24px; font-weight: bold; color: #ffffff; text-align: center;">
        {{ 'word.welcome'|trans({}, 'common', locale) }} {{ user.nickname }} ! 💪
    </h2>

    <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #cbd5e1; text-align: center;">
        {{ 'registration.account_created'|trans({}, 'navigation', locale) }}
    </p>

    <div style="background-color: rgba(6, 182, 212, 0.1); border-left: 4px solid #06b6d4; border-radius: 8px; padding: 20px; margin-bottom: 28px;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: bold; color: #06b6d4;">🚀 {{ 'sentence.where_to_start'|trans({}, 'common', locale) }}</h3>
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 8px;">
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #cbd5e1;">
                    <strong style="color:#22d3ee">1.</strong> {{ 'sentence.log_workout'|trans({}, 'common', locale) }}
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #cbd5e1;">
                    <strong style="color:#22d3ee">2.</strong> {{ 'sentence.add_datas'|trans({}, 'common', locale) }}
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #cbd5e1;">
                    <strong style="color:#22d3ee">3.</strong> {{ 'sentence.enjoy'|trans({}, 'common', locale) }} ✨
                </td>
            </tr>
        </table>
    </div>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding: 0 0 32px;">
                <a href="{{ url('app_dashboard', {_locale: locale}) }}" style="display: inline-block; padding: 16px 32px; background: linear-gradient(135deg, #f43f5e 0%, #dc2626 100%); color: #ffffff; text-decoration: none; font-size: 16px; font-weight: bold; border-radius: 12px; box-shadow: 0 8px 20px rgba(244, 63, 94, 0.3);">
                    💪 {{ 'sentence.log_workout'|trans({}, 'common', locale) }}
                </a>
            </td>
        </tr>
    </table>

    <div style="background: linear-gradient(135deg, rgba(244, 63, 94, 0.1) 0%, rgba(220, 38, 38, 0.05) 100%); border-radius: 12px; padding: 20px; margin-bottom: 24px;">
        <h3 style="margin: 0 0 14px; font-size: 16px; font-weight: bold; color: #f43f5e; text-align: center;">🎯 {{ 'sentence.what_next'|trans({}, 'common', locale) }}</h3>

        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
                <td style="padding: 8px 0;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td width="30" valign="top">
                                <span style="font-size: 18px;">📊</span>
                            </td>
                            <td style="padding-left: 10px;">
                                <strong style="color: #f0f4ff; font-size: 14px; display: block; margin-bottom: 2px;">{{ 'sentence.evolution_real_time'|trans({}, 'common', locale) }}</strong>
                                <span style="color: #8b9bb4; font-size: 13px;">{{ 'sentence.see_datas'|trans({}, 'common', locale) }}</span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr>
                <td style="padding: 8px 0;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td width="30" valign="top">
                                <span style="font-size: 18px;">🔥</span>
                            </td>
                            <td style="padding-left: 10px;">
                                <span style="color: #8b9bb4; font-size: 13px;">{{ 'sentence.maintain_regularity'|trans({}, 'common', locale) }}</span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr>
                <td style="padding: 8px 0;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td width="30" valign="top">
                                <span style="font-size: 18px;">💪</span>
                            </td>
                            <td style="padding-left: 10px;">
                                <strong style="color: #f0f4ff; font-size: 14px; display: block; margin-bottom: 2px;">{{ 'sentence.outline_muscle'|trans({}, 'common', locale) }}</strong>
                                <span style="color: #8b9bb4; font-size: 13px;">{{ 'sentence.see_working_muscles'|trans({}, 'common', locale) }}</span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>

    <div style="background-color: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 12px; padding: 16px; text-align: center;">
        <p style="margin: 0; font-size: 13px; color: #fbbf24; font-weight: 600;">
            💡 {{ 'sentence.advice'|trans({}, 'common', locale) }}
        </p>
    </div>
{% endblock %}

{% block footer %}
    <p style="margin: 0 0 8px; font-size: 12px; color: #475569;">
        {{ 'registration.email.receive_email'|trans({'brand': brand_name}, 'navigation', locale) }}
    </p>
    <p style="margin: 0; font-size: 12px; color: #475569;">
        {{ 'footer.copyright'|trans({'year': "now"|date("Y"), 'brand': brand_name}, 'navigation', locale) }}
    </p>
{% endblock %}

{% block below_card %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin-top: 20px;">
        <tr>
            <td style="text-align: center; padding: 0 20px;">
                <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #475569;">
                    {{ 'sentence.ready_to_start'|trans({}, 'common', locale) }}
                </p>
            </td>
        </tr>
    </table>
{% endblock %}
