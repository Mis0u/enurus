<section class="min-w-0 bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6">
    <div class="flex items-center gap-2.5 mb-6">
        <div class="w-8.5 h-8.5 rounded-lg bg-[rgba(244,63,94,0.15)] border border-[rgba(244,63,94,0.3)] flex items-center justify-center shrink-0">
            {% include 'partials/_svg/_profile.html.twig' with {'width': 4.5, 'height': 4.5, 'extraClass': 'text-[#f43f5e]'} only %}
        </div>
        <div>
            <h2 class="font-['Rajdhani'] text-lg font-bold text-[#f0f4ff]">{{ 'settings.profile.title'|trans({}, 'navigation') }}</h2>
            <p class="text-xs text-[#4a5568]">{{ 'settings.profile.subtitle'|trans({}, 'navigation') }}</p>
        </div>
    </div>

    {% include 'settings/_fields/_avatar.html.twig' with {
        user: user,
        avatarMaxSizeBytes: avatarMaxSizeBytes,
        avatarAllowedMimeTypes: avatarAllowedMimeTypes,
    } only %}
    {% include 'settings/_fields/_email.html.twig' with {user: user} only %}
    {% include 'settings/_fields/_nickname.html.twig' with {
        user: user,
        nicknameMinLength: nicknameMinLength,
        nicknameMaxLength: nicknameMaxLength,
    } only %}
    {% include 'settings/_fields/_gender.html.twig' with {user: user} only %}
    {% include 'settings/_fields/_language.html.twig' with {user: user} only %}
    {% include 'settings/_fields/_weight_unit.html.twig' with {user: user} only %}
</section>
