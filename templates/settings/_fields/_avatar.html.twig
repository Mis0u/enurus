<div class="flex flex-col sm:flex-row sm:items-center gap-5 pb-6 mb-6 border-b border-white/[0.07]"
     data-controller="settings--avatar"
     data-settings--avatar-upload-url-value="{{ path('app_settings_avatar_upload') }}"
     data-settings--avatar-delete-url-value="{{ path('app_settings_avatar_delete') }}"
     data-settings--avatar-delete-csrf-token-value="{{ csrf_token('settings_avatar_delete') }}"
     data-settings--avatar-max-size-value="{{ avatarMaxSizeBytes }}"
     data-settings--avatar-allowed-types-value="{{ avatarAllowedMimeTypes|json_encode }}"
     data-settings--avatar-too-large-error-value="{{ 'settings.avatar.too_large'|trans({'{{ limit }}': (avatarMaxSizeBytes / 1024 / 1024)|round}, 'validators') }}"
     data-settings--avatar-invalid-type-error-value="{{ 'settings.avatar.invalid_type'|trans({}, 'validators') }}"
>

    <div class="relative w-23 h-23 rounded-full bg-gradient-to-br from-[#f43f5e] to-[#06b6d4] border-[3px] border-[rgba(244,63,94,0.4)] flex items-center justify-center shrink-0 overflow-hidden">
        <span data-settings--avatar-target="initials"
              class="font-['Rajdhani'] font-bold text-2xl text-white {% if user.avatarPath %}hidden{% endif %}">
            {{ user.nickname|formatInitials }}
        </span>
        <img data-settings--avatar-target="image"
             src="{% if user.avatarPath %}/uploads/{{ user.avatarPath }}{% endif %}"
             alt=""
             class="w-full h-full object-cover {% if not user.avatarPath %}hidden{% endif %}">
        <div data-settings--avatar-target="spinner"
             class="hidden absolute inset-0 bg-[rgba(8,14,26,0.75)] items-center justify-center">
            <div class="w-6 h-6 border-[3px] border-white/20 border-t-white rounded-full animate-spin"></div>
        </div>
    </div>

    <div class="flex flex-col gap-2.5 flex-1">
        <div class="flex flex-wrap gap-2.5">
            <label for="avatarInput"
                   class="inline-flex items-center gap-1.5 px-4 py-2.5 min-h-11 rounded-lg bg-white/[0.05] border border-white/[0.07] text-sm font-medium text-[#f0f4ff] cursor-pointer hover:bg-white/[0.08] transition-colors">
                {% include 'partials/_svg/_upload.html.twig' with {'weight': 3.5, 'height': 3.5, 'color': false, 'center': false} only %}
                {{ 'settings.avatar.change'|trans({}, 'navigation') }}
            </label>
            <input type="file"
                   id="avatarInput"
                   accept="image/jpeg,image/png,image/webp"
                   class="hidden"
                   data-settings--avatar-target="input"
                   data-action="change->settings--avatar#upload">

            <button type="button"
                    data-settings--avatar-target="removeButton"
                    data-action="click->settings--avatar#remove"
                    class="{% if not user.avatarPath %}hidden!{% endif %} cursor-pointer inline-flex items-center gap-1.5 px-4 py-2.5 min-h-11 rounded-lg border border-white/[0.07] text-sm font-medium text-[#4a5568] hover:text-[#f43f5e] hover:border-[rgba(244,63,94,0.3)] hover:bg-[rgba(244,63,94,0.15)] transition-colors">
                        {% include 'partials/_svg/_trash.html.twig' with {'width': 3.5, 'height': 3.5} only %}
                {{ 'field.form.button.delete'|trans({}, 'common') }}
            </button>
        </div>

        <p class="text-[11px] text-[#4a5568]">{{ 'settings.avatar.hint'|trans({}, 'navigation') }}</p>

        <div data-settings--avatar-target="error"
             class="hidden items-center gap-1.5 text-xs text-[#f43f5e] bg-[rgba(244,63,94,0.15)] border border-[rgba(244,63,94,0.3)] rounded-lg px-2.5 py-1.5">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.007v.008H12v-.008zM21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span data-settings--avatar-target="errorText"></span>
        </div>
    </div>
</div>
