{% set male = enum('App\\Enum\\Entity\\User\\GenderEnum').MALE.value %}
{% set female = enum('App\\Enum\\Entity\\User\\GenderEnum').FEMALE.value %}
<div class="mb-4.5"
     data-controller="settings--select-field"
     data-settings--select-field-url-value="{{ path('app_settings_gender_update') }}"
     data-settings--select-field-csrf-token-value="{{ csrf_token('settings_gender') }}"
     data-settings--select-field-param-name-value="gender"
     data-settings--select-field-success-message-value="{{ 'settings.feedback.success'|trans({}, 'navigation') }}">
    <label for="fieldGender" class="block font-['Rajdhani'] text-xs font-semibold uppercase tracking-wide text-[#4a5568] mb-2">
        {{ 'settings.gender.label'|trans({}, 'navigation') }}
    </label>
    <div class="relative">
        <select id="fieldGender"
                data-settings--select-field-target="select"
                data-action="change->settings--select-field#save"
                class="w-full appearance-none min-h-11 px-3.5 pr-10 py-3 rounded-lg bg-[#080e1a] border border-white/[0.07] text-[#f0f4ff] text-sm outline-none cursor-pointer focus:border-[rgba(244,63,94,0.5)] focus:ring-4 focus:ring-[rgba(244,63,94,0.08)] transition-colors">
            <option value="male" {% if user.gender.value == male %}selected{% endif %}>{{ 'field.gender.male'|trans({}, 'common') }}</option>
            <option value="female" {% if user.gender.value == female %}selected{% endif %}>{{ 'field.gender.female'|trans({}, 'common') }}</option>
        </select>
        <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8b9bb4] pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
    </div>
</div>
