{#
    Variables attendues (via `only`) :
    - isDiscoverable : bool
    - shareCode : string|null
    - nickname : string
#}
<section id="profile-sharing"
         class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6"
         data-controller="settings--profile-sharing"
         data-settings--profile-sharing-url-value="{{ path('app_settings_profile_sharing_update') }}"
         data-settings--profile-sharing-csrf-token-value="{{ csrf_token('settings_profile_sharing') }}"
         data-settings--profile-sharing-enable-message-value="{{ 'settings.profile_sharing.feedback.enabled'|trans({}, 'navigation') }}"
         data-settings--profile-sharing-disable-message-value="{{ 'settings.profile_sharing.feedback.disabled'|trans({}, 'navigation') }}"
         data-settings--profile-sharing-regenerate-message-value="{{ 'settings.profile_sharing.feedback.regenerated'|trans({}, 'navigation') }}"
         data-settings--profile-sharing-copy-message-value="{{ 'settings.profile_sharing.feedback.copied'|trans({}, 'navigation') }}">

    <h2 class="font-['Rajdhani'] text-lg font-bold text-[#f0f4ff] mb-1">
        {{ 'settings.profile_sharing.title'|trans({}, 'navigation') }}
    </h2>
    <p class="text-sm text-[#8b9bb4] mb-5 leading-relaxed">
        {{ 'settings.profile_sharing.explanation'|trans({}, 'navigation') }}
    </p>

    <label class="flex items-center justify-between gap-3 cursor-pointer">
        <span class="text-sm text-[#f0f4ff]">{{ 'settings.profile_sharing.switch_label'|trans({}, 'navigation') }}</span>
        <input type="checkbox"
               class="h-5 w-5 rounded border-white/[0.15] bg-transparent text-rose-ft accent-rose-ft cursor-pointer"
               {% if isDiscoverable %}checked{% endif %}
               data-action="change->settings--profile-sharing#toggle">
    </label>

    <div data-settings--profile-sharing-target="codeWrapper" {% if not isDiscoverable %}hidden{% endif %} class="mt-4 flex items-center justify-between gap-3 flex-wrap">
        <p class="text-sm text-[#8b9bb4]">
            {{ 'settings.profile_sharing.code_label'|trans({}, 'navigation') }}
            <span class="font-mono text-[#f0f4ff]">{{ nickname }}#<span data-settings--profile-sharing-target="code">{{ shareCode }}</span></span>
        </p>
        <div class="flex items-center gap-2">
            <button type="button"
                    class="px-3 py-1.5 rounded-[10px] text-[13px] font-semibold text-[#f0f4ff] bg-white/[0.06] hover:bg-white/[0.1] transition-ft"
                    data-action="settings--profile-sharing#copy">
                {{ 'settings.profile_sharing.copy'|trans({}, 'navigation') }}
            </button>
            <button type="button"
                    class="px-3 py-1.5 rounded-[10px] text-[13px] font-semibold text-[#f0f4ff] bg-white/[0.06] hover:bg-white/[0.1] transition-ft"
                    data-action="settings--profile-sharing#regenerate">
                {{ 'settings.profile_sharing.regenerate'|trans({}, 'navigation') }}
            </button>
        </div>
    </div>
</section>
