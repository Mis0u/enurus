<section id="mot-de-passe" class="h-full bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6">
    <div class="flex items-center gap-2.5 mb-6">
        <div class="w-8.5 h-8.5 rounded-lg bg-[rgba(244,63,94,0.15)] border border-[rgba(244,63,94,0.3)] flex items-center justify-center shrink-0">
            <svg class="w-4.5 h-4.5 text-[#f43f5e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 11-12 0 6 6 0 0112 0zM12 15v3m0 0h-1m1 0h1"></path>
            </svg>
        </div>
        <h2 class="font-['Rajdhani'] text-lg font-bold text-[#f0f4ff]">{{ 'settings.password.title'|trans({}, 'navigation') }}</h2>
    </div>

    {{ form_start(passwordForm, {render_rest: false}) }}
    {{ form_row(passwordForm.currentPassword) }}
    {{ form_row(passwordForm.plainPassword.first) }}
    {{ form_row(passwordForm.plainPassword.second) }}
    {{ form_row(passwordForm._token) }}

    {% include 'partials/_common/_security/_password_strength_indicator.html.twig' only %}

    <twig:Button:Primary:Primary
        type="submit"
        message="{{ 'settings.password.edit_password'|trans({}, 'navigation') }}"
        :disabled="true"
        data="data-password-validator-target=submitButton data-settings--password-submit-target=submitButton"
        extraClass="mt-4 min-h-11"
    />
    {{ form_end(passwordForm, {render_rest: false}) }}
</section>
