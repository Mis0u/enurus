{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4 py-12">
        <div class="max-w-md w-full">

            <div class="text-center mb-8">
                {% include 'partials/_common/logo.html.twig' only %}
            </div>

            <div class="backdrop-blur-xl bg-white/10 rounded-3xl shadow-2xl border border-white/20 p-8 text-center">
                <p class="font-rajdhani text-7xl font-bold text-white mb-4">{{ statusCode }}</p>

                <h2 class="text-2xl font-bold text-white mb-4">
                    {{ ('error.' ~ statusCode ~ '.title')|trans({}, 'errors', locale) }}
                </h2>

                <p class="text-slate-400 mb-8">
                    {{ ('error.' ~ statusCode ~ '.message')|trans({}, 'errors', locale) }}
                </p>

                {% if app.user %}
                    <a
                        href="{{ path('app_dashboard', {'_locale': locale}) }}"
                        class="inline-block w-full py-3.5 px-4 bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white font-bold rounded-xl shadow-lg shadow-rose-500/30 hover:shadow-rose-500/50 transition-all duration-200 hover:scale-[1.02] no-underline"
                    >
                        {{ 'cta.dashboard'|trans({}, 'errors', locale) }}
                    </a>
                {% else %}
                    <a
                        href="{{ path('app_login', {'_locale': locale}) }}"
                        class="inline-block w-full py-3.5 px-4 bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white font-bold rounded-xl shadow-lg shadow-rose-500/30 hover:shadow-rose-500/50 transition-all duration-200 hover:scale-[1.02] no-underline"
                    >
                        {{ 'cta.home'|trans({}, 'errors', locale) }}
                    </a>
                {% endif %}
            </div>

            {% include 'partials/_common/_footer.html.twig' with {
                locale: locale,
            } only %}
        </div>
    </div>
{% endblock %}
