{#
    Calendrier d'un objectif de régularité, une case par période : jours alignés sur la semaine
    (lundi → dimanche) pour un rythme quotidien, une case « S1 · 2/3 » par semaine sinon.
    Variable attendue (via `only`) :
    - progress : RegularityGoalProgress
#}
{% set is_daily = progress.goal.period.value == 'day' %}
{% set status_classes = {
    met: 'bg-rose-ft text-white',
    missed: 'bg-white/[0.03] border border-rose-ft/40 text-rose-ft/70',
    in_progress: 'bg-rose-ft/[0.12] border-2 border-rose-ft text-rose-ft',
    upcoming: 'bg-white/[0.03] border border-white/[0.07] text-[#4a5568]',
} %}

<ul class="{{ is_daily ? 'grid grid-cols-7 gap-1.5' : 'flex flex-wrap gap-2' }}"
    aria-label="{{ 'regularity_goal.calendar_label'|trans({}, 'navigation') }}">
    {% for period in progress.periods %}
        {% set status_label = ('regularity_goal.status.' ~ period.status.value)|trans({}, 'navigation') %}
        {# Rythme quotidien : le 1er jour démarre dans la colonne de son jour de semaine (lundi = 1).
           Style inline : une classe Tailwind construite dynamiquement ne serait jamais générée. #}
        <li {% if is_daily and loop.first %}style="grid-column-start: {{ period.start|date('N') }}"{% endif %}
            class="{{ is_daily ? 'aspect-square' : 'min-w-[56px] px-2 py-2' }} rounded-[9px] flex flex-col items-center justify-center text-[12px] font-semibold leading-tight {{ status_classes[period.status.value] }}"
            title="{{ 'regularity_goal.period_title'|trans({
                date: period.start|format_date('medium', locale=app.request.locale),
                sessions: period.sessionCount,
                target: progress.goal.sessionsPerPeriod,
                status: status_label,
            }, 'navigation') }}">
            {% if is_daily %}
                <span aria-hidden="true">{{ period.start|date('j') }}</span>
            {% else %}
                <span aria-hidden="true">{{ 'regularity_goal.week_label'|trans({number: loop.index}, 'navigation') }}</span>
                <span aria-hidden="true" class="text-[11px] font-medium opacity-80">{{ period.sessionCount }}/{{ progress.goal.sessionsPerPeriod }}</span>
            {% endif %}
            <span class="sr-only">
                {{ 'regularity_goal.period_title'|trans({
                    date: period.start|format_date('medium', locale=app.request.locale),
                    sessions: period.sessionCount,
                    target: progress.goal.sessionsPerPeriod,
                    status: status_label,
                }, 'navigation') }}
            </span>
        </li>
    {% endfor %}
</ul>

<div class="flex items-center gap-3 mt-3 text-[10.5px] text-[#4a5568] flex-wrap" aria-hidden="true">
    {% for status in ['met', 'missed', 'in_progress'] %}
        <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-[3px] {{ status_classes[status] }}"></span>
            {{ ('regularity_goal.status.' ~ status)|trans({}, 'navigation') }}
        </span>
    {% endfor %}
</div>
