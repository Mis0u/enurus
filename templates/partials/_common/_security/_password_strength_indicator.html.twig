<div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
    <p class="text-xs font-semibold text-slate-300 mb-2">{{ 'field.criteria_password'|trans({}, 'common') }}</p>
    <ul class="space-y-1 text-xs">
        {% if app.request.attributes.get('_route') != 'app_register' %}
            <li class="flex items-center text-slate-400" data-password-validator-target="identicalPasswordRule">
                {% include 'partials/_svg/_check_mark.html.twig' %}
                {{ 'reset_password_request.identical_password'|trans({}, 'navigation') }}
            </li>
        {% endif %}
        <li class="flex items-center text-slate-400" data-password-validator-target="minLengthRule">
            {% include 'partials/_svg/_check_mark.html.twig' %}
            {{ 'sentence.password.security.criteria_min_char'|trans({'min': enum('App\\Enum\\Password\\PasswordRuleEnum').('MIN_LENGTH').value}, 'common') }}
        </li>
        <li class="flex items-center text-slate-400" data-password-validator-target="upperLowerRule">
            {% include 'partials/_svg/_check_mark.html.twig' %}
            {{ 'sentence.password.security.upper_lower'|trans({}, 'common') }}
        </li>
        <li class="flex items-center text-slate-400" data-password-validator-target="numberRule">
            {% include 'partials/_svg/_check_mark.html.twig' %}
            {{ 'sentence.password.security.at_least_number'|trans({}, 'common') }}
        </li>
        <li class="flex items-center text-slate-400" data-password-validator-target="specialCharRule">
            {% include 'partials/_svg/_check_mark.html.twig' %}
            {{ 'sentence.password.security.special_char'|trans({}, 'common') }}
        </li>
    </ul>
</div>
