{#
    Bandeau portant le seuil du palier. Texte blanc cerné de sombre (`paint-order: stroke`) :
    lisible sur tous les métaux, du bronze clair au rubis foncé.
    Variables attendues (toutes via `only`) :
    - fill      : string — paint SVG du métal (`url(#badge-metal-N)`)
    - text      : string — déjà traduit
    - withTails : bool — queues repliées à partir de l'argent
#}
{% set outline = '#070c18' %}
{% if withTails %}
    <path d="M14 99 L-6 99 L1 107.5 L-6 116 L14 116 Z" fill="{{ fill }}" stroke="{{ outline }}" stroke-width="2.2" stroke-linejoin="round"/>
    <path d="M106 99 L126 99 L119 107.5 L126 116 L106 116 Z" fill="{{ fill }}" stroke="{{ outline }}" stroke-width="2.2" stroke-linejoin="round"/>
    <path d="M14 99 L14 116 L8 111 Z M106 99 L106 116 L112 111 Z" fill="{{ outline }}" fill-opacity=".45"/>
{% endif %}
<rect x="8" y="93" width="104" height="19" rx="3" fill="{{ fill }}" stroke="{{ outline }}" stroke-width="2.5"/>
<path d="M12 96.5 H108" stroke="#fff" stroke-opacity=".45" stroke-width="1.5" stroke-linecap="round"/>
<text class="badge-svg__ribbon-text"
      x="60" y="107.6"
      text-anchor="middle"
      font-size="{{ text|length > 7 ? 12 : 14.5 }}"
      fill="#fff" stroke="{{ outline }}" stroke-width="2.4" paint-order="stroke">{{ text }}</text>
