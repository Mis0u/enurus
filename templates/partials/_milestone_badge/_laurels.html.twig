{#
    Branches de laurier (à partir du platine), côté gauche puis miroir à droite. Coordonnées
    précalculées le long d'une courbe de Bézier : aucun calcul au rendu.
    Variable attendue (via `only`) : fill — paint SVG (métal du palier ou holographique)
#}
{% set leaves %}
    <ellipse cx="-2.3" cy="52.4" rx="7" ry="3" transform="rotate(50.6 -2.3 52.4) translate(-4 0)"/>
    <ellipse cx="-2.3" cy="52.4" rx="7" ry="3" transform="rotate(130.6 -2.3 52.4) translate(4 0)"/>
    <ellipse cx="-1.4" cy="70.6" rx="7" ry="3" transform="rotate(43.7 -1.4 70.6) translate(-4 0)"/>
    <ellipse cx="-1.4" cy="70.6" rx="7" ry="3" transform="rotate(123.7 -1.4 70.6) translate(4 0)"/>
    <ellipse cx="1.5" cy="86.7" rx="7" ry="3" transform="rotate(35 1.5 86.7) translate(-4 0)"/>
    <ellipse cx="1.5" cy="86.7" rx="7" ry="3" transform="rotate(115 1.5 86.7) translate(4 0)"/>
    <ellipse cx="6.6" cy="100.7" rx="7" ry="3" transform="rotate(24.6 6.6 100.7) translate(-4 0)"/>
    <ellipse cx="6.6" cy="100.7" rx="7" ry="3" transform="rotate(104.6 6.6 100.7) translate(4 0)"/>
    <ellipse cx="13.8" cy="112.5" rx="7" ry="3" transform="rotate(12.6 13.8 112.5) translate(-4 0)"/>
    <ellipse cx="13.8" cy="112.5" rx="7" ry="3" transform="rotate(92.6 13.8 112.5) translate(4 0)"/>
    <ellipse cx="23.1" cy="122.2" rx="7" ry="3" transform="rotate(-0.1 23.1 122.2) translate(-4 0)"/>
    <ellipse cx="23.1" cy="122.2" rx="7" ry="3" transform="rotate(79.9 23.1 122.2) translate(4 0)"/>
    <ellipse cx="34.5" cy="129.9" rx="7" ry="3" transform="rotate(-12.3 34.5 129.9) translate(-4 0)"/>
    <ellipse cx="34.5" cy="129.9" rx="7" ry="3" transform="rotate(67.7 34.5 129.9) translate(4 0)"/>
{% endset %}
<g fill="{{ fill }}" stroke="#070c18" stroke-width="1.2">
    <g>{{ leaves }}</g>
    <g transform="translate(120 0) scale(-1 1)">{{ leaves }}</g>
</g>
