{#
    templates/workout/show/_share_preview_modal.html.twig

    Modale d'aperçu de l'image générée par assets/controllers/workout/share_controller.js —
    cachée par défaut (classe "hidden" retirée en JS une fois l'image capturée).
#}
<div
    class="hidden fixed inset-0 bg-[rgba(8,14,26,0.92)] backdrop-blur-sm z-[200] items-center justify-center animate-[fadeIn_0.2s_ease]"
    data-workout--share-target="modal"
    data-action="click->workout--share#closePreview"
>
    <div
        class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6 shadow-[0_20px_60px_rgba(0,0,0,0.5)] animate-[slideUp_0.3s_cubic-bezier(0.34,1.56,0.64,1)] flex flex-col items-center gap-5 max-md:h-screen max-md:rounded-none max-md:justify-center"
        data-action="click->workout--share#stopPropagation"
    >
        <button
            type="button"
            class="self-end -mt-2 -mr-2 text-[#8b9bb4] hover:text-[#f0f4ff] cursor-pointer"
            data-action="click->workout--share#closePreview"
        >
            {% include 'partials/_svg/_cross.html.twig' with {'width': 5, 'height': 5} only %}
        </button>

        <img
            data-workout--share-target="previewImage"
            alt="{{ 'workout.show.share.button'|trans({}, 'navigation') }}"
            class="max-h-[65vh] max-w-full rounded-xl border border-white/[0.07] object-contain"
        >

        <p class="text-[13px] text-[#8b9bb4]" data-workout--share-target="caption">
            {{ 'workout.show.share.caption'|trans({}, 'navigation') }}
        </p>

        <div class="flex items-center gap-3 w-full">
            <button
                type="button"
                class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-white/[0.07] bg-white/[0.04] text-[13.5px] font-medium cursor-pointer hover:bg-white/[0.08] transition-colors"
                data-action="click->workout--share#downloadFromPreview"
            >
                {% include 'partials/_svg/_download.html.twig' with {'width': 3.5, 'height': 3.5} only %}
                {{ 'workout.show.share.download_button'|trans({}, 'navigation') }}
            </button>
            <button
                type="button"
                class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-[13.5px] font-semibold text-white bg-gradient-to-br from-rose-ft to-red-600 shadow-[0_4px_15px_rgba(244,63,94,0.3)] cursor-pointer hover:shadow-[0_6px_22px_rgba(244,63,94,0.5)] transition-all"
                data-workout--share-target="shareButton"
                data-action="click->workout--share#shareFromPreview"
            >
                {% include 'partials/_svg/_share.html.twig' with {'width': 3.5, 'height': 3.5} only %}
                {{ 'workout.show.share.button'|trans({}, 'navigation') }}
            </button>
        </div>
    </div>
</div>
