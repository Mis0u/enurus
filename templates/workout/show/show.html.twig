{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/workout_show.css') }}">
{% endblock %}

{% block title %}{{ 'workout.show.title'|trans({}, 'navigation')|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {
        'title': workout.routine is not null ? workout.routine.name : 'workout.list.free_session'|trans({}, 'navigation'),
        'subtitle': user.nickname|formatInitials,
    } only %}
{% endblock %}

{% block state %}
    <div
        class="flex-1 relative overflow-y-auto overflow-x-hidden px-7 pb-[120px] max-md:px-4 max-md:pb-[160px]"
        data-controller="workout--share"
        data-workout--share-download-success-value="{{ 'workout.show.share.download_success'|trans({}, 'navigation') }}"
        data-workout--share-error-value="{{ 'workout.show.share.error'|trans({}, 'navigation') }}"
    >
        {% include 'workout/show/_secondary_nav.html.twig' with {
            'workout': workout,
            'totalTonnage': totalTonnage,
            'unit': unit,
        } only %}
        {% include 'workout/show/_share_card.html.twig' with {
            'workout': workout,
            'exerciseData': exerciseData,
            'totalTonnage': totalTonnage,
            'totalSets': totalSets,
            'totalReps': totalReps,
            'unit': unit,
            'user': user,
            'allPrimarySvgIds': allPrimarySvgIds,
            'allSecondarySvgIds': allSecondarySvgIds,
        } only %}
        {% include 'workout/show/_share_preview_modal.html.twig' only %}
        <div class="pt-6 max-md:pt-4">
            {% include 'workout/show/_header.html.twig' with {
                'workout': workout,
                'exerciseData': exerciseData,
                'totalTonnage': totalTonnage,
                'totalSets': totalSets,
                'totalReps': totalReps,
                'unit': unit,
            } only %}
            {% include 'workout/show/_muscles.html.twig' with {
                'user': user,
                'allPrimarySvgIds': allPrimarySvgIds,
                'allSecondarySvgIds': allSecondarySvgIds,
            } only %}
            {% include 'workout/show/_exercises_list.html.twig' with {
                'exerciseData': exerciseData,
                'unit': unit,
            } only %}
        </div>
    </div>
{% endblock %}
