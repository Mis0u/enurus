<div class="flex-1 min-w-0">
    {# Mobile : numéro sur la ligne du nom #}
    <div class="show-position-badge inline-block font-['Rajdhani'] text-sm font-bold px-2.5 py-1 rounded-md mb-2 max-md:mb-0 max-md:mr-1.5 max-md:px-2 max-md:py-0.5 max-md:text-xs max-md:align-middle">
        {{ position < 10 ? '0' ~ position : position }}
    </div>

    <h4 class="font-['Rajdhani'] text-[20px] font-bold text-[var(--text-primary)] mb-2 max-md:inline max-md:text-[17px] max-md:align-middle">
        {{ exercise.name|trans({}, 'exercise') }}
        {% if exercise.archived %}
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10.5px] font-medium bg-white/[0.06] border border-white/[0.15] text-slate-400 align-middle ml-1">
                {{ 'exercise.list.badge.archived'|trans({}, 'navigation') }}
            </span>
        {% endif %}
        {% if exercise.bodyweightPercent is not null %}
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10.5px] font-medium bg-[rgba(244,63,94,0.1)] border border-[rgba(244,63,94,0.3)] text-[#f43f5e] align-middle ml-1">
                {{ 'exercise.bodyweight_badge'|trans({percent: exercise.bodyweightPercent|number_format(0)}, 'navigation') }}
            </span>
        {% endif %}
    </h4>

    {# Desktop : pastilles. Mobile : ligne de texte, principaux en rose, secondaires en cyan. #}
    {% set primary_muscles = item.muscles|filter(em => em.type.value == enum('App\\Enum\\Entity\\ExerciceMuscle\\MuscleTypeEnum').PRIMARY.value)|map(em => em.muscleGroup.name|trans({}, 'muscle')) %}
    {% set secondary_muscles = item.muscles|filter(em => em.type.value != enum('App\\Enum\\Entity\\ExerciceMuscle\\MuscleTypeEnum').PRIMARY.value)|map(em => em.muscleGroup.name|trans({}, 'muscle')) %}
    <p class="md:hidden mt-1 text-[12px] leading-snug">
        <span class="show-exercise-muscles__primary text-rose-400">{{ primary_muscles|join(', ') }}</span>
        {%- if secondary_muscles is not empty -%}
            <span class="text-slate-500" aria-hidden="true"> · </span><span class="show-exercise-muscles__secondary text-cyan-400">{{ secondary_muscles|join(', ') }}</span>
        {%- endif -%}
    </p>
    <div class="max-md:hidden flex flex-wrap gap-1.5">
        {% for em in item.muscles %}
            <span class="{{ em.type.value == enum('App\\Enum\\Entity\\ExerciceMuscle\\MuscleTypeEnum').PRIMARY.value ? 'show-muscle-tag-primary' : 'show-muscle-tag-secondary' }} px-2 py-0.5 rounded-md text-[10.5px] border">
                        {{ em.muscleGroup.name|trans({}, 'muscle') }}
                    </span>
        {% endfor %}
    </div>
</div>

<div class="text-right shrink-0">
    <div class="show-exercise-tonnage-value font-['Rajdhani'] text-[18px] font-bold">
        {{ item.tonnage|number_format(0, ',', ' ') }} {{ unit.value }}
    </div>
    <div class="show-exercise-tonnage-label text-[10px]">
        {{ 'workout.show.metrics.tonnage'|trans({}, 'navigation') }}
    </div>

    {% if exercise.measurementType.value == 'time' %}
        <div class="show-exercise-tonnage-value font-['Rajdhani'] text-[18px] font-bold mt-1.5">
            {{ item.totalDuration|format_set_duration }}
        </div>
        <div class="show-exercise-tonnage-label text-[10px]">
            {{ 'workout.show.metrics.duration'|trans({}, 'navigation') }}
        </div>
    {% elseif exercise.measurementType.value == 'distance' %}
        <div class="show-exercise-tonnage-value font-['Rajdhani'] text-[18px] font-bold mt-1.5">
            {{ item.totalDistance }} {{ 'workout.series_distance_abbreviate'|trans({}, 'navigation') }}
        </div>
        <div class="show-exercise-tonnage-label text-[10px]">
            {{ 'workout.show.metrics.distance'|trans({}, 'navigation') }}
        </div>
    {% endif %}
</div>
