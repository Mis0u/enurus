{% set we = item.workoutExercise %}
{% set exercise = we.exercise %}

<div class="show-exercise-card border border-white/[0.07] rounded-[14px] p-5 max-md:p-4"
     style="animation: fadeUp 0.3s ease both; animation-delay: {{ (position * 0.03 + 0.02)|round(2) }}s;"> {# STYLE À LAISSER CAR DYNAMIQUE #}

    <div class="flex items-start justify-between gap-4 mb-4 max-md:flex-col max-md:gap-3">
        {% include 'workout/show/card/_header.html.twig' with {
            'exercise': exercise,
            'item': item,
            'position': position,
            'unit': unit,
        } only %}
    </div>

    <table class="w-full border-collapse">
        <thead>
        <tr>
            <th class="show-table-th text-left text-[11px] font-semibold uppercase px-3 py-2.5">#</th>
            <th class="show-table-th text-left text-[11px] font-semibold uppercase px-3 py-2.5">{{ 'workout.show.sets_table.weight'|trans({}, 'navigation') }}</th>
            <th class="show-table-th text-left text-[11px] font-semibold uppercase px-3 py-2.5">
                {{ (exercise.measurementType.value == 'time' ? 'workout.show.sets_table.duration' : 'workout.show.sets_table.reps')|trans({}, 'navigation') }}
            </th>
            <th class="show-table-th text-left text-[11px] font-semibold uppercase px-3 py-2.5 max-md:hidden">{{ 'workout.show.sets_table.tonnage'|trans({}, 'navigation') }}</th>
            <th class="show-table-th text-right text-[11px] font-semibold uppercase px-3 py-2.5"></th>
        </tr>
        </thead>
        <tbody>
        {% for set in item.sets %}
            <tr class="show-table-row">
                <td class="show-table-td-muted px-3 py-2.5 text-[12px]">{{ set.position + 1 }}</td>
                <td class="show-table-td-value px-3 py-2.5 font-['Rajdhani'] text-[15px] font-semibold">{{ set.weightFormatted }}</td>
                <td class="show-table-td-value px-3 py-2.5 font-['Rajdhani'] text-[15px] font-semibold">
                    {% if set.isTimeBased %}
                        {{ set.duration|format_set_duration }}
                    {% else %}
                        × {{ set.reps }}
                    {% endif %}
                </td>
                <td class="show-table-td-secondary px-3 py-2.5 font-['Rajdhani'] text-[15px] font-semibold max-md:hidden">{{ set.tonnage|number_format(0, ',', ' ') }} {{ unit.value }}</td>
                <td class="px-3 py-2.5 text-right">
                    {% if set.isPr %}
                        <span class="show-pr-badge relative inline-flex items-center gap-1 px-2 py-0.5 border rounded-md text-[11px] font-bold"
                              data-controller="tooltip"
                              data-tooltip-text-value="{{ 'dashboard.widget.session.pr_tooltip'|trans({}, 'navigation') }}"
                              data-action="click->tooltip#toggle"
                              title="{{ 'dashboard.widget.session.pr_tooltip'|trans({}, 'navigation') }}">
                                🏆 {{ 'workout.show.pr_badge'|trans({}, 'navigation') }}
                            </span>
                    {% elseif set.isRepsRecord %}
                        <span class="show-reps-record-badge relative inline-flex items-center gap-1 px-2 py-0.5 border rounded-md text-[11px] font-bold"
                              data-controller="tooltip"
                              data-tooltip-text-value="{{ 'dashboard.widget.session.reps_record_tooltip'|trans({}, 'navigation') }}"
                              data-action="click->tooltip#toggle"
                              title="{{ 'dashboard.widget.session.reps_record_tooltip'|trans({}, 'navigation') }}">
                                🔁 {{ 'dashboard.widget.session.reps_record_badge'|trans({}, 'navigation') }}
                            </span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

</div>
