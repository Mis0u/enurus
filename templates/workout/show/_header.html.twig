<div class="show-header-card relative border border-white/[0.07] rounded-2xl p-6 mb-5 overflow-hidden max-md:p-5">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(244,63,94,0.03),transparent_60%)] pointer-events-none"></div>

    {% include 'workout/show/header/_title.html.twig' with {'workout': workout} only %}

    <div class="grid grid-cols-5 gap-4 mb-5 max-md:grid-cols-2 max-md:gap-2.5">
        {% include 'workout/show/header/_tonnage.html.twig' with {'totalTonnage': totalTonnage, 'unit': unit} only %}
        {% include 'workout/show/header/_workout_duration.html.twig' with {'workout': workout} only %}
        {% include 'workout/show/header/_exercise_sets.html.twig' with {exerciseData: exerciseData, total_sets: totalSets, total_reps: totalReps} only %}
    </div>

    {% if workout.note is not null and workout.note != '' %}
        {% include 'workout/show/header/_note.html.twig' with {'workout': workout} only %}
    {% endif %}

    {% if workout.photoPath is not null %}
        {% include 'workout/show/header/_photo.html.twig' with {'workout': workout} only %}
    {% endif %}
</div>
{# La lightbox est intentionnellement hors du div principal (overflow-hidden) —
   un position:fixed dans un conteneur overflow:hidden est ignoré par le navigateur. #}
{% if workout.photoPath is not null %}
    {% include 'workout/show/header/_photo_lightbox.html.twig' with {'workout': workout} only %}
{% endif %}
