{#
    Variables attendues (toutes via `only`) :
    - workout, totalTonnage, unit
    - backUrl : string — destination du lien retour (propre liste ou liste d'une connexion)
    - readOnly : bool — masque le lien d'édition et bascule le libellé du lien retour
      ("ses séances" plutôt que "mes séances") quand vrai
#}
<div class="show-secondary-nav sticky top-0 z-[4] -mx-7 max-md:-mx-4 backdrop-blur-md border-b border-white/[0.07] px-7 py-3 max-md:px-4 flex items-center justify-between gap-4">
    <a href="{{ backUrl }}"
       class="show-back-btn inline-flex items-center gap-2 px-4 py-2 max-md:px-2.5 rounded-lg border text-sm font-medium">
        {% include 'partials/_svg/_inferior.html.twig' with{'width': 4, 'height': 4} only %}
        <span class="max-md:hidden">{{ (readOnly ? 'workout.show.back_shared' : 'workout.show.back')|trans({}, 'navigation') }}</span>
    </a>

    <div class="flex items-center gap-2 max-md:gap-1.5">
        <button
            type="button"
            class="show-back-btn inline-flex items-center gap-2 px-4 py-2 max-md:px-2.5 rounded-lg border text-sm font-medium cursor-pointer"
            data-action="click->workout--share#share"
            data-workout--share-target="button"
        >
            {% include 'partials/_svg/_share.html.twig' only %}
            <span class="max-md:hidden">{{ 'workout.show.share.button'|trans({}, 'navigation') }}</span>
        </button>
        {% if not readOnly %}
            <a href="{{ path('app_workout_edit', {'id': workout.id, '_locale': app.request.locale}) }}"
               class="show-back-btn inline-flex items-center gap-2 px-4 py-2 max-md:px-2.5 rounded-lg border text-sm font-medium">
                {% include 'partials/_svg/_pencil.html.twig' only %}
                <span class="max-md:hidden">{{ 'workout.list.edit'|trans({}, 'navigation') }}</span>
            </a>
        {% endif %}
        {% if workout.duration is not null %}
            <div class="show-chip-duration inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border max-md:px-2 max-md:text-[11px]">
                {% include 'partials/_svg/_time.html.twig' with{'width': 3.5, 'height': 3.5} only %}
                {{ workout.duration|format_hour }}
            </div>
        {% endif %}

        <div class="show-chip-tonnage inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border max-md:px-2 max-md:text-[11px]">
            {% include 'partials/_svg/_lightning.html.twig' only %}
            {{ totalTonnage|number_format(0, ',', ' ') }} {{ unit.value }}
        </div>
    </div>
</div>
