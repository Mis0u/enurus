{# Lightbox — hors du overflow-hidden pour fonctionner correctement en fixed #}
<div id="workout-photo-lightbox"
     onclick="this.classList.add('hidden'); this.classList.remove('flex')"
     class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm items-center justify-center p-4 cursor-pointer animate-[fadeIn_0.2s_ease] [&>img]:animate-[scaleIn_0.2s_ease]">
    <img src="{{ workout.photoPath|storage_url }}"
         alt="{{ 'workout.photo.alt'|trans({}, 'navigation') }}"
         class="max-w-full max-h-full object-contain rounded-xl">
</div>
