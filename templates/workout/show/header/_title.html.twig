<div class="flex items-start justify-between gap-5 mb-5 max-md:flex-col">
    <div class="flex-1">
        {% if workout.routine is not null %}
            <div class="show-routine-badge inline-flex items-center gap-1.5 px-2.5 py-1 border rounded-md text-[11px] font-semibold mb-2.5">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                {#TODO RECUPERER LE SVG, UNE FOIS LA ROUTINE CREE#}
                {{ 'workout.show.routine_badge'|trans({}, 'navigation') }}
            </div>
        {% endif %}

        <h2 class="font-['Rajdhani'] text-[28px] font-bold text-[var(--text-primary)] mb-1.5 max-md:text-[22px]">
            {{ workout.routine is not null ? workout.routine.name : 'workout.list.free_session'|trans({}, 'navigation') }}
        </h2>

        <p class="text-[13px] text-[var(--text-secondary)]">
            {{ workout.performedAt|format_date('full', locale=app.request.locale) }}
        </p>
    </div>
</div>
