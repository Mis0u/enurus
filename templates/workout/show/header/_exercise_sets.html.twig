<div class="show-metric-neutral flex flex-col gap-1 p-3.5 rounded-xl text-center border">
    <span class="metric-value font-['Rajdhoni'] text-[22px] font-bold">{{ exerciseData|length }}</span>
    <span class="metric-label text-[11px]">{{ 'workout.show.metrics.exercises'|trans({'count': exerciseData|length}, 'navigation') }}</span>
</div>

<div class="show-metric-neutral flex flex-col gap-1 p-3.5 rounded-xl text-center border">
    <span class="metric-value font-['Rajdhani'] text-[22px] font-bold">{{ total_sets }}</span>
    <span class="metric-label text-[11px]">{{ 'workout.show.metrics.sets'|trans({'count': total_sets}, 'navigation') }}</span>
</div>

<div class="show-metric-neutral flex flex-col gap-1 p-3.5 rounded-xl text-center border">
    <span class="metric-value font-['Rajdhani'] text-[22px] font-bold">{{ total_reps }}</span>
    <span class="metric-label text-[11px]">{{ 'workout.show.sets_table.reps'|trans({}, 'navigation') }}</span>
</div>
