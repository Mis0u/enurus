<template class="js-set-template">
    <tr data-set-index="__SET_INDEX__"
        class="border-b border-white/[0.04] last:border-0 bg-[rgba(255,255,255,0.02)] rounded-[8px] [&>td]:px-2 [&>td]:py-2.5">
        <td class="font-rajdhani font-semibold text-[#8b9bb4] text-[15px]">__SET_NUMBER__</td>
        <td>
            <input type="number"
                   name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][weight]"
                   step="0.5" placeholder="kg"
                   class="w-20 max-md:w-16 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
            <input type="hidden"
                   name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][position]"
                   value="__SET_INDEX__">
        </td>
        <td>
            <input type="number"
                   name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][reps]"
                   min="1" placeholder="reps"
                   class="w-20 max-md:w-16 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
        </td>
        <td class="text-center">
            <button type="button"
                    data-action="click->exercise#deleteSet"
                    class="text-[#4a5568] hover:text-[#f43f5e] transition-colors duration-250 text-[20px] leading-none flex items-center justify-center w-6 h-6">
                {% include 'partials/_svg/_red_cross.html.twig' %}
            </button>
        </td>
    </tr>
</template>
