<button
    type="button"
    data-action="click->workout--history--delete-modal#deleteWorkout"
    data-workout-id="{{ workout.id }}"
    data-title="{{ 'workout.history.delete.title'|trans({}, 'navigation') }}"
    data-message="{{ 'workout.history.delete.message'|trans({}, 'navigation') }}"
    data-confirm="{{ 'workout.history.delete.confirm'|trans({}, 'navigation') }}"
    data-cancel="{{ 'workout.history.delete.cancel'|trans({}, 'navigation') }}"
    data-delete-url="{{ path('app_workout_delete', {'id': workout.id, '_locale': app.request.locale}) }}"
    class="w-8 h-8 rounded-lg border border-white/[0.07] bg-white/[0.03] flex items-center justify-center text-[#8b9bb4] hover:bg-[rgba(244,63,94,0.15)] hover:border-[rgba(244,63,94,0.4)] hover:text-[#f43f5e] hover:scale-105 transition-all duration-250 cursor-pointer"
>
    {% include 'partials/_svg/_trash.html.twig' with{'width': 4, 'height': 4} %}
</button>
