<div class="session-tonnage flex items-center gap-4 text-[12px]">
    {% if tonnage is not null and tonnage > 0 %}
        <span class="flex items-center gap-1.5 text-[#8b9bb4]">
                    {% include 'partials/_svg/_lightning.html.twig' %}
                    <span class="font-semibold text-[#f0f4ff]">{{ tonnage|number_format(0, ',', ' ') }}</span>
                    {% if user.unitOfMeasure.value == enum('App\\Enum\\Entity\\User\\UnitOfMeasureEnum').LBS.value %}
                        {{ 'workout.history.lbs'|trans({}, 'navigation')|lower }}
                    {% else %}
                        {{ 'workout.history.kg'|trans({}, 'navigation')|lower }}
                    {% endif %}
                </span>
    {% endif %}
    <span class="flex items-center gap-1.5 text-[#8b9bb4]">
                {% include 'partials/_svg/_list.html.twig' %}
                <span class="font-semibold text-[#f0f4ff]">{{ exerciseCount }}</span>
                {{ 'workout.history.exercises'|trans({}, 'navigation') }}
            </span>
</div>
