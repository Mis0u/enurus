<div
    data-controller="workout--history--workout-filters"
    class="flex flex-wrap items-center gap-3 mb-6"
>
    {% include 'workout/history/Filter/_date_picker.html.twig' %}

    <div class="flex gap-1 bg-white/[0.04] rounded-lg p-0.75">

        {% include 'workout/history/Filter/_month_week.html.twig' %}

        {% if filterType is not null or (filterDate is not null and filterDate != '') %}
            {% include 'workout/history/Filter/_reset.html.twig' %}
        {% endif %}
    </div>

    <div class="ml-auto flex items-center gap-1.5 px-3 py-1.5 bg-[rgba(6,182,212,0.12)] border border-[rgba(6,182,212,0.25)] rounded-lg text-[12px] font-semibold text-[#06b6d4]">
        {% include 'workout/history/Filter/_total_count.html.twig' %}
    </div>
</div>
