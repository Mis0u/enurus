{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block title %}{{ 'workout.history.title'|trans({}, 'navigation')|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {'title': 'workout.history.title'|trans({}, 'navigation'), 'subtitle': user.nickname|formatInitials} %}
{% endblock %}

{% block state %}
    <div
        class="flex-1 relative overflow-y-auto overflow-x-hidden px-7 pt-6 pb-[120px] max-md:px-4 max-md:pb-[160px]"
        data-controller="workout--history--delete-modal"
    >
        {% include 'workout/history/_filters.html.twig' %}

        {% if pagination.getTotalItemCount() == 0 %}
            <div class="flex flex-col items-center justify-center py-20 gap-4">
                <div class="w-16 h-16 rounded-2xl bg-white/[0.04] border border-white/[0.07] flex items-center justify-center">
                    {% include 'partials/_svg/_calendar.html.twig' with {'width': '8', 'height': '8'} %}
                </div>
                <p class="font-rajdhani text-lg font-semibold text-[#8b9bb4]">
                    {{ 'workout.history.empty'|trans({}, 'navigation') }}
                </p>
            </div>
        {% else %}
            <div class="flex flex-col gap-2.5">
                {% for workout in pagination %}
                    {% include 'workout/history/_session_row.html.twig' with {
                        workout: workout,
                        tonnage: tonnageMap[workout.id] ?? null,
                        muscles: musclesMap[workout.id] ?? [],
                        hiddenCount: hiddenCountMap[workout.id] ?? 0,
                    } %}
                {% endfor %}
            </div>

            {% include 'workout/history/_pagination.html.twig' %}
        {% endif %}

    </div>
{% endblock %}
