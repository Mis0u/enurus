<div class="show-secondary-nav fixed top-[85px] left-[240px] right-0 max-md:left-0 max-md:top-[45px] z-[4] backdrop-blur-md border-b border-white/[0.07] px-7 py-3 max-md:px-4 flex items-center justify-between gap-4">
<a
    href="{{ path('app_workout_show', {'id': workout.id, '_locale': app.request.locale}) }}"
    class="inline-flex items-center gap-2 px-3.5 py-2 bg-transparent border border-white/[0.07] rounded-lg text-slate-400 text-[13px] font-medium hover:border-[rgba(244,63,94,0.4)] hover:text-[#f43f5e] transition-all"
    >
    {% include 'partials/_svg/_inferior.html.twig' with{'width': 4, 'height': 4} only %}
    {{ 'workout.edit.back'|trans({}, 'navigation') }}
    </a>

    <span class="font-rajdhani text-base font-bold text-slate-400 flex-1 text-center max-md:hidden">
        {{ workout.routine ? workout.routine.name : 'workout.type.free'|trans({}, 'navigation') }}
    </span>

    <div class="flex items-center gap-2 max-md:gap-1.5">
        {% if workout.duration is not null %}
            <div class="show-chip-duration inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border max-md:px-2 max-md:text-[11px]">
                {% include 'partials/_svg/_time.html.twig' with{'width': 3.5, 'height': 3.5} only %}
                {{ workout.duration|format_hour }}
            </div>
        {% endif %}
        <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-cyan-500/[0.12] border border-cyan-500/25 rounded-lg text-xs font-semibold text-[#06b6d4] max-md:text-[11px] max-md:px-2 max-md:py-1"
            data-workout-edit-tonnage
        >
            {% include 'partials/_svg/_lightning.html.twig' only %}
            {{ totalTonnage|number_format(0, '.', ' ') }} {{ unit.value }}
        </span>
    </div>

</div>
