<div
    data-controller="workout--edit--exercise"
    data-workout--edit--exercise-no-date-title-value="{{ 'workout.error.no_date.title'|trans({}, 'navigation') }}"
    data-workout--edit--exercise-no-date-text-value="{{ 'workout.error.no_date.text'|trans({}, 'navigation') }}"
    data-workout--edit--exercise-no-exercise-title-value="{{ 'workout.error.no_exercise.title'|trans({}, 'navigation') }}"
    data-workout--edit--exercise-no-exercise-text-value="{{ 'workout.error.no_exercise.text'|trans({}, 'navigation') }}"
    data-workout--edit--exercise-user-has-bodyweight-value="{{ app.user.bodyweightKg is not null ? 'true' : 'false' }}"
    data-workout--edit--exercise-bodyweight-required-message-value="{{ 'workout.search_exercise.bodyweight_required'|trans({}, 'navigation') }}"
    data-workout--edit--exercise-lifted-weight-template-value="{{ 'workout.series_bodyweight_lifted'|trans({weight: '__WEIGHT__ ' ~ app.user.unitOfMeasure.value}, 'navigation') }}"
>
    <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-2.5 mb-5">
            {% include 'partials/_svg/_filter.html.twig' only %}
            <h3 class="font-rajdhani text-xl font-bold text-[#f0f4ff]">
                {{ 'workout.edit.exercises_title'|trans({}, 'navigation') }}
            </h3>
        </div>
    </div>

    <div
        id="exercises-list"
        data-workout--edit--exercise-target="exerciseList"
    >
        {% for index, item in exerciseData %}
            {% include 'workout/create/_exercise_card.html.twig' with {
                'exercise': item.workoutExercise.exercise,
                'index': index,
                'controllerName': 'workout--edit--exercise',
                'existingSets': item.sets,
                'cardBodyweightShare': item.cardBodyweightShare,
            } only %}
        {% endfor %}
    </div>

</div>
