<div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6 mb-5 opacity-60 cursor-not-allowed">

    <div class="flex items-center gap-2.5 mb-4">
        {% include 'partials/_svg/_picture.html.twig' %}
        <h3 class="font-rajdhani text-lg font-bold text-slate-500">
            {{ 'workout.edit.photo_title'|trans({}, 'navigation') }}
        </h3>
    </div>

    <div class="border-2 border-dashed border-white/[0.1] rounded-xl py-10 px-5 text-center">
        {% include 'partials/_svg/_upload.html.twig' %}
        <p class="text-slate-400 text-sm font-medium mt-3">
            {{ 'workout.edit.photo_add'|trans({}, 'navigation') }}
        </p>
        <p class="text-slate-600 text-xs mt-1.5">
            {{ 'workout.edit.photo_constraints'|trans({}, 'navigation') }}
        </p>
        <button
            type="button"
            disabled
            class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 bg-[rgba(244,63,94,0.15)] border border-[rgba(244,63,94,0.4)] rounded-lg text-[#f43f5e] text-[13px] font-semibold opacity-40 cursor-not-allowed"
        >
            {{ 'workout.edit.photo_select'|trans({}, 'navigation') }}
        </button>
    </div>

</div>
