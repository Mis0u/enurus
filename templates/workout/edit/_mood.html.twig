<div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6 mb-5">

    <div class="flex items-center gap-2.5 mb-1.5">
        {% include 'partials/_svg/_lightning.html.twig' with {'width': 5, 'height': 5} only %}
        <h3 class="font-rajdhani text-lg font-bold text-[#f0f4ff]">
            {{ 'workout.mood.label'|trans({}, 'navigation') }}
        </h3>
    </div>

    <p class="text-[13px] text-slate-400 mb-3.5">
        {{ 'workout.mood.subtitle'|trans({}, 'navigation') }}
    </p>

    {% include 'workout/_mood_selector.html.twig' with {'field': form.mood, 'moods': moods} only %}
    {% do form.mood.setRendered %}

</div>
