<div class="relative group cursor-pointer mb-4 inline-block"
     onclick="document.getElementById('edit-photo-lightbox').classList.remove('hidden'); document.getElementById('edit-photo-lightbox').classList.add('flex')">
    <img src="{{ workout.photoPath|storage_url }}"
         alt="{{ 'workout.photo.alt'|trans({}, 'navigation') }}"
         class="max-h-48 w-auto rounded-xl border border-white/[0.07] transition-all duration-200 group-hover:brightness-90 block mx-auto">
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 rounded-xl">
        <span class="bg-black/60 text-white text-[12px] font-medium px-3 py-1.5 rounded-lg backdrop-blur-sm">
            {{ 'workout.photo.click_to_preview'|trans({}, 'navigation') }}
        </span>
    </div>
</div>
<p class="text-[#8b9bb4] text-[12px] mb-3">
    {{ 'workout.edit.photo_replace'|trans({}, 'navigation') }}
</p>
<button type="button"
        data-action="click->workout--photo-upload#onRemoveExisting"
        class="block mx-auto mb-3 text-[#8b9bb4] hover:text-rose-400 text-[12px] font-medium transition-colors duration-200">
    {{ 'workout.photo.remove'|trans({}, 'navigation') }}
</button>
