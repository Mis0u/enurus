{#
    Variables attendues (toutes via `only`) :
    - workout, tonnage, muscles, hiddenCount, exerciseCount, hasPr, hasRepsRecord, user
    - badges : list<App\Service\Badge\View\BadgeTileView> — badges débloqués par cette séance
    - showUrl : string — URL de destination au clic (propre séance ou séance d'une connexion)
    - readOnly : bool — masque les boutons d'édition/suppression quand vrai
#}
{# Toute la carte mène au détail via le lien du titre, étiré sur la carte (cf. _title.html.twig) :
   un vrai lien, atteignable au clavier, sans imbriquer les boutons d'action dans un <a>. Sur
   mobile, carte compacte : infos à gauche, actions empilées à droite. #}
<div
    class="workout-row group bg-[#0f1928] border border-white/[0.07] rounded-xl px-5 py-4 max-md:px-3.5 max-md:py-3 grid grid-cols-[180px_1fr_auto] max-md:grid-cols-[minmax(0,1fr)_auto] gap-5 max-md:gap-x-2 max-md:gap-y-1 items-center cursor-pointer relative overflow-hidden transition-all duration-250 hover:border-white/[0.12] hover:bg-[#151f30] hover:-translate-y-px hover:shadow-[0_8px_30px_rgba(0,0,0,0.3)] has-[.workout-row-link:focus-visible]:outline-2 has-[.workout-row-link:focus-visible]:outline-[#f43f5e]"
    style="animation: fadeUp 0.3s ease both;"
>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(244,63,94,0.03),transparent_60%)] pointer-events-none"></div>

    {% include 'workout/list/Session/_date_time.html.twig' with {'workout': workout} only %}

    <div class="flex flex-col gap-2 max-md:gap-1 min-w-0">

        {% include 'workout/list/Session/_title.html.twig' with {'workout': workout, 'showUrl': showUrl} only %}

        {% include 'workout/list/Session/_metric.html.twig' with {
            'workout': workout,
            'tonnage': tonnage,
            'exerciseCount': exerciseCount,
            'hasPr': hasPr,
            'hasRepsRecord': hasRepsRecord,
            'badges': badges,
            'user': user,
        } only %}

        {% include 'workout/list/Session/_muscle_tag.html.twig' with {
            'muscles': muscles,
            'hiddenCount': hiddenCount,
        } only %}

        {% include 'workout/list/Session/_muscle_line.html.twig' with {'muscles': muscles} only %}
    </div>

    {% if not readOnly %}
        <div class="relative z-10 flex items-center gap-2 max-md:flex-col max-md:col-start-2 max-md:row-start-1 max-md:row-span-2">

            {% include 'workout/list/Session/_edit_button.html.twig' with {'workout': workout} only %}

            {% include 'workout/list/Session/_delete_button.html.twig' with {'workout': workout} only %}
        </div>
    {% endif %}

</div>
