<div
    class="group bg-[#0f1928] border border-white/[0.07] rounded-xl px-5 py-4 grid grid-cols-[180px_1fr_auto] max-md:grid-cols-1 gap-5 max-md:gap-3 items-center cursor-pointer relative overflow-hidden transition-all duration-250 hover:border-white/[0.12] hover:bg-[#151f30] hover:-translate-y-px hover:shadow-[0_8px_30px_rgba(0,0,0,0.3)]"
    style="animation: fadeUp 0.3s ease both;"
    onclick="window.location.href='{{ path('app_workout_show', {'id': workout.id}) }}'"
>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(244,63,94,0.03),transparent_60%)] pointer-events-none"></div>

    {% include 'workout/list/Session/_date_time.html.twig' with {'workout': workout} only %}

    <div class="flex flex-col gap-2">

        {% include 'workout/list/Session/_title.html.twig' with {'workout': workout} only %}

        {% include 'workout/list/Session/_metric.html.twig' with {
            'workout': workout,
            'tonnage': tonnage,
            'exerciseCount': exerciseCount,
            'user': user,
        } only %}

        {% include 'workout/list/Session/_muscle_tag.html.twig' with {
            'muscles': muscles,
            'hiddenCount': hiddenCount,
        } only %}
    </div>

    <div class="flex items-center gap-2 max-md:justify-end" onclick="event.stopPropagation()">

        {% include 'workout/list/Session/_edit_button.html.twig' with {'workout': workout} only %}

        {% include 'workout/list/Session/_delete_button.html.twig' with {'workout': workout} only %}
    </div>

</div>
