{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block title %}{{ 'workout.list.title'|trans({}, 'navigation')|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {'title': 'workout.list.title'|trans({}, 'navigation'), 'subtitle': user.nickname|formatInitials} only %}
{% endblock %}

{% block state %}
    <div
        class="flex-1 relative overflow-y-auto overflow-x-hidden px-7 pt-6 pb-[120px] max-md:px-4 max-md:pb-[160px]"
        data-controller="workout--list--delete-modal"
    >
        {% include 'workout/list/_filters.html.twig' with {
            'filterType': filterType,
            'filterDate': filterDate,
            'pagination': pagination,
        } only %}

        {% if pagination.getTotalItemCount() == 0 %}
            <div class="flex flex-col items-center justify-center py-20 gap-4">
                <div class="w-16 h-16 rounded-2xl bg-white/[0.04] border border-white/[0.07] flex items-center justify-center">
                    {% include 'partials/_svg/_calendar.html.twig' with {'width': '8', 'height': '8'} only %}
                </div>
                <p class="font-rajdhani text-lg font-semibold text-[#8b9bb4]">
                    {{ 'workout.list.empty'|trans({}, 'navigation') }}
                </p>
            </div>
        {% else %}
            <div class="flex flex-col gap-2.5">
                {% for workout in pagination %}
                    {% include 'workout/list/_session_row.html.twig' with {
                        workout: workout,
                        tonnage: tonnageMap[workout.id] ?? null,
                        muscles: musclesMap[workout.id] ?? [],
                        hiddenCount: hiddenCountMap[workout.id] ?? 0,
                        exerciseCount: exerciseCountMap[workout.id ~ ''] ?? 0,
                        user: user,
                    } only %}
                {% endfor %}
            </div>

            {% include '_pagination/_pagination.html.twig' with {
                'pagination': pagination,
                'route': 'app_workout_list',
                'routeParams': {'filter': filterType, 'date': filterDate},
                'limitAllowed': limitAllowed,
            } only %}
        {% endif %}

    </div>
{% endblock %}
