{#
    Variable attendue : `view` ('list'|'calendar'). Rechargement de page classique (pas de JS,
    même convention que le toggle Semaine/Mois de _month_week.html.twig) — chaque onglet construit
    des données totalement différentes côté contrôleur (liste paginée vs heatmap+deloads), pas de
    raison de les calculer toutes les deux à chaque requête.
#}
<div class="flex gap-1 bg-white/[0.04] rounded-lg p-0.75 mb-5 w-fit">
    <a
        href="{{ path('app_workout_list', {'_locale': app.request.locale}) }}"
        class="px-4 py-2 rounded-md text-[13px] font-rajdhani font-bold flex items-center gap-2 transition-all duration-250 {{ view == 'list' ? 'bg-rose-ft text-white' : 'text-[#4a5568] hover:bg-white/[0.06] hover:text-[#f0f4ff]' }}"
    >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        {{ 'workout.list.view.list'|trans({}, 'navigation') }}
    </a>
    <a
        href="{{ path('app_workout_list', {'view': 'calendar', '_locale': app.request.locale}) }}"
        class="px-4 py-2 rounded-md text-[13px] font-rajdhani font-bold flex items-center gap-2 transition-all duration-250 {{ view == 'calendar' ? 'bg-rose-ft text-white' : 'text-[#4a5568] hover:bg-white/[0.06] hover:text-[#f0f4ff]' }}"
    >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
        {{ 'workout.list.view.calendar'|trans({}, 'navigation') }}
    </a>
</div>
