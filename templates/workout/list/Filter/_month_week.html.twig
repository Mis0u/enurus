<a
    href="{{ path('app_workout_list', {'filter': 'week', '_locale': app.request.locale}) }}"
    data-workout--list--workout-filters-target="dateInput"="tabWeek"
    class="px-3 py-1.5 rounded-md text-[12px] font-medium transition-all duration-250
                {% if filterType == 'week' and (filterDate is null or filterDate == '') %}
                    bg-[#f43f5e] text-white
                {% else %}
                    text-[#4a5568] hover:bg-white/[0.06] hover:text-[#f0f4ff]
                {% endif %}
            "
>
{{ 'workout.list.filter.week'|trans({}, 'navigation') }}
</a>
<a
    href="{{ path('app_workout_list', {'filter': 'month', '_locale': app.request.locale}) }}"
    data-workout--list--workout-filters-target="dateInput"="tabMonth"
class="px-3 py-1.5 rounded-md text-[12px] font-medium transition-all duration-250
