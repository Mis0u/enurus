{#
    Variables attendues (toutes via `only`) : workout, tonnage, exerciseCount, hasPr, hasRepsRecord,
    user, badges (list<BadgeTileView> — miniatures des badges débloqués par cette séance)
#}
<div class="session-tonnage flex items-center gap-4 max-md:gap-3 text-[12px]">
    {% if tonnage is not null and tonnage > 0 %}
        <span class="flex items-center gap-1.5 text-[#8b9bb4]">
            {% include 'partials/_svg/_lightning.html.twig' only %}
            <span class="font-semibold text-[#f0f4ff]">{{ tonnage|number_format(0, ',', ' ') }}</span>
            {% if user.unitOfMeasure.value == enum('App\\Enum\\Entity\\User\\UnitOfMeasureEnum').LBS.value %}
                {{ 'workout.list.lbs'|trans({}, 'navigation')|lower }}
            {% else %}
                {{ 'workout.list.kg'|trans({}, 'navigation')|lower }}
            {% endif %}
        </span>
    {% endif %}
    <span class="flex items-center gap-1.5 text-[#8b9bb4]">
        {% include 'partials/_svg/_list.html.twig' only %}
        <span class="font-semibold text-[#f0f4ff]">{{ exerciseCount }}</span>
        {{ 'workout.list.exercises'|trans({'count': exerciseCount}, 'navigation') }}
    </span>
    {% if workout.photoPath is not null %}
        <span class="flex items-center gap-1.5 text-[#8b9bb4]"
              aria-label="{{ 'workout.photo.has_photo'|trans({}, 'navigation') }}"
              title="{{ 'workout.photo.has_photo'|trans({}, 'navigation') }}">
        {% include 'partials/_svg/_picture.html.twig' with {'weight': 3, 'height': 3, 'color': '[#8b9bb4]'} only %}
    </span>
    {% endif %}
    {% if hasPr %}
        <span class="relative z-10 text-[13px] leading-none cursor-help"
              data-controller="tooltip"
              data-tooltip-text-value="{{ 'dashboard.widget.session.pr_tooltip'|trans({}, 'navigation') }}"
              data-action="click->tooltip#toggle"
              aria-label="{{ 'dashboard.widget.session.pr_tooltip'|trans({}, 'navigation') }}"
              title="{{ 'dashboard.widget.session.pr_tooltip'|trans({}, 'navigation') }}">🏆</span>
    {% endif %}
    {% if hasRepsRecord %}
        <span class="relative z-10 text-[13px] leading-none cursor-help"
              data-controller="tooltip"
              data-tooltip-text-value="{{ 'dashboard.widget.session.reps_record_tooltip'|trans({}, 'navigation') }}"
              data-action="click->tooltip#toggle"
              aria-label="{{ 'dashboard.widget.session.reps_record_tooltip'|trans({}, 'navigation') }}"
              title="{{ 'dashboard.widget.session.reps_record_tooltip'|trans({}, 'navigation') }}">🔁</span>
    {% endif %}
    {% if badges is not empty %}
        {% set badge_names = badges|map(tile => tile.name)|join(', ') %}
        {% set badges_label = 'badge.workout.tooltip'|trans({count: badges|length, names: badge_names}, 'navigation') %}
        <span class="relative z-10 flex items-center gap-1 cursor-help"
              data-controller="tooltip"
              data-tooltip-text-value="{{ badges_label }}"
              data-action="click->tooltip#toggle"
              aria-label="{{ badges_label }}"
              title="{{ badges_label }}">
            {% for tile in badges %}
                {% include 'partials/_milestone_badge/_badge.html.twig' with {
                    family: tile.family,
                    tier: tile.tier,
                    ribbon: tile.ribbon,
                    label: tile.name,
                    locked: false,
                    size: 'xxs',
                } only %}
            {% endfor %}
        </span>
    {% endif %}
</div>
