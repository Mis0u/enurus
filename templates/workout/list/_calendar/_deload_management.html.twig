{#
    Variables attendues : `deloadPeriods` (list<DeloadPeriod>), `deloadForm` (FormView de
    DeloadPeriodType).
#}
<div class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] md:p-[26px]">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
        <div>
            <h3 class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4] mb-1">
                {{ 'workout.list.calendar.deload.title'|trans({}, 'navigation') }}
            </h3>
            <p class="text-[12px] text-[#4a5568]">
                {{ 'workout.list.calendar.deload.subtitle'|trans({}, 'navigation') }}
            </p>
        </div>
        <button
            type="button"
            data-action="click->workout--list--deload-modal#open"
            class="font-rajdhani inline-flex items-center gap-2 px-4 py-2.5 rounded-[10px] text-white text-[13px] font-bold bg-gradient-to-br from-cyan-ft to-[#0891b2] shadow-[0_4px_15px_rgba(6,182,212,0.3)] hover:shadow-[0_6px_22px_rgba(6,182,212,0.5)] hover:-translate-y-px transition-all duration-200 whitespace-nowrap cursor-pointer"
        >
            {% include 'partials/_svg/_add.html.twig' with {'width': 4, 'height': 4, 'ariaHidden': true} only %}
            {{ 'workout.list.calendar.deload.add_button'|trans({}, 'navigation') }}
        </button>
    </div>

    {% if deloadPeriods is empty %}
        <p class="text-[13px] text-[#4a5568] italic">
            {{ 'workout.list.calendar.deload.empty'|trans({}, 'navigation') }}
        </p>
    {% else %}
        <div class="flex flex-col gap-2.5">
            {% for deload in deloadPeriods %}
                <div class="flex items-center justify-between gap-3 px-4 py-3 bg-cyan-ft/[0.06] border border-cyan-ft/[0.15] rounded-xl">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-cyan-ft/15 flex items-center justify-center shrink-0">
                            {% include 'partials/_svg/_moon.html.twig' only %}
                        </div>
                        <div>
                            <div class="text-[13px] font-semibold text-[#f0f4ff]">
                                {{ deload.startDate|format_date('medium', locale=app.request.locale) }}
                                –
                                {{ deload.endDate|format_date('medium', locale=app.request.locale) }}
                            </div>
                            {% if deload.note is not null %}
                                <div class="text-[11.5px] text-[#64748b] mt-0.5">{{ deload.note }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <button
                        type="button"
                        data-action="click->workout--list--delete-modal#deleteDeloadPeriod"
                        data-title="{{ 'workout.list.calendar.deload.delete.title'|trans({}, 'navigation') }}"
                        data-message="{{ 'workout.list.calendar.deload.delete.message'|trans({}, 'navigation') }}"
                        data-confirm="{{ 'workout.list.calendar.deload.delete.confirm'|trans({}, 'navigation') }}"
                        data-cancel="{{ 'workout.list.calendar.deload.delete.cancel'|trans({}, 'navigation') }}"
                        data-error-text="{{ 'workout.list.calendar.deload.delete.error_text'|trans({}, 'navigation') }}"
                        data-delete-url="{{ path('app_deload_period_delete', {'id': deload.id, '_locale': app.request.locale}) }}"
                        data-token="{{ csrf_token('deload_period_delete_' ~ deload.id) }}"
                        class="w-8 h-8 rounded-lg border border-white/[0.07] bg-white/[0.03] flex items-center justify-center text-[#8b9bb4] hover:bg-[rgba(244,63,94,0.15)] hover:border-[rgba(244,63,94,0.4)] hover:text-[#f43f5e] hover:scale-105 transition-all duration-250 cursor-pointer shrink-0"
                    >
                        {% include 'partials/_svg/_trash.html.twig' with {'width': 4, 'height': 4} only %}
                    </button>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% include 'workout/list/_calendar/_deload_modal.html.twig' with {'deloadForm': deloadForm} only %}
