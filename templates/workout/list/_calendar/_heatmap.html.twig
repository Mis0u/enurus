{#
    Variable attendue : `heatmapData` (structure de WorkoutHeatmapService::build()) —
    `{weeks: list<{days: list<{date, level, isDeload}>, isNewMonth: bool}>}`.
#}
<div class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] md:p-[26px]">
    <h3 class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4] mb-1">
        {{ 'workout.list.calendar.heatmap.title'|trans({}, 'navigation') }}
    </h3>
    <p class="text-[12px] text-[#4a5568] mb-4">
        {{ 'workout.list.calendar.heatmap.subtitle'|trans({}, 'navigation') }}
    </p>

    <div class="overflow-x-auto scrollbar-thin">
        <div class="inline-block min-w-full">
            <div class="flex ml-[26px] mb-1.5">
                {% for week in heatmapData.weeks %}
                    <div class="w-[13px] shrink-0 text-[10px] text-[#4a5568]">
                        {% if week.isNewMonth %}
                            {{ week.days[0].date|format_date(pattern='MMM', locale=app.request.locale) }}
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            <div class="flex gap-[3px]">
                <div class="flex flex-col gap-[3px] w-[22px] shrink-0">
                    {% for day in heatmapData.weeks[0].days %}
                        <div class="h-[10px] text-[9px] text-[#4a5568] leading-[10px]">
                            {{ day.date|format_date(pattern='EEEEE', locale=app.request.locale) }}
                        </div>
                    {% endfor %}
                </div>

                <div class="flex gap-[3px]">
                    {% for week in heatmapData.weeks %}
                        <div class="flex flex-col gap-[3px]">
                            {% for day in week.days %}
                                {% if day.isDeload %}
                                    {% set cell_class = 'bg-cyan-ft/35 border border-dashed border-cyan-ft/60' %}
                                {% elseif day.level == 3 %}
                                    {% set cell_class = 'bg-rose-ft' %}
                                {% elseif day.level == 2 %}
                                    {% set cell_class = 'bg-rose-ft/50' %}
                                {% elseif day.level == 1 %}
                                    {% set cell_class = 'bg-rose-ft/25' %}
                                {% else %}
                                    {% set cell_class = 'bg-white/[0.04]' %}
                                {% endif %}
                                <div
                                    class="w-[10px] h-[10px] rounded-[2px] {{ cell_class }}"
                                    title="{{ day.date|format_date('full', locale=app.request.locale) }}"
                                ></div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-4 mt-4 text-[10.5px] text-[#4a5568] flex-wrap">
        <div class="flex items-center gap-1.5">
            <div class="w-[10px] h-[10px] rounded-[2px] bg-rose-ft/25"></div>
            {{ 'workout.list.calendar.heatmap.legend_session_short'|trans({}, 'navigation') }}
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-[10px] h-[10px] rounded-[2px] bg-rose-ft/50"></div>
            {{ 'workout.list.calendar.heatmap.legend_session_medium'|trans({}, 'navigation') }}
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-[10px] h-[10px] rounded-[2px] bg-rose-ft"></div>
            {{ 'workout.list.calendar.heatmap.legend_session_long'|trans({}, 'navigation') }}
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-[10px] h-[10px] rounded-[2px] bg-cyan-ft/35 border border-dashed border-cyan-ft/60"></div>
            {{ 'workout.list.calendar.heatmap.legend_deload'|trans({}, 'navigation') }}
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-[10px] h-[10px] rounded-[2px] bg-white/[0.04]"></div>
            {{ 'workout.list.calendar.heatmap.legend_rest'|trans({}, 'navigation') }}
        </div>
    </div>
</div>
