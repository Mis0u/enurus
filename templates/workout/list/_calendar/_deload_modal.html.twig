{#
    Variable attendue : `deloadForm` (FormView de DeloadPeriodType). Masquée par défaut, ouverte
    via workout--list--deload-modal#open (bouton "Programmer un repos").
#}
<div
    data-workout--list--deload-modal-target="modal"
    class="hidden fixed inset-0 z-[120] items-center justify-center bg-[#080e1a]/90 backdrop-blur-sm px-4"
>
    <div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-7 w-full max-w-md shadow-[0_20px_60px_rgba(0,0,0,0.5)] max-md:p-5">

        <div class="w-14 h-14 bg-cyan-ft/15 border border-cyan-ft/30 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
        </div>

        <h3 class="font-rajdhani text-[22px] font-bold text-center text-[#f0f4ff] mb-2">
            {{ 'workout.list.calendar.modal.title'|trans({}, 'navigation') }}
        </h3>
        <p class="text-center text-[#8b9bb4] text-[13px] mb-6 max-md:text-[12px]">
            {{ 'workout.list.calendar.modal.subtitle'|trans({}, 'navigation') }}
        </p>

        {{ form_start(deloadForm, {
            'action': path('app_deload_period_create', {'_locale': app.request.locale}),
            'attr': {'class': 'w-full'},
        }) }}
            <div class="flex gap-3 mb-1 max-md:flex-col max-md:gap-0">
                <div class="flex-1">{{ form_row(deloadForm.startDate) }}</div>
                <div class="flex-1">{{ form_row(deloadForm.endDate) }}</div>
            </div>
            {{ form_row(deloadForm.note) }}
            {{ form_row(deloadForm._token) }}

            <div class="flex gap-2.5 mt-5 max-md:flex-col">
                <button
                    type="button"
                    data-action="click->workout--list--deload-modal#close"
                    class="cursor-pointer flex-1 px-5 py-3 bg-white/[0.06] border border-white/[0.07] rounded-lg text-[#f0f4ff] text-[14px] font-medium transition-all duration-250 hover:bg-white/[0.1] hover:border-white/[0.12]"
                >
                    {{ 'workout.list.calendar.modal.cancel'|trans({}, 'navigation') }}
                </button>
                <button
                    type="submit"
                    class="cursor-pointer flex-1 px-5 py-3 bg-gradient-to-br from-cyan-ft to-[#0891b2] text-white font-rajdhani font-bold text-[14px] rounded-lg shadow-[0_4px_15px_rgba(6,182,212,0.3)] hover:shadow-[0_6px_22px_rgba(6,182,212,0.5)] transition-all duration-250"
                >
                    {{ 'workout.list.calendar.modal.submit'|trans({}, 'navigation') }}
                </button>
            </div>
        {{ form_end(deloadForm, {'render_rest': false}) }}
    </div>
</div>
