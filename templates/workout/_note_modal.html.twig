<div id="note-modal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-[#080e1a]/90 backdrop-blur-sm px-4">
    <div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-7 w-full max-w-lg shadow-[0_20px_60px_rgba(0,0,0,0.5)] max-md:p-5">

        <div class="w-14 h-14 bg-rose-500/15 border border-rose-500/30 rounded-xl flex items-center justify-center mx-auto mb-5">
            {% include 'partials/_svg/_pen.html.twig' with {'weight': 7, 'height': 7, 'color': '[#f43f5e]'} %}
        </div>

        <h3 class="font-rajdhani text-[22px] font-bold text-center text-[#f0f4ff] mb-2">
            {{ 'workout.note.title'|trans({}, 'navigation') }}
        </h3>
        <p class="text-center text-[#8b9bb4] text-[13px] mb-6 max-md:text-[12px]">
            {{ 'workout.note.subtitle'|trans({}, 'navigation') }}
        </p>

        <textarea
            id="workout-note-input"
            rows="4"
            placeholder="{{ 'workout.note.placeholder'|trans({}, 'navigation') }}"
            class="w-full px-4 py-3 bg-white/[0.04] border border-white/[0.07] rounded-[10px] text-[#f0f4ff] text-[14px] outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] resize-none mb-6"
        ></textarea>

        <div class="flex gap-2.5 max-md:flex-col">
            <twig:Button:Basic:Basic
                data="id=note-modal-back"
                type="button" message="{{ 'workout.note.back'|trans({}, 'navigation') }}"
                class="cursor-pointer flex-1 px-5 py-3 bg-white/[0.06] border border-white/[0.07] rounded-lg text-[#f0f4ff] text-[14px] font-medium transition-all duration-250 hover:bg-white/[0.1] hover:border-white/[0.12]"
            />
            <twig:Button:Primary:Primary
                data="id=note-modal-submit"
                message="{{ 'workout.note.submit_without'|trans({}, 'navigation') }}"
                type="button"
                class="cursor-pointer flex-1 px-5 py-3 bg-gradient-to-br from-rose-500 to-red-600 text-white font-rajdhani font-bold text-[14px] rounded-lg shadow-[0_4px_15px_rgba(244,63,94,0.3)] hover:shadow-[0_6px_22px_rgba(244,63,94,0.5)] hover:-translate-y-0.5 transition-all duration-250"
            />
        </div>
    </div>
</div>
