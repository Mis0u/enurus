{% form_theme form 'workout/form/theme/workout_theme.html.twig' %}

<div class="flex items-center gap-4 mb-7 px-5 py-4 bg-[#0f1928] border border-white/[0.07] rounded-[14px] flex-wrap max-md:flex-col max-md:gap-3">

    {{ form_row(form.performedAt) }}
    {{ form_row(form.duration) }}

    {% include 'workout/create/_toggle_routine.html.twig' %}


    <div
        id="routine-selector"
        class="flex flex-col gap-1.5 flex-1 max-md:w-full {{ workout.routine is not defined or workout.routine is null ? 'hidden' : '' }}"
        data-controller="workout--routine-loader"
        data-workout--routine-loader-block-url-value="{{ path('workout_routine_exercises_block') }}"
        data-workout--routine-loader-warning-title-value="{{ 'workout.routine.change_warning_title'|trans({}, 'navigation') }}"
        data-workout--routine-loader-warning-text-value="{{ 'workout.routine.change_warning_text'|trans({}, 'navigation') }}"
        data-workout--routine-loader-confirm-button-value="{{ 'workout.routine.change_confirm'|trans({}, 'navigation') }}"
        data-workout--routine-loader-cancel-button-value="{{ 'field.form.button.cancel'|trans({}, 'common') }}"
    >
        {{ form_row(form.routine) }}
    </div>

</div>
