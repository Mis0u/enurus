{% set is_time_based = exercise.measurementType.value == 'time' %}
{% set is_distance_based = exercise.measurementType.value == 'distance' %}
{% set is_bodyweight = exercise.bodyweightPercent is not null %}
<table class="w-full mb-3">
    <thead>
    <tr class="text-[11px] font-semibold uppercase tracking-[0.5px] text-[#4a5568]">
        <td class="pb-2.5 w-12">{{ 'workout.series'|trans({}, 'navigation') }}</td>
        <td class="pb-2.5 w-40">{{ (is_bodyweight ? 'workout.weight_bodyweight' : 'workout.weight')|trans({}, 'navigation') }}</td>
        <td class="pb-2.5 w-40">
            {% if is_time_based %}
                {{ 'workout.series_duration'|trans({}, 'navigation') }}
            {% elseif is_distance_based %}
                {{ 'workout.series_distance'|trans({}, 'navigation') }}
            {% else %}
                {{ 'workout.reps'|trans({}, 'navigation') }}
            {% endif %}
        </td>
        <td class="pb-2.5 w-14"></td>
    </tr>
    </thead>
    <tbody class="js-sets-tbody">
    {% if existingSets is defined and existingSets is not empty %}
        {% for set_index, set in existingSets %}
            <tr data-set-index="{{ set_index }}" class="border-b border-white/[0.04] last:border-0 bg-[rgba(255,255,255,0.02)] rounded-[8px] [&>td]:px-2 [&>td]:py-2.5">
                <td class="font-rajdhani font-semibold text-[#8b9bb4] text-[15px]">{{ set_index + 1 }}</td>
                <td class="pr-2">
                    <input type="number"
                           name="workout[workoutExercises][{{ index }}][exerciseSets][{{ set_index }}][weight]"
                           value="{{ set.weight }}"
                           data-error-message="{{ 'workout.error.required_weight'|trans({}, 'navigation') }}"
                           {{ (is_time_based or is_distance_based or is_bodyweight) ? '' : 'required' }}
                           min="{{ (is_time_based or is_distance_based or is_bodyweight) ? '0' : '0.1' }}"
                           step="0.1"
                           placeholder="{{ is_bodyweight ? 'workout.series_bodyweight_extra_abbreviate'|trans({}, 'navigation')|lower : app.user.unitOfMeasure.value }}"
                           class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                    <input type="hidden"
                           name="workout[workoutExercises][{{ index }}][exerciseSets][{{ set_index }}][position]"
                           value="{{ set_index }}">
                    {% if is_bodyweight %}
                        <span class="js-lifted-weight block mt-1 text-[10px] text-[#4a5568] whitespace-nowrap"
                              data-bodyweight-share="{{ set.bodyweightShare ?? cardBodyweightShare ?? 0 }}"></span>
                    {% endif %}
                </td>
                <td class="pr-2">
                    {% if is_time_based %}
                        <input type="number"
                               name="workout[workoutExercises][{{ index }}][exerciseSets][{{ set_index }}][duration]"
                               value="{{ set.duration }}"
                               data-error-message="{{ 'workout.error.required_duration'|trans({}, 'navigation') }}"
                               required
                               min="1"
                               placeholder="{{ 'workout.series_duration_abbreviate'|trans({}, 'navigation')|lower }}"
                               class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                    {% elseif is_distance_based %}
                        <input type="number"
                               name="workout[workoutExercises][{{ index }}][exerciseSets][{{ set_index }}][distance]"
                               value="{{ set.distance }}"
                               data-error-message="{{ 'workout.error.required_distance'|trans({}, 'navigation') }}"
                               required
                               min="1"
                               placeholder="{{ 'workout.series_distance_abbreviate'|trans({}, 'navigation')|lower }}"
                               class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                    {% else %}
                        <input type="number"
                               name="workout[workoutExercises][{{ index }}][exerciseSets][{{ set_index }}][reps]"
                               value="{{ set.reps }}"
                               data-error-message="{{ 'workout.error.required_reps'|trans({}, 'navigation') }}"
                               required
                               min="1"
                               placeholder="{{ 'workout.reps_abbreviate'|trans({}, 'navigation')|lower }}"
                               class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                    {% endif %}
                </td>
                <td class="text-center">
                    <div class="flex items-center justify-center gap-1">
                        <button type="button"
                                data-action="click->{{ controllerName|default('exercise') }}#repeatSet"
                                aria-label="{{ 'workout.repeat_series'|trans({}, 'navigation') }}"
                                class="text-[#4a5568] hover:text-[#06b6d4] transition-colors duration-250 flex items-center justify-center w-6 h-6 max-md:w-5 max-md:h-5">
                            {% include 'partials/_svg/_repeat.html.twig' only %}
                        </button>
                        <button type="button"
                                data-action="click->{{ controllerName|default('exercise') }}#deleteSet"
                                class="text-[#4a5568] hover:text-[#f43f5e] transition-colors duration-250 text-[20px] leading-none flex items-center justify-center w-6 h-6 max-md:w-5 max-md:h-5">
                            {% include 'partials/_svg/_red_cross.html.twig' only %}
                        </button>
                    </div>
                </td>
            </tr>
        {% endfor %}
    {% else %}
        <tr data-set-index="0" class="border-b border-white/[0.04] last:border-0 bg-[rgba(255,255,255,0.02)] rounded-[8px] [&>td]:px-2 [&>td]:py-2.5">
            <td class="font-rajdhani font-semibold text-[#8b9bb4] text-[15px]">1</td>
            <td class="pr-2">
                <input type="number"
                       name="workout[workoutExercises][{{ index }}][exerciseSets][0][weight]"
                       data-error-message="{{ 'workout.error.required_weight'|trans({}, 'navigation') }}"
                       {{ (is_time_based or is_distance_based or is_bodyweight) ? '' : 'required' }}
                       min="{{ (is_time_based or is_distance_based or is_bodyweight) ? '0' : '0.1' }}"
                       step="0.1"
                       placeholder="{{ is_bodyweight ? 'workout.series_bodyweight_extra_abbreviate'|trans({}, 'navigation')|lower : app.user.unitOfMeasure.value }}"
                       class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                <input type="hidden"
                       name="workout[workoutExercises][{{ index }}][exerciseSets][0][position]"
                       value="0">
                {% if is_bodyweight %}
                    <span class="js-lifted-weight block mt-1 text-[10px] text-[#4a5568] whitespace-nowrap"
                          data-bodyweight-share="{{ cardBodyweightShare ?? 0 }}"></span>
                {% endif %}
            </td>
            <td class="pr-2">
                {% if is_time_based %}
                    <input type="number"
                           name="workout[workoutExercises][{{ index }}][exerciseSets][0][duration]"
                           data-error-message="{{ 'workout.error.required_duration'|trans({}, 'navigation') }}"
                           required
                           min="1"
                           placeholder="{{ 'workout.series_duration_abbreviate'|trans({}, 'navigation')|lower }}"
                           class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                {% elseif is_distance_based %}
                    <input type="number"
                           name="workout[workoutExercises][{{ index }}][exerciseSets][0][distance]"
                           data-error-message="{{ 'workout.error.required_distance'|trans({}, 'navigation') }}"
                           required
                           min="1"
                           placeholder="{{ 'workout.series_distance_abbreviate'|trans({}, 'navigation')|lower }}"
                           class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                {% else %}
                    <input type="number"
                           name="workout[workoutExercises][{{ index }}][exerciseSets][0][reps]"
                           data-error-message="{{ 'workout.error.required_reps'|trans({}, 'navigation') }}"
                           required
                           min="1"
                           placeholder="{{ 'workout.reps_abbreviate'|trans({}, 'navigation')|lower }}"
                           class="w-20 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
                {% endif %}
            </td>
            <td class="text-center">
                <div class="flex items-center justify-center gap-1">
                    <button type="button"
                            data-action="click->{{ controllerName|default('exercise') }}#repeatSet"
                            aria-label="{{ 'workout.repeat_series'|trans({}, 'navigation') }}"
                            class="text-[#4a5568] hover:text-[#06b6d4] transition-colors duration-250 flex items-center justify-center w-6 h-6 max-md:w-5 max-md:h-5">
                        {% include 'partials/_svg/_repeat.html.twig' only %}
                    </button>
                    <button type="button"
                            data-action="click->{{ controllerName|default('exercise') }}#deleteSet"
                            class="text-[#4a5568] hover:text-[#f43f5e] transition-colors duration-250 text-[20px] leading-none flex items-center justify-center w-6 h-6 max-md:w-5 max-md:h-5">
                        {% include 'partials/_svg/_red_cross.html.twig' only %}
                    </button>
                </div>
            </td>
        </tr>
    {% endif %}
    </tbody>
</table>
