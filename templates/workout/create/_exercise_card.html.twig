{% set is_blocked = exercise.bodyweightPercent is not null and not userHasBodyweight and (existingSets|default([]) is empty) %}
<div class="bg-[#0f1928] border border-white/[0.07] rounded-[14px] px-4 py-4 relative transition-all duration-250 {{ is_blocked ? '' : 'hover:border-white/[0.12]' }} mb-4"
     data-exercise-index="{{ index }}"
     data-bodyweight="{{ exercise.bodyweightPercent is not null ? 'true' : 'false' }}"
     data-bodyweight-blocked="{{ is_blocked ? 'true' : 'false' }}"
     {% if is_blocked %}aria-disabled="true"{% endif %}>
    <input type="hidden" name="workout[workoutExercises][{{ index }}][exercise]" value="{{ exercise.id }}">
    <input type="hidden" name="workout[workoutExercises][{{ index }}][position]" value="{{ index }}" class="js-position-input">
    {% include 'workout/create/_card.html.twig' with {'controllerName': controllerName|default('exercise'), 'exercise': exercise} only %}
    {% if exercise.exerciseMuscles is not empty %}
        <div class="flex flex-wrap gap-1.5 mb-4 {{ is_blocked ? 'opacity-40' : '' }}">
            {{ component('MuscleTags', {exercise: exercise}) }}
        </div>
    {% endif %}
    {% if is_blocked %}
        <p class="flex items-start gap-1.5 mb-4 px-3 py-2 bg-[rgba(244,63,94,0.1)] border border-[rgba(244,63,94,0.3)] rounded-lg text-[12.5px] font-medium text-[#f43f5e]">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>
                {{ 'workout.search_exercise.bodyweight_required'|trans({}, 'navigation') }}
                <a href="{{ path('app_settings') }}#fieldBodyweight" class="underline hover:text-[#ff6b85]">
                    {{ 'settings.bodyweight.label'|trans({}, 'navigation') }}
                </a>
            </span>
        </p>
    {% endif %}
    <div class="{{ is_blocked ? 'opacity-40' : '' }}">
        {% include 'workout/create/_table.html.twig' with {
            'controllerName': controllerName|default('exercise'),
            'existingSets': existingSets|default([]),
            'index': index,
            'exercise': exercise,
            'cardBodyweightShare': cardBodyweightShare|default(null),
            'isBlocked': is_blocked,
        } only %}
        {% include 'workout/create/_template.html.twig' with {
            'controllerName': controllerName|default('exercise'),
            'exercise': exercise,
            'cardBodyweightShare': cardBodyweightShare|default(null),
        } only %}
        <button type="button"
                {% if is_blocked %}disabled{% endif %}
                data-action="click->{{ controllerName|default('exercise') }}#addSet"
                class="w-full flex items-center justify-center gap-1.5 px-3.5 py-2.5 bg-white/[0.03] border border-dashed border-white/[0.12] rounded-lg text-[#8b9bb4] text-[12.5px] font-medium transition-all duration-250 {{ is_blocked ? 'cursor-not-allowed' : 'cursor-pointer hover:bg-[rgba(244,63,94,0.07)] hover:text-[#f43f5e] hover:border-[#f43f5e]' }}">
            {% include 'partials/_svg/_add.html.twig' with {'width': 3.5, 'height': 3.5} only %}
            {{ 'workout.add.serie'|trans({}, 'navigation') }}
        </button>
    </div>
</div>
