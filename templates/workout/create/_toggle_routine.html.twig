<div class="flex flex-col gap-1.5 {{ user.routines|length > 0 ? 'flex-1' : '' }} max-md:w-full" data-controller="session-type">
    <label class="text-[11px] font-semibold uppercase tracking-[0.5px] text-[#4a5568]">
        {{ 'workout.type.title'|trans({}, 'navigation') }}
    </label>
    <div class="flex gap-2 bg-white/[0.04] rounded-[10px] p-1">
        {# Formulaire de création : jamais de routine pré-sélectionnée, "Séance libre" est
           toujours l'état initial — session-type_controller.js gère le toggle ensuite. #}
        <button
            type="button"
            data-session-type-target="free"
            data-action="click->session-type#toggle"
            class="session-type-btn active px-4 py-2 rounded-lg text-[13px] font-medium text-[#4a5568] cursor-pointer transition-all duration-250 border-0 bg-transparent"
        >
            {{ 'workout.type.free'|trans({}, 'navigation') }}
        </button>
        {% if user.routines|length > 0 %}
            <button
                type="button"
                data-session-type-target="routine"
                data-action="click->session-type#toggle"
                class="session-type-btn px-4 py-2 rounded-lg text-[13px] font-medium text-[#4a5568] cursor-pointer transition-all duration-250 border-0 bg-transparent hover:text-[#f0f4ff] hover:bg-white/[0.06]"
            >
                {{ 'workout.type.routine'|trans({}, 'navigation') }}
            </button>
        {% endif %}
    </div>
</div>
