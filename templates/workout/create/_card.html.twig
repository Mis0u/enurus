<div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-3">
            <span class="drag-handle cursor-grab text-[#4a5568] hover:text-[#8b9bb4] transition-colors duration-250">
                {% include 'partials/_svg/_drag_handle.html.twig' only %}
            </span>
        <h4 class="font-rajdhani font-bold text-[18px] text-[#f0f4ff]">
            {% if exercise.isPublic %}
                {{ exercise.name|trans({}, 'exercise') }}
            {% else %}
                {{ exercise.name }}
            {% endif %}
            {% if exercise.archived %}
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10.5px] font-medium bg-white/[0.06] border border-white/[0.15] text-slate-400 align-middle ml-1">
                    {{ 'exercise.list.badge.archived'|trans({}, 'navigation') }}
                </span>
            {% endif %}
        </h4>
    </div>
    <button type="button"
            data-action="click->{{ controllerName|default('exercise') }}#deleteExercise"
            class="text-[#4a5568] hover:text-[#f43f5e] transition-colors duration-250 cursor-pointer">
        {% include 'partials/_svg/_trash.html.twig' only %}
    </button>
</div>
