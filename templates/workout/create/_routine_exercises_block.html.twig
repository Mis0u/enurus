{#
    templates/workout/create/_routine_exercises_block.html.twig

    Boucle sur les RoutineExercise d'une routine pour générer
    autant de blocs _exercise_card.html.twig qu'il y a d'exercices,
    avec un index continu qui démarre à startIndex.

    Paramètres :
      - routineExercises      : Collection<int, RoutineExercise>
      - startIndex            : int
      - cardData              : array<string, array> (RoutineExercise.exercise.id => données de carte :
                                part de poids de corps, séries pré-remplies avec la dernière
                                performance, date de cette performance — cf. WorkoutExerciseCardDataBuilder)
      - userHasBodyweight     : bool (poids corporel courant de l'utilisateur renseigné ou non)
#}
{% for routine_exercise in routineExercises %}
    {% set card = cardData[routine_exercise.exercise.id] %}
    {% include 'workout/create/_exercise_card.html.twig' with {
        exercise: routine_exercise.exercise,
        index: startIndex + loop.index0,
        cardBodyweightShare: card.cardBodyweightShare,
        existingSets: card.existingSets,
        prefilledFrom: card.prefilledFrom,
        userHasBodyweight: userHasBodyweight,
    } only %}
{% endfor %}
