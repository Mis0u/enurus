{% set is_time_based = exercise.measurementType.value == 'time' %}
{% set is_distance_based = exercise.measurementType.value == 'distance' %}
<template class="js-set-template">
    <tr data-set-index="__SET_INDEX__"
        class="border-b border-white/[0.04] last:border-0 bg-[rgba(255,255,255,0.02)] rounded-[8px] [&>td]:px-2 [&>td]:py-2.5">
        <td class="font-rajdhani font-semibold text-[#8b9bb4] text-[15px]">__SET_NUMBER__</td>
        <td>
            <input type="number"
                   name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][weight]"
                   data-error-message="{{ 'workout.error.required_weight'|trans({}, 'navigation') }}"
                   {{ (is_time_based or is_distance_based) ? '' : 'required' }}
                   min="{{ (is_time_based or is_distance_based) ? '0' : '0.1' }}"
                   step="0.1"
                   placeholder="{{ app.user.unitOfMeasure.value }}"
                   class="w-20 max-md:w-16 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
            <input type="hidden"
                   name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][position]"
                   value="__SET_INDEX__">
        </td>
        <td>
            {% if is_time_based %}
                <input type="number"
                       name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][duration]"
                       data-error-message="{{ 'workout.error.required_duration'|trans({}, 'navigation') }}"
                       required
                       min="1"
                       placeholder="{{ 'workout.series_duration_abbreviate'|trans({}, 'navigation')|lower }}"
                       class="w-20 max-md:w-16 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
            {% elseif is_distance_based %}
                <input type="number"
                       name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][distance]"
                       data-error-message="{{ 'workout.error.required_distance'|trans({}, 'navigation') }}"
                       required
                       min="1"
                       placeholder="{{ 'workout.series_distance_abbreviate'|trans({}, 'navigation')|lower }}"
                       class="w-20 max-md:w-16 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
            {% else %}
                <input type="number"
                       name="workout[workoutExercises][__EXERCISE_INDEX__][exerciseSets][__SET_INDEX__][reps]"
                       data-error-message="{{ 'workout.error.required_reps'|trans({}, 'navigation') }}"
                       required
                       min="1"
                       placeholder="{{ 'workout.reps_abbreviate'|trans({}, 'navigation')|lower }}"
                       class="w-20 max-md:w-16 px-3 py-2 bg-white/[0.04] border border-white/[0.07] rounded-md text-[#f0f4ff] text-sm font-rajdhani font-semibold text-center outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)] focus:bg-white/[0.06] placeholder:text-[#4a5568] placeholder:font-normal">
            {% endif %}
        </td>
        <td class="text-center">
            <div class="flex items-center justify-center gap-1">
                <button type="button"
                        data-action="click->{{ controllerName|default('exercise') }}#repeatSet"
                        aria-label="{{ 'workout.repeat_series'|trans({}, 'navigation') }}"
                        class="text-[#4a5568] hover:text-[#06b6d4] transition-colors duration-250 flex items-center justify-center w-6 h-6 max-md:w-5 max-md:h-5">
                    {% include 'partials/_svg/_repeat.html.twig' only %}
                </button>
                <button type="button"
                        data-action="click->{{ controllerName|default('exercise') }}#deleteSet"
                        class="text-[#4a5568] hover:text-[#f43f5e] transition-colors duration-250 text-[20px] leading-none flex items-center justify-center w-6 h-6 max-md:w-5 max-md:h-5">
                    {% include 'partials/_svg/_red_cross.html.twig' only %}
                </button>
            </div>
        </td>
    </tr>
</template>
