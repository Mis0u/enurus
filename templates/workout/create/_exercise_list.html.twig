<div data-controller="exercise"
     data-exercise-no-date-title-value="{{ 'workout.error.no_date.title'|trans({}, 'navigation') }}"
     data-exercise-no-date-text-value="{{ 'workout.error.no_date.text'|trans({}, 'navigation') }}"
     data-exercise-no-exercise-title-value="{{ 'workout.error.no_exercise.title'|trans({}, 'navigation') }}"
     data-exercise-no-exercise-text-value="{{ 'workout.error.no_exercise.text'|trans({}, 'navigation') }}"
     data-exercise-submit-failed-title-value="{{ 'workout.error.submit_failed.title'|trans({}, 'navigation') }}"
     data-exercise-submit-failed-text-value="{{ 'workout.error.submit_failed.text'|trans({}, 'navigation') }}"
     data-exercise-upload-photo-url-value="{{ path('workout_upload_photo', {
         '_locale': app.request.locale,
         'id': '__ID__'
     }) }}">

    <div data-exercise-target="exerciseList" id="exercises-list"></div>

    {% include 'workout/create/_submit_bar.html.twig' only %}
</div>
