<div data-workout--photo-upload-target="placeholder" class="flex flex-col items-center gap-2 py-2">
    {% include 'partials/_svg/_upload.html.twig' with {'weight': 8, 'height': 8, 'color': '[#8b9bb4]'} only %}
    <span class="text-[#8b9bb4] text-[13px]">{{ 'workout.photo.drag_or'|trans({}, 'navigation') }}</span>
    <label class="cursor-pointer px-4 py-1.5 bg-rose-500/10 border border-rose-500/30 rounded-lg text-rose-400 text-[12px] font-medium hover:bg-rose-500/20 transition-colors duration-200">
        {{ 'workout.photo.select'|trans({}, 'navigation') }}
        <input type="file"
               accept="image/jpeg,image/png,image/webp"
               class="hidden"
               data-workout--photo-upload-target="input"
               data-action="change->workout--photo-upload#onFileChange">
    </label>
    <span class="text-[#4a5568] text-[11px]">{{ 'workout.photo.constraints'|trans({}, 'navigation') }}</span>
</div>
