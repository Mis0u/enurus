<div class="mb-6">
    <p class="text-[#8b9bb4] text-[12px] font-medium mb-2">
        {{ 'workout.photo.label'|trans({}, 'navigation') }}
    </p>

    <div data-workout--photo-upload-target="zone"
         data-error-type="{{ 'workout.photo.invalid_type'|trans({}, 'navigation') }}"
         data-error-size="{{ 'workout.photo.too_large'|trans({}, 'navigation') }}"
         data-action="dragover->workout--photo-upload#onDragOver dragleave->workout--photo-upload#onDragLeave drop->workout--photo-upload#onDrop"
         class="relative border border-dashed border-white/[0.1] rounded-xl p-4 text-center transition-all duration-250 hover:border-rose-500/40 [&.drag-over]:border-rose-500/60 [&.drag-over]:bg-rose-500/5 [&.uploading]:opacity-60 [&.uploading]:pointer-events-none">

        {% include 'workout/create/_note_modal/_photo_placeholder.html.twig' with {'imageAllowedMimeTypes': imageAllowedMimeTypes} only %}
        {% include 'workout/create/_note_modal/_photo_preview.html.twig' only %}
    </div>

    <p data-workout--photo-upload-target="error"
       class="hidden text-rose-400 text-[12px] mt-2"></p>
</div>
