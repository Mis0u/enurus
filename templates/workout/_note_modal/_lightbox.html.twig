{# Lightbox — hors de la modale pour éviter les conflits z-index et overflow #}
<div data-workout--photo-upload-target="lightbox"
     data-action="click->workout--photo-upload#closeLightbox"
     class="hidden fixed inset-0 z-[60] bg-black/80 backdrop-blur-sm items-center justify-center p-4">
    <img src=""
         data-workout--photo-upload-target="lightboxImg"
         class="max-w-full max-h-full object-contain rounded-xl"
         alt="">
</div>
