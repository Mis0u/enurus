{% form_theme form 'workout/form/theme/workout_theme.html.twig' %}

<div class="flex items-center gap-4 mb-7 px-5 py-4 bg-[#0f1928] border border-white/[0.07] rounded-[14px] flex-wrap max-md:flex-col max-md:gap-3">

    {{ form_row(form.performedAt) }}
    {{ form_row(form.duration) }}

    {% include 'workout/_toggle_routine.html.twig' %}


    <div
        id="routine-selector"
        class="flex flex-col gap-1.5 flex-1 max-md:w-full {{ workout.routine is not defined or workout.routine is null ? 'hidden' : '' }}"
    >
        {{ form_row(form.routine) }}
    </div>

</div>
