<div class="fixed modal-overlay inset-0 bg-[rgba(8,14,26,0.92)] backdrop-blur-sm z-[100] items-center justify-center animate-[fadeIn_0.2s_ease]" id="searchModal"
     data-controller="search-modal"
     data-action="click->search-modal#closeOnOverlay"
>
    <div class="bg-[#0f1928] border border-white/[0.07] rounded-2xl px-7 py-7 max-w-[600px] w-[calc(100%-40px)] shadow-[0_20px_60px_rgba(0,0,0,0.5)] animate-[slideUp_0.3s_cubic-bezier(0.34,1.56,0.64,1)] max-md:max-w-full max-md:h-screen max-md:rounded-none max-md:px-5">

        <h3 class="font-rajdhani text-[22px] font-bold text-center mb-5">
            {{ 'workout.search_exercise.title'|trans({}, 'navigation') }}
        </h3>

        <div class="relative mb-5">
            <input
                type="text"
                id="exerciseSearch"
                placeholder="{{ 'workout.search_exercise.placeholder'|trans({}, 'navigation') }}"
                oninput="filterExercises()"
                class="w-full px-4 py-3.5 pr-11.5 bg-white/[0.04] border border-white/[0.07] rounded-[10px] text-[#f0f4ff] text-[15px] outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)]"
            >
            {% include 'partials/_svg/_magnifying_glass.html.twig' %}
        </div>

        {# Résultats de recherche #}
        <div class="max-h-[400px] overflow-y-auto mb-4 scrollbar-thin scrollbar-thumb-white/[0.07] scrollbar-track-transparent" id="searchResults" data-controller="search-modal">
            {% if exercises is defined %}
            {% for exercise in exercises %}
                <div
                    class="px-3.5 py-3 bg-white/[0.02] border border-white/[0.07] rounded-[10px] mb-2 cursor-pointer transition-all duration-250 search-result-item hover:bg-white/[0.06] hover:border-white/[0.12]"
                    data-action="click->search-modal#closeModal"
                >
                    <div class="text-[15px] font-semibold text-[#f0f4ff] mb-1.5 search-result-name">
                        {{ exercise.isPublic ? exercise.name|trans({}, 'exercise') : exercise.name }}
                    </div>
                    <div class="flex items-center gap-1.5 flex-wrap">
                        {% for exercise_muscle in exercise.exerciseMuscles %}
                            {% if exercise_muscle.type.value == enum('App\\Enum\\Entity\\ExerciceMuscle\\MuscleTypeEnum').PRIMARY.value %}
                                <span class="px-2.5 py-0.75 bg-[rgba(244,63,94,0.15)] border border-[rgba(244,63,94,0.3)] rounded-md text-[11px] font-medium text-[#f43f5e]">
                                        {{ exercise_muscle.muscleGroup.name|trans({}, 'muscle') }}
                                </span>
                            {% else %}
                                <span class="px-2.5 py-0.75 bg-[rgba(249,115,22,0.15)] border border-[rgba(249,115,22,0.3)] rounded-md text-[11px] font-medium text-[#f97316]">
                                    {{ exercise_muscle.muscleGroup.name|trans({}, 'muscle') }}
                                </span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
