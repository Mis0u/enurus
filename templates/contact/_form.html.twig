{#
    Variables attendues (toutes via `only`) :
    - contactForm : FormView
    - imageMaxSizeBytes : int
    - imageAllowedMimeTypes : array<string>
#}
<section class="bg-[#0f1928] border border-white/[0.07] rounded-2xl p-6">
    <div class="flex items-center gap-2.5 mb-2">
        <div class="w-8.5 h-8.5 rounded-lg bg-[rgba(6,182,212,0.15)] border border-[rgba(6,182,212,0.3)] flex items-center justify-center shrink-0">
            {% include 'partials/_svg/_envelope.html.twig' with {'width': 4.5, 'height': 4.5, 'extraClass': 'text-[#06b6d4]'} only %}
        </div>
        <h2 class="font-['Rajdhani'] text-lg font-bold text-[#f0f4ff]">{{ 'contact.title'|trans({}, 'navigation') }}</h2>
    </div>
    <p class="text-sm text-[#8b9bb4] mb-6">{{ 'contact.intro'|trans({}, 'navigation') }}</p>

    {{ form_start(contactForm, {render_rest: false}) }}

    {# Catégorie — select stylisé Tailwind (chevron custom), même pattern que settings/_fields/_language.html.twig #}
    <div class="mb-[18px]">
        {{ form_label(contactForm.category) }}
        <div class="relative">
            {{ form_widget(contactForm.category, {
                attr: {
                    class: 'w-full appearance-none min-h-11 pl-4 pr-10 py-3 rounded-xl bg-white/5 border text-white text-sm outline-none cursor-pointer focus:ring-2 focus:border-transparent transition-all backdrop-blur-sm ' ~ (contactForm.category.vars.valid ? 'border-white/10 focus:ring-cyan-500' : 'border-red-500/50 focus:ring-red-500/20'),
                }
            }) }}
            <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8b9bb4] pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
        {{ form_errors(contactForm.category) }}
    </div>

    <div class="mb-[18px]">
        {{ form_label(contactForm.subject) }}
        {{ form_widget(contactForm.subject, {
            attr: {
                class: 'w-full min-h-11 pl-4 pr-4 py-3 rounded-xl bg-white/5 border text-white placeholder-slate-500 outline-none focus:ring-2 focus:border-transparent transition-all backdrop-blur-sm ' ~ (contactForm.subject.vars.valid ? 'border-white/10 focus:ring-cyan-500' : 'border-red-500/50 focus:ring-red-500/20'),
                placeholder: 'contact.field.subject_placeholder'|trans({}, 'navigation'),
            }
        }) }}
        {{ form_errors(contactForm.subject) }}
    </div>

    {% include 'contact/_image_field.html.twig' with {
        fieldId: 'contactImage',
        imageMaxSizeBytes: imageMaxSizeBytes,
        imageAllowedMimeTypes: imageAllowedMimeTypes,
    } only %}

    <div class="mb-[18px]">
        {{ form_label(contactForm.message) }}
        {{ form_widget(contactForm.message, {
            attr: {
                rows: 6,
                class: 'w-full pl-4 pr-4 py-3 rounded-xl bg-white/5 border text-white placeholder-slate-500 outline-none focus:ring-2 focus:border-transparent transition-all backdrop-blur-sm ' ~ (contactForm.message.vars.valid ? 'border-white/10 focus:ring-cyan-500' : 'border-red-500/50 focus:ring-red-500/20'),
                placeholder: 'contact.field.message_placeholder'|trans({}, 'navigation'),
            }
        }) }}
        {{ form_errors(contactForm.message) }}
    </div>

    {{ form_row(contactForm._token) }}

    <div class="mt-6 pt-[22px] border-t border-white/[0.07]">
        <button type="submit"
                class="cursor-pointer w-full min-h-11 py-3.5 px-4 bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white font-bold rounded-xl shadow-lg shadow-rose-500/30 hover:shadow-rose-500/50 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2 focus:ring-offset-slate-900 flex items-center justify-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
            </svg>
            {{ 'contact.submit'|trans({}, 'navigation') }}
        </button>
    </div>
    {{ form_end(contactForm, {render_rest: false}) }}
</section>
