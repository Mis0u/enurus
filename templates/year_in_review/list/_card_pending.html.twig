{#
    Année publiée dont le résumé est encore en cours de génération (tâche de minuit).
    Variables attendues (via `only`) :
    - card : App\Service\YearInReview\View\YearInReviewCard
#}
<article data-year-in-review-card="pending"
         class="flex items-center gap-4 p-[18px] rounded-2xl bg-bg-card border border-white/[0.07]">
    <span class="font-rajdhani text-[40px] font-bold leading-none text-[#4a5568]">{{ card.year }}</span>
    <p class="text-[13px] leading-relaxed text-[#8b9bb4]">{{ 'year_in_review.list.card.pending'|trans({}, 'navigation') }}</p>
</article>
