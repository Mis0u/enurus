{#
    Email d'annonce du résumé annuel, enregistré à la volée — cible du lien de désinscription de
    l'email (ancre #email).
    Variables attendues (via `only`) :
    - emailOnYearInReview : bool
#}
<section id="email"
         class="bg-bg-card border border-white/[0.07] rounded-2xl p-[18px] scroll-mt-4"
         aria-labelledby="year-in-review-email-title"
         data-controller="email-notification-toggle"
         data-email-notification-toggle-url-value="{{ path('app_year_in_review_email_toggle') }}"
         data-email-notification-toggle-csrf-token-value="{{ csrf_token(constant('App\\Controller\\YearInReview\\YearInReviewEmailToggleController::CSRF_TOKEN_ID')) }}"
         data-email-notification-toggle-success-message-value="{{ 'year_in_review.list.email.feedback.success'|trans({}, 'navigation') }}">
    <h2 id="year-in-review-email-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
        {{ 'year_in_review.list.email.title'|trans({}, 'navigation') }}
    </h2>

    <label class="relative flex items-center justify-between gap-3 mt-3 max-md:min-h-11 cursor-pointer">
        <span class="flex flex-col gap-0.5">
            <span class="text-sm text-[#f0f4ff]">{{ 'year_in_review.list.email.label'|trans({}, 'navigation') }}</span>
            <span class="text-[12.5px] text-[#8b9bb4]">{{ 'year_in_review.list.email.hint'|trans({}, 'navigation') }}</span>
        </span>
        <input type="checkbox"
               class="peer sr-only"
               {% if emailOnYearInReview %}checked{% endif %}
               data-action="change->email-notification-toggle#toggle">
        <span class="shrink-0 w-9 h-5 rounded-full bg-white/10 relative transition-colors peer-checked:bg-rose-ft peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-rose-ft after:content-[''] after:absolute after:left-0.5 after:top-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"></span>
    </label>
</section>
