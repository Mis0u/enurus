{# Variables attendues (via `only`) : screen (MoodScreen), year (int) #}
{% set mood_label = ('workout.mood.' ~ screen.mood.value)|trans({}, 'navigation') %}
<p class="text-[17px] text-[#cbd5e1]">{{ 'year_in_review.show.mood.lead'|trans({}, 'navigation') }}</p>
<p class="flex items-center gap-3 rounded-full border border-green-500/45 bg-green-500/10 py-2 pr-5 pl-2.5">
    <img src="{{ asset('images/emojis/' ~ screen.mood.value ~ '.png') }}" alt="" class="h-8 w-8">
    <span class="font-rajdhani text-[26px] font-bold text-green-500">{{ mood_label }}</span>
</p>
<p class="mt-1 font-rajdhani text-[112px] leading-[0.85] font-bold text-green-500">{{ 'year_in_review.show.mood.percent'|trans({percent: screen.percent / 100}, 'navigation') }}</p>
<p class="text-[15px] leading-relaxed text-[#8b9bb4]">{{ 'year_in_review.show.mood.share'|trans({}, 'navigation') }}</p>
