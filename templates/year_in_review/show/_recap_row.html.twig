{#
    Ligne de texte de « En bref ».
    Variables attendues (via `only`) : label (string), value (string)
#}
<div class="flex flex-col gap-0.5 border-b border-white/[0.07] px-3.5 py-3 last:border-b-0">
    <dt class="text-[13px] text-[#8b9bb4]">{{ label }}</dt>
    <dd class="text-[17px] font-semibold">{{ value }}</dd>
</div>
