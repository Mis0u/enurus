{# Variables attendues (via `only`) : screen (ThanksScreen), year (int) #}
<div class="flex flex-col items-center gap-5 text-center">
    <img src="{{ asset('images/enurus_logo.png') }}" alt="{{ 'name'|trans({}, 'brand') }}" class="h-auto w-44">
    <h2 class="font-rajdhani text-[40px] leading-none font-bold">{{ 'year_in_review.show.thanks.title'|trans({}, 'navigation') }}</h2>
    <p class="text-base leading-relaxed text-[#cbd5e1]">{{ 'year_in_review.show.thanks.text'|trans({}, 'navigation') }}</p>
    <div class="mt-3 flex w-full flex-col gap-2.5">
        <a href="{{ path('app_year_in_review_list') }}"
           class="flex min-h-12 items-center justify-center rounded-full bg-rose-ft text-[15px] font-semibold text-bg-base no-underline">
            {{ 'dashboard.my_recaps'|trans({}, 'navigation') }}
        </a>
        <a href="{{ path('app_year_in_review_show', {year: screen.year}) }}"
           class="flex min-h-12 items-center justify-center rounded-full border border-white/15 text-[15px] font-semibold text-[#f0f4ff] no-underline">
            {{ 'year_in_review.show.thanks.replay'|trans({}, 'navigation') }}
        </a>
    </div>
</div>
