{#
    Bandeau « Ton année est prête » en haut du dashboard de son propriétaire, jusqu'au 31 janvier
    (YearInReviewBannerState). La croix le masque pour de bon (YearInReviewBannerDismissController).
    Variables attendues (via `only`) :
    - year : int
#}
<aside data-controller="year-in-review--banner"
       data-year-in-review--banner-url-value="{{ path('app_year_in_review_banner_dismiss', {year: year}) }}"
       data-year-in-review--banner-csrf-token-value="{{ csrf_token(constant('App\\Controller\\YearInReview\\YearInReviewBannerDismissController::CSRF_TOKEN_ID')) }}"
       aria-label="{{ 'year_in_review.banner.title'|trans({year: year}, 'navigation') }}"
       class="mb-4 flex items-center rounded-2xl border border-cyan-ft/45 bg-bg-card md:mb-5">
    <a href="{{ path('app_year_in_review_show', {year: year}) }}"
       class="flex min-h-11 flex-1 items-center gap-3.5 py-4 pr-1 pl-4 text-[#f0f4ff] no-underline md:gap-4.5 md:py-[18px] md:pl-5">
        <span class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-[14px] border-2 border-cyan-ft font-rajdhani text-lg font-bold text-cyan-ft md:h-[60px] md:w-[60px] md:text-xl">{{ year }}</span>
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="font-rajdhani text-xl leading-tight font-bold md:text-[22px]">{{ 'year_in_review.banner.title'|trans({year: year}, 'navigation') }}</span>
            <span class="text-[13px] leading-snug text-[#8b9bb4] md:text-sm">{{ 'year_in_review.banner.text'|trans({}, 'navigation') }}</span>
        </span>
        <span class="hidden min-h-10 shrink-0 items-center rounded-full bg-cyan-ft px-[18px] text-sm font-semibold text-bg-base md:flex">{{ 'year_in_review.banner.cta'|trans({}, 'navigation') }}</span>
    </a>
    <button type="button"
            data-action="year-in-review--banner#dismiss"
            aria-label="{{ 'year_in_review.banner.dismiss'|trans({}, 'navigation') }}"
            class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center self-start border-0 bg-transparent text-[#8b9bb4] transition-ft hover:text-[#f0f4ff] md:mr-2 md:self-center">
        {% include 'partials/_svg/_cross.html.twig' with {'width': 4.5, 'height': 4.5, 'ariaHidden': true} only %}
    </button>
</aside>
