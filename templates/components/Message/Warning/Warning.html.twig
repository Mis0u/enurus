<div class="{{ this.classes }}">
    <div class="flex items-start space-x-3">
        {% if icon %}
            {% include this.svg only %}
        {% endif %}
        <div>
            <p class="text-sm text-amber-200 font-medium">
                {{ message }}
                {% if variable %}
                    <span>{{ variable }}</span>
                {% endif %}
            </p>
        </div>
    </div>
</div>
