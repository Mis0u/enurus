<a href="{{ this.link }}"
   class="{{ this.classes }}">
    {% if this.svg %}
        <span class="min-w-[20px] flex items-center justify-center text-white">
            {% include 'partials/_svg/_add.html.twig' %}
        </span>
    {% endif %}
    <span class="nav-label text-white font-semibold text-[13.5px]">{{ this.message }}</span>
</a>
