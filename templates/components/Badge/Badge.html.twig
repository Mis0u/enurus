<div class="flex flex-wrap md:flex-nowrap items-center gap-3 px-3 md:px-4 py-[10px] md:py-3 bg-white/[0.03] border border-white/[0.07] rounded-xl text-left transition-ft hover:border-rose-ft/20 hover:bg-rose-ft/[0.04]">
    <div class="w-[30px] h-[30px] md:w-[34px] md:h-[34px] flex-shrink-0 bg-amber-ft/10 border border-amber-ft/25 rounded-[9px] flex items-center justify-center text-[14px] md:text-[15px]">🔒</div>
    <div class="flex-1 min-w-[140px]">
        <div class="text-[10px] md:text-[11px] font-semibold text-amber-ft uppercase tracking-[0.3px] mb-0.5">{{ this.title }}</div>
        <div class="text-[11.5px] md:text-[12.5px] text-[#8b9bb4] leading-[1.3]">{{ this.message }}</div>
    </div>
</div>
