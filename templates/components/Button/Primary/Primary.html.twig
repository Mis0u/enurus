<button
    {{ attributes }}
    {% if disabled %}disabled{% endif %}
    class="{{ this.classes }}"
    type="{{ type }}"
    {% if data is not null %}
        {{ data }}
    {% endif %}
>
    {% if icon %}
        <div class="flex items-center justify-center space-x-2">
            {% include this.svg %}
            <span>{{ message }}</span>
        </div>
    {% else %}
        {{ message }}
    {% endif %}
</button>
