<div
    class="fixed top-4 right-4 z-50 max-w-md"
    data-controller="flash-message"
    data-flash-message-duration-value="5000"
>
    <div class="rounded-xl p-4 shadow-lg border bg-[#0f1928]
        {% if type == 'success' %}
            border-green-500/40
        {% elseif type == 'error' %}
            border-red-500/40
        {% endif %}
">
        <div class="flex items-center gap-2.5
            {% if type == 'success' %}
                text-green-400
            {% elseif type == 'error' %}
                text-red-400
            {% endif %}
">
            <span class="flex-shrink-0">
                {% if type == 'success' %}
                    {% include 'partials/_svg/_check.html.twig' %}
                {% elseif type == 'error' %}
                    {% include 'partials/_svg/_red_cross.html.twig' %}
                {% endif %}
            </span>
            <p class="text-sm font-medium text-[#f0f4ff]">
                {{ message }}
            </p>
        </div>
    </div>
</div>
