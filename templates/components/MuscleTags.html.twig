{% for muscle in this.sortedMuscles %}
    {% if muscle.type.value == enum('App\\Enum\\Entity\\ExerciceMuscle\\MuscleTypeEnum').PRIMARY.value %}
        <span class="px-2.5 py-0.75 bg-[rgba(244,63,94,0.15)] border border-[rgba(244,63,94,0.3)] rounded-md text-[11px] font-medium text-[#f43f5e]">
            {{ muscle.label }}
        </span>
    {% else %}
        <span class="px-2.5 py-0.75 bg-[rgba(6,182,212,0.15)] border border-[rgba(6,182,212,0.3)] rounded-md text-[11px] font-medium text-[#06b6d4]">
            {{ muscle.label }}
        </span>
    {% endif %}
{% endfor %}
