<div {{ attributes }}>
    <twig:Button:Dotted:Dotted
        message="{{ 'workout.add.exercice'|trans({}, 'navigation') }}"
        type="button"
        data="data-action=live#action data-live-action-param=open"
    />
    {% if isOpen %}
        <div
            class="fixed inset-0 bg-[rgba(8,14,26,0.92)] backdrop-blur-sm z-[100] flex items-center justify-center animate-[fadeIn_0.2s_ease]"
            data-action="click->live#action"
            data-live-action-param="close"
        >
            <div
                class="bg-[#0f1928] border border-white/[0.07] rounded-2xl px-7 py-7 max-w-[600px] w-[calc(100%-40px)] shadow-[0_20px_60px_rgba(0,0,0,0.5)] animate-[slideUp_0.3s_cubic-bezier(0.34,1.56,0.64,1)] max-md:max-w-full max-md:h-screen max-md:rounded-none max-md:px-5"
                data-controller="search-modal"
                data-action="click->search-modal#stop"
            >
               {% include 'components/LiveComponent/ExerciseSelectorComponent/_search_bar.html.twig' %}

                <div class="max-h-[400px] overflow-y-auto mb-4 scrollbar-thin scrollbar-thumb-white/[0.07] scrollbar-track-transparent">
                    {% include 'components/LiveComponent/ExerciseSelectorComponent/_result.html.twig' %}
                </div>
                <div class="flex gap-2.5 mt-4">
                    <twig:Button:Basic:Basic
                        type="button"
                        message="{{ 'word.close'|trans({}, 'common') }}"
                        data="data-action=live#action data-live-action-param=close"
                    />
                </div>
            </div>
        </div>
    {% endif %}

</div>
