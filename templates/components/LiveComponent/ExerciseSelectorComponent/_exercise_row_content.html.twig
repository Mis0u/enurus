<span class="block text-[15px] font-semibold text-[#f0f4ff] mb-1.5">
    {{ exercise.isPublic ? exercise.name|trans({}, 'exercise') : exercise.name }}
    {% if exercise.bodyweightPercent is not null %}
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10.5px] font-medium bg-[rgba(244,63,94,0.1)] border border-[rgba(244,63,94,0.3)] text-[#f43f5e] align-middle ml-1">
            {{ 'exercise.bodyweight_badge'|trans({percent: exercise.bodyweightPercent|number_format(0)}, 'navigation') }}
        </span>
    {% endif %}
</span>
<span class="flex items-center gap-1.5 flex-wrap">
    {{ component('MuscleTags', {exercise: exercise}) }}
</span>
