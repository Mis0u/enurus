{% set results = this.filteredExercises %}
{% set habitual_exercises = this.habitualExercises %}
{% if results is not empty %}
    {% if habitual_exercises is not empty %}
        <h3 class="mb-2 text-[11px] font-semibold uppercase tracking-[0.5px] text-[#8b9bb4]">{{ 'workout.search_exercise.habitual'|trans({}, 'navigation') }}</h3>
        {% for exercise in habitual_exercises %}
            {% include 'components/LiveComponent/ExerciseSelectorComponent/_exercise_row.html.twig' with {'exercise': exercise, 'this': this} only %}
        {% endfor %}
        <h3 class="mt-4 mb-2 text-[11px] font-semibold uppercase tracking-[0.5px] text-[#8b9bb4]">{{ 'workout.search_exercise.all'|trans({}, 'navigation') }}</h3>
    {% endif %}
    {% for exercise in results %}
        {% include 'components/LiveComponent/ExerciseSelectorComponent/_exercise_row.html.twig' with {'exercise': exercise, 'this': this} only %}
    {% endfor %}
{% else %}
    <div class="text-center py-6">
        <p class="text-white/40 text-[14px] mb-2">
            {{ 'workout.search_exercise.no_result'|trans({}, 'navigation') }}
        </p>
        <a
            href="{{ path('app_exercise_create', this.createExerciseRouteParams) }}"
            class="text-[14px] text-rose-400 hover:text-rose-300 underline underline-offset-2"
            data-action="click->search-modal#confirmNavigate"
            data-title="{{ 'workout.search_exercise.create_link.title'|trans({}, 'navigation') }}"
            data-message="{{ (this.keepsWorkoutDraft ? 'workout.search_exercise.create_link.message_draft_kept' : 'workout.search_exercise.create_link.message')|trans({}, 'navigation') }}"
            data-confirm="{{ 'workout.search_exercise.create_link.confirm_button'|trans({}, 'navigation') }}"
            data-cancel="{{ 'workout.search_exercise.create_link.cancel_button'|trans({}, 'navigation') }}"
        >
            {{ 'workout.search_exercise.create_link.text'|trans({}, 'navigation') }}
        </a>
    </div>
{% endif %}
