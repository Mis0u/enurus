<h3 class="font-rajdhani text-[22px] font-bold text-center mb-5">
    {{ 'workout.search_exercise.title'|trans({}, 'navigation') }}
</h3>

<div class="relative mb-5">
    <input
        type="text"
        placeholder="{{ 'workout.search_exercise.placeholder'|trans({}, 'navigation') }}"
        data-model="on(input)|search"
        data-debounce="200"
        class="w-full px-4 py-3.5 pr-11.5 bg-white/[0.04] border border-white/[0.07] rounded-[10px] text-[#f0f4ff] text-[15px] outline-none transition-colors duration-250 focus:border-[rgba(244,63,94,0.4)]"
    >
    <div class="absolute right-4 top-1/2 -translate-y-1/2 text-[#4a5568]">
        {% include 'partials/_svg/_magnifying_glass.html.twig' only %}
    </div>
</div>

<details class="mb-5">
    <summary class="cursor-pointer text-[13px] font-medium text-white/60 hover:text-white/80 select-none">
        {{ 'workout.search_exercise.muscle_filter.toggle'|trans({}, 'navigation') }}
        {% if muscleGroupFilters is not empty %}
            <span class="text-[#f43f5e]">({{ muscleGroupFilters|length }})</span>
        {% endif %}
    </summary>
    <div class="flex flex-wrap gap-2 mt-3">
        {% for muscle_group in this.muscleGroups %}
            <label class="cursor-pointer">
                <input
                    type="checkbox"
                    value="{{ muscle_group.id }}"
                    data-model="muscleGroupFilters"
                    class="peer sr-only"
                >
                <span class="inline-block px-3 py-1.5 bg-white/[0.04] border border-white/[0.07] rounded-full text-[13px] text-white/70 transition-colors duration-150 peer-checked:bg-[rgba(244,63,94,0.15)] peer-checked:border-[rgba(244,63,94,0.3)] peer-checked:text-[#f43f5e]">
                    {{ muscle_group.name|trans({}, 'muscle') }}
                </span>
            </label>
        {% endfor %}
    </div>
</details>
