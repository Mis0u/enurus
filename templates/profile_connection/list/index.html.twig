{#
    Page « Mes connexions ».
    Controller : ProfileConnectionListController (GET /{_locale}/connexions)

    Variables passées par le controller :
      - overview       : ProfileConnectionOverview (demandes reçues, demandes envoyées, connexions acceptées)
      - requestForm    : FormView (saisie Alias#CODE, envoyée à ProfileConnectionRequestController)
      - isDiscoverable : bool (partage de son propre profil activé)
      - shareCode      : string|null (code de partage de l'utilisateur courant)
      - shareWorkoutsChecked : bool (partage de ses propres séances activé ET partage de profil
        actif — opt-in secondaire, jamais coché seul)
      - nickname       : string (alias de l'utilisateur courant)
      - sharedWidgets  : array<array{key: string, label: string, checked: bool, disabled: bool}>
        — widgets du dashboard encore visibles pour soi-même, verrouillés en cascade tant que le
        partage de profil et celui des séances ne sont pas tous les deux actifs
#}
{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block title %}{{ 'profile_connection.list.title'|trans({}, 'navigation')|format_title }}{% endblock %}

{% block topbar %}
    {% include 'dashboard/_dashboard_template/_topbar/_topbar.html.twig' with {
        title: 'profile_connection.list.title'|trans({}, 'navigation'),
        subtitle: app.user.nickname|formatInitials,
    } only %}
{% endblock %}

{% block state %}
    <div class="flex-1 overflow-y-auto p-4 max-md:pb-[160px] md:p-[24px_28px]">
        <div class="mx-auto flex w-full max-w-3xl flex-col gap-5">

            <p class="text-[13px] text-[#8b9bb4]">
                {{ 'profile_connection.list.intro'|trans({}, 'navigation') }}
            </p>

            {% include 'profile_connection/list/_sharing_card.html.twig' with {
                isDiscoverable: isDiscoverable,
                shareCode: shareCode,
                shareWorkoutsChecked: shareWorkoutsChecked,
                nickname: nickname,
            } only %}

            {% include 'profile_connection/list/_shared_widgets_card.html.twig' with {
                sharedWidgets: sharedWidgets,
            } only %}

            {% include 'profile_connection/list/_request_form.html.twig' with {
                requestForm: requestForm,
                isDiscoverable: isDiscoverable,
            } only %}

            {% if overview.receivedRequests is not empty %}
                <section class="flex flex-col gap-3" aria-labelledby="profile-connection-received-title">
                    <h2 id="profile-connection-received-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
                        {{ 'profile_connection.list.received.title'|trans({}, 'navigation') }}
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {% for entry in overview.receivedRequests %}
                            <li class="bg-bg-card border border-white/[0.07] rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
                                {% include 'profile_connection/list/_person.html.twig' with {person: entry.counterpart, hasNewWorkout: false} only %}
                                <div class="flex flex-wrap items-center gap-2">
                                    {% include 'profile_connection/list/_action_form.html.twig' with {
                                        url: path('app_profile_connection_accept', {id: entry.connection.id}),
                                        tokenId: 'profile_connection_accept',
                                        label: 'profile_connection.list.action.accept'|trans({}, 'navigation'),
                                        ariaLabel: 'profile_connection.list.action.accept_for'|trans({nickname: entry.counterpart.nickname}, 'navigation'),
                                        variant: 'primary',
                                    } only %}
                                    {% include 'profile_connection/list/_action_form.html.twig' with {
                                        url: path('app_profile_connection_decline', {id: entry.connection.id}),
                                        tokenId: 'profile_connection_decline',
                                        label: 'profile_connection.list.action.decline'|trans({}, 'navigation'),
                                        ariaLabel: 'profile_connection.list.action.decline_for'|trans({nickname: entry.counterpart.nickname}, 'navigation'),
                                        variant: 'secondary',
                                    } only %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            <section class="flex flex-col gap-3" aria-labelledby="profile-connection-connections-title">
                <h2 id="profile-connection-connections-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
                    {{ 'profile_connection.list.connections.title'|trans({}, 'navigation') }}
                </h2>
                {% if overview.connections is empty %}
                    <p class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px] text-center text-[13px] text-[#8b9bb4]">
                        {{ 'profile_connection.list.connections.empty'|trans({}, 'navigation') }}
                    </p>
                {% else %}
                    {# À partir de 5 connexions, la liste garde une hauteur fixe (~5 lignes) et
                       scrolle en interne plutôt que de laisser la page s'allonger indéfiniment. #}
                    <ul class="flex flex-col gap-3 {% if overview.connections|length >= 5 %}max-h-[430px] overflow-y-auto pr-1 exercise-list-scroll{% endif %}">
                        {% for entry in overview.connections %}
                            {% include 'profile_connection/list/_connection_row.html.twig' with {
                                entry: entry,
                                viewerIsDiscoverable: isDiscoverable,
                                showRevoke: true,
                            } only %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            {% if overview.sentRequests is not empty %}
                <section class="flex flex-col gap-3" aria-labelledby="profile-connection-sent-title">
                    <h2 id="profile-connection-sent-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
                        {{ 'profile_connection.list.sent.title'|trans({}, 'navigation') }}
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {% for entry in overview.sentRequests %}
                            <li class="bg-bg-card border border-white/[0.07] rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
                                {% include 'profile_connection/list/_person.html.twig' with {person: entry.counterpart, hasNewWorkout: false} only %}
                                {% include 'profile_connection/list/_action_form.html.twig' with {
                                    url: path('app_profile_connection_cancel', {id: entry.connection.id}),
                                    tokenId: 'profile_connection_cancel',
                                    label: 'profile_connection.list.action.cancel'|trans({}, 'navigation'),
                                    ariaLabel: 'profile_connection.list.action.cancel_for'|trans({nickname: entry.counterpart.nickname}, 'navigation'),
                                    variant: 'secondary',
                                } only %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

        </div>
    </div>
{% endblock %}
