{#
    Saisie Alias#CODE : recherche et envoi de la demande en une seule étape.
    Variables attendues (toutes via `only`) :
    - requestForm : FormView
#}
<section class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px]" aria-labelledby="profile-connection-request-title">
    <h2 id="profile-connection-request-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
        {{ 'profile_connection.list.request.title'|trans({}, 'navigation') }}
    </h2>
    <p id="profile-connection-request-help" class="text-[13px] text-[#8b9bb4] mt-1">
        {{ 'profile_connection.list.request.help'|trans({}, 'navigation') }}
    </p>

    {{ form_start(requestForm, {attr: {class: 'mt-4 flex flex-col gap-3 sm:flex-row sm:items-end'}}) }}
        <div class="flex-1">
            {{ form_label(requestForm.query, null, {label_attr: {class: 'block mb-1.5 text-[12px] font-semibold text-[#8b9bb4]'}}) }}
            {{ form_widget(requestForm.query, {attr: {class: 'w-full rounded-[10px] bg-white/[0.04] border border-white/[0.12] px-3 py-2 text-[14px] text-[#f0f4ff] placeholder:text-[#4a5568] focus:outline-none focus:border-rose-ft focus:ring-1 focus:ring-rose-ft'}}) }}
        </div>
        <button type="submit"
                class="inline-flex items-center justify-center px-4 py-2 rounded-[10px] text-[13px] font-semibold text-white bg-gradient-to-br from-rose-ft to-red-600 shadow-[0_4px_15px_rgba(244,63,94,0.3)] hover:-translate-y-px transition-all duration-200 whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-ft">
            {{ 'profile_connection.list.request.submit'|trans({}, 'navigation') }}
        </button>
    {{ form_end(requestForm) }}
</section>
