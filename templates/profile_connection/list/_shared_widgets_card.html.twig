{#
    Variables attendues (via `only`) :
    - sharedWidgets : array<array{key: string, label: string, checked: bool, disabled: bool}> —
      uniquement les widgets encore visibles sur son propre dashboard ; `checked`/`disabled`
      intègrent déjà le verrou en cascade (partage de profil + partage des séances), voir
      ProfileConnectionListController::buildSharedWidgetRows()
#}
{% if sharedWidgets is not empty %}
    <section class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px]"
             aria-labelledby="profile-connection-shared-widgets-title"
             data-controller="profile-connection--shared-widgets"
             data-profile-connection--shared-widgets-url-value="{{ path('app_profile_connection_shared_widgets_toggle') }}"
             data-profile-connection--shared-widgets-csrf-token-value="{{ csrf_token('profile_connection_shared_widgets') }}"
             data-profile-connection--shared-widgets-success-message-value="{{ 'profile_connection.list.shared_widgets.feedback.success'|trans({}, 'navigation') }}">

        <h2 id="profile-connection-shared-widgets-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
            {{ 'profile_connection.list.shared_widgets.title'|trans({}, 'navigation') }}
        </h2>
        <p class="text-[13px] text-[#8b9bb4] mt-1 mb-4">
            {{ 'profile_connection.list.shared_widgets.explanation'|trans({}, 'navigation') }}
        </p>

        <div class="flex flex-col gap-3">
            {% for widget in sharedWidgets %}
                <label class="flex items-center justify-between gap-3 cursor-pointer has-disabled:cursor-not-allowed">
                    <span class="text-sm text-[#f0f4ff]">{{ widget.label }}</span>
                    <input type="checkbox"
                           class="peer sr-only"
                           {% if widget.checked %}checked{% endif %}
                           {% if widget.disabled %}disabled{% endif %}
                           data-profile-connection--shared-widgets-target="checkbox"
                           data-action="change->profile-connection--shared-widgets#toggle"
                           data-profile-connection--shared-widgets-widget-param="{{ widget.key }}">
                    <span class="shrink-0 w-9 h-5 rounded-full bg-white/10 relative transition-colors peer-checked:bg-rose-ft peer-disabled:opacity-50 after:content-[''] after:absolute after:left-0.5 after:top-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"></span>
                </label>
            {% endfor %}
        </div>
    </section>
{% endif %}
