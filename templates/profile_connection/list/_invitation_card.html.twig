{#
    « Inviter un ami » : lien d'inscription portant le code de partage. Utilisable seulement avec le
    partage de profil actif (InvitationResolver ignore le code d'un profil qui ne se partage plus).
    Variables attendues (via `only`) :
    - isDiscoverable : bool
    - shareCode : string|null
    - canInvite : bool — partage actif ET code existant, état initial des boutons
    - invitationUrlTemplate : string — URL d'inscription absolue, code remplacé par
      invitationCodePlaceholder (le JS y remet le code courant, qui peut être régénéré)
    - invitationCodePlaceholder : string
#}
<section class="bg-bg-card border border-white/[0.07] rounded-2xl p-[22px]"
         aria-labelledby="profile-connection-invitation-title"
         data-controller="profile-connection--invitation"
         data-profile-connection--invitation-url-template-value="{{ invitationUrlTemplate }}"
         data-profile-connection--invitation-code-placeholder-value="{{ invitationCodePlaceholder }}"
         data-profile-connection--invitation-share-code-value="{{ shareCode }}"
         data-profile-connection--invitation-enabled-value="{{ isDiscoverable ? 'true' : 'false' }}"
         data-profile-connection--invitation-help-message-value="{{ 'profile_connection.list.invitation.explanation'|trans({}, 'navigation') }}"
         data-profile-connection--invitation-sharing-required-hint-value="{{ 'profile_connection.list.invitation.sharing_required_hint'|trans({}, 'navigation') }}"
         data-profile-connection--invitation-share-text-value="{{ 'profile_connection.list.invitation.share_text'|trans({brand: 'name'|trans({}, 'brand')}, 'navigation') }}"
         data-profile-connection--invitation-copy-message-value="{{ 'profile_connection.list.invitation.feedback.copied'|trans({}, 'navigation') }}"
         data-profile-connection--invitation-copy-error-message-value="{{ 'profile_connection.list.sharing.feedback.copy_error'|trans({}, 'navigation') }}">
    <h2 id="profile-connection-invitation-title" class="font-rajdhani text-[15px] font-semibold tracking-[0.5px] uppercase text-[#8b9bb4]">
        {{ 'profile_connection.list.invitation.title'|trans({}, 'navigation') }}
    </h2>
    <p id="profile-connection-invitation-help"
       class="text-[13px] text-[#8b9bb4] mt-1"
       data-profile-connection--invitation-target="hint">
        {{ canInvite ? 'profile_connection.list.invitation.explanation'|trans({}, 'navigation') : 'profile_connection.list.invitation.sharing_required_hint'|trans({}, 'navigation') }}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-2">
        <button type="button"
                {% if not canInvite %}disabled{% endif %}
                aria-describedby="profile-connection-invitation-help"
                data-profile-connection--invitation-target="copyButton"
                data-action="profile-connection--invitation#copy"
                class="inline-flex items-center justify-center px-4 py-2 max-md:min-h-11 rounded-[10px] text-[13px] font-semibold text-white bg-gradient-to-br from-rose-ft to-red-600 shadow-[0_4px_15px_rgba(244,63,94,0.3)] hover:-translate-y-px transition-all duration-200 whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-ft disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0">
            {{ 'profile_connection.list.invitation.copy'|trans({}, 'navigation') }}
        </button>
        {# Révélé par le JS seulement si le navigateur propose un partage natif (surtout mobile). #}
        <button type="button"
                hidden
                {% if not canInvite %}disabled{% endif %}
                aria-describedby="profile-connection-invitation-help"
                data-profile-connection--invitation-target="shareButton"
                data-action="profile-connection--invitation#share"
                class="inline-flex items-center justify-center px-4 py-2 max-md:min-h-11 rounded-[10px] text-[13px] font-semibold text-[#f0f4ff] bg-white/[0.06] hover:bg-white/[0.1] transition-ft whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed">
            {{ 'profile_connection.list.invitation.share'|trans({}, 'navigation') }}
        </button>
    </div>
</section>
