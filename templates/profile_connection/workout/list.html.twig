{#
    Liste des séances d'une connexion, en lecture seule.
    Controller : ProfileConnectionWorkoutListController (GET /{_locale}/connexions/{id}/seances)
    Variables : connection, subject, pagination, tonnageMap, musclesMap, hiddenCountMap,
    filterType, filterDate, routines, filterRoutine, muscleGroups, filterMuscles,
    filterMusclesParam, limitAllowed, exerciseCountMap, hasPrMap, hasRepsRecordMap — mêmes
    données que `workout/list/index.html.twig`, calculées pour `subject`.
#}
{% extends 'dashboard/_dashboard_template/_base_dashboard.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/date-picker.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/workout_list.css') }}">
{% endblock %}

{% block title %}{{ 'profile_connection.workout.list.title'|trans({nickname: subject.nickname}, 'navigation')|format_title }}{% endblock %}

{% block topbar %}
    {% include 'profile_connection/dashboard/_banner.html.twig' with {subject: subject} only %}
{% endblock %}

{% block state %}
    <div class="flex-1 relative overflow-y-auto overflow-x-hidden px-7 pt-6 pb-[120px] max-md:px-4 max-md:pb-[160px]">
        <a href="{{ path('app_profile_connection_dashboard', {id: connection.id}) }}"
           class="inline-flex items-center gap-2 mb-4 px-4 py-2 rounded-lg border border-white/[0.07] text-sm font-medium text-[#8b9bb4] hover:border-rose-ft/40 hover:text-rose-ft transition-colors whitespace-nowrap">
            {% include 'partials/_svg/_inferior.html.twig' with {'width': 4, 'height': 4} only %}
            <span>{{ 'profile_connection.workout.list.back_to_dashboard'|trans({nickname: subject.nickname}, 'navigation') }}</span>
        </a>

        {% include 'workout/list/_filters.html.twig' with {
            'filterType': filterType,
            'filterDate': filterDate,
            'routines': routines,
            'filterRoutine': filterRoutine,
            'muscleGroups': muscleGroups,
            'filterMuscles': filterMuscles,
            'filterMusclesParam': filterMusclesParam,
            'pagination': pagination,
            'route': 'app_profile_connection_workout_list',
            'routeParams': {id: connection.id},
        } only %}

        {% if pagination.getTotalItemCount() == 0 %}
            <div class="flex flex-col items-center justify-center py-20 gap-4">
                <div class="w-16 h-16 rounded-2xl bg-white/[0.04] border border-white/[0.07] flex items-center justify-center">
                    {% include 'partials/_svg/_calendar.html.twig' with {'width': '8', 'height': '8'} only %}
                </div>
                <p class="font-rajdhani text-lg font-semibold text-[#8b9bb4]">
                    {{ 'workout.list.empty'|trans({}, 'navigation') }}
                </p>
            </div>
        {% else %}
            <div class="flex flex-col gap-2.5">
                {% for workout in pagination %}
                    {% include 'workout/list/_session_row.html.twig' with {
                        workout: workout,
                        tonnage: tonnageMap[workout.id] ?? null,
                        muscles: musclesMap[workout.id] ?? [],
                        hiddenCount: hiddenCountMap[workout.id] ?? 0,
                        exerciseCount: exerciseCountMap[workout.id ~ ''] ?? 0,
                        hasPr: hasPrMap[workout.id] ?? false,
                        hasRepsRecord: hasRepsRecordMap[workout.id] ?? false,
                        user: app.user,
                        showUrl: path('app_profile_connection_workout_show', {id: connection.id, workoutId: workout.id}),
                        readOnly: true,
                    } only %}
                {% endfor %}
            </div>

            {% include '_pagination/_pagination.html.twig' with {
                'pagination': pagination,
                'route': 'app_profile_connection_workout_list',
                'routeParams': {'id': connection.id, 'filter': filterType, 'date': filterDate, 'routine': filterRoutine, 'muscles': filterMusclesParam},
                'limitAllowed': limitAllowed,
            } only %}
        {% endif %}
    </div>
{% endblock %}
