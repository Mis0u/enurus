{#
    Bandeau du dashboard d'une connexion, à la place de la topbar habituelle (celle-ci affiche
    l'avatar de l'utilisateur connecté, pas celui du propriétaire des données affichées).
    Variables attendues (toutes via `only`) :
    - subject : User — propriétaire du dashboard affiché
#}
<div class="relative z-[5] bg-[rgba(8,14,26,0.85)] backdrop-blur-[12px] border-b border-white/[0.07] px-4 md:px-7 py-3 md:py-[14px] flex flex-wrap items-center justify-between gap-x-4 gap-y-2 flex-shrink-0">
    <div class="flex items-center gap-2.5 min-w-0">
        {% include 'dashboard/_dashboard_template/_topbar/_mobile_menu.html.twig' only %}
        <div class="w-9 h-9 shrink-0 rounded-full bg-gradient-to-br from-rose-ft to-cyan-ft flex items-center justify-center font-rajdhani font-bold text-[15px] border-2 border-rose-ft overflow-hidden">
            {% if subject.avatarPath %}
                <img src="{{ subject.avatarPath|storage_url }}"
                     alt=""
                     crossorigin="anonymous"
                     class="w-full h-full object-cover">
            {% else %}
                <span aria-hidden="true">{{ subject.nickname|formatInitials }}</span>
            {% endif %}
        </div>
        <div class="min-w-0">
            <h1 class="font-rajdhani text-lg md:text-[22px] font-bold truncate">
                {{ 'profile_connection.dashboard.title'|trans({nickname: subject.nickname}, 'navigation') }}
            </h1>
            <p class="text-[12.5px] text-[#8b9bb4] mt-px">
                {{ 'profile_connection.dashboard.read_only'|trans({}, 'navigation') }}
            </p>
        </div>
    </div>
    <a href="{{ path('app_dashboard') }}"
       class="text-[13px] font-medium text-rose-ft hover:opacity-80 transition-ft whitespace-nowrap">
        {{ 'profile_connection.dashboard.back'|trans({}, 'navigation') }}
    </a>
</div>
