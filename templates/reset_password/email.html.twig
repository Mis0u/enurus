<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #0f172a; color: #e2e8f0;">

<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #0f172a; padding: 40px 20px;">
    <tr>
        <td align="center">

            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; background: linear-gradient(135deg, #1e293b 0%, #334155 100%); border-radius: 24px; overflow: hidden; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);">

                <tr>
                    <td style="padding: 40px 40px 30px; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                        <div style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #f43f5e 0%, #dc2626 100%); border-radius: 16px; margin-bottom: 16px; box-shadow: 0 8px 20px rgba(244, 63, 94, 0.3);">
                            <svg style="width: 64px; height: 64px; padding: 16px;" fill="none" stroke="white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18"></path>
                            </svg>
                        </div>
                        <h1 style="margin: 0; font-size: 28px; font-weight: bold; color: #ffffff;">{{ 'name'|trans({}, 'brand') }}</h1>
                        <p style="margin: 8px 0 0; font-size: 14px; color: #94a3b8;">{{ 'baseline'|trans({}, 'brand') }}</p>
                    </td>
                </tr>

                <tr>
                    <td style="padding: 40px;">

                        {{ include('reset_password/email/_body.html.twig') }}
                        {{ include('reset_password/email/_info_expiration.html.twig') }}
                        {{ include('reset_password/email/_security_note.html.twig') }}

                    </td>
                </tr>
                <tr>
                    {{ include('reset_password/email/_footer.html.twig') }}
                </tr>

            </table>

            {{ include('reset_password/email/_info_underline.html.twig') }}

        </td>
    </tr>
</table>

</body>
</html>
