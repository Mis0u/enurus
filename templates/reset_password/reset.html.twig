{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password_request.reset_password'|trans({}, 'security') }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4 py-12">
        <div class="max-w-md w-full">
            {# Logo/Brand Section #}
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-rose-500 to-red-600 rounded-2xl mb-4 shadow-lg shadow-rose-500/30">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">{{ 'name'|trans({}, 'brand') }}</h1>
                <p class="text-slate-400">{{ 'reset_password_request.new_password'|trans({}, 'security') }}</p>
            </div>

            <div class="backdrop-blur-xl bg-white/10 rounded-3xl shadow-2xl border border-white/20 p-8">
                <h2 class="text-2xl font-bold text-white mb-6">{{ 'field.new_password'|trans({}, 'common') }}</h2>

                <twig:Message:Info:Info
                    message="{{ 'field.security_password'|trans({}, 'common') }}"
                    icon="info"
                    variable="{{ 'sentence.password.security.min_char'|trans({'%min%': constant('App\\Form\\ChangePasswordFormType::MIN_LENGTH')}, 'common') }}"
                />

                {{ form_start(resetForm) }}
                {% if resetForm.plainPassword.first.vars.errors|length > 0 %}
                    <div class="mt-2 space-y-2">
                        {% for error in resetForm.plainPassword.first.vars.errors %}
                            <twig:Message:Error:Error message="{{ error.message }}" icon="red_cross"/>
                        {% endfor %}
                    </div>
                {% endif %}
                {% include 'reset_password/reset/_password_field.html.twig' %}

                {% include 'reset_password/reset/_confirm_password_field.html.twig' %}
                {% include 'reset_password/reset/_password_strength_indicator.html.twig' %}

                <twig:Button:Primary:Primary
                    message="{{ 'sentence.password.security.valid_new_password'|trans({}, 'common') }}"
                    icon="check"
                    :disabled="true"
                    data-password-validator-target="submitButton"
                />

                {{ form_end(resetForm) }}
            </div>

            {% include 'reset_password/reset/_security_notice.html.twig' %}

            {% include 'partials/_common/_footer.html.twig' %}
        </div>
    </div>
{% endblock %}
