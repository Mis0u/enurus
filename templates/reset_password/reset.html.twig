{% extends 'base.html.twig' %}

{% form_theme resetForm 'form/error_theme.html.twig' %}

{% block title %}{{ 'reset_password_request.reset_password'|trans({}, 'security') }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4 py-12">
        <div class="max-w-md w-full">
            <div class="text-center mb-8">
                {% include 'partials/_common/logo.html.twig' %}
                <p class="text-slate-400">{{ 'reset_password_request.new_password'|trans({}, 'security') }}</p>
            </div>

            <div class="backdrop-blur-xl bg-white/10 rounded-3xl shadow-2xl border border-white/20 p-8">
                <h2 class="text-2xl font-bold text-white mb-6">{{ 'field.new_password'|trans({}, 'common') }}</h2>

                <twig:Message:Info:Info
                    message="{{ 'field.security_password'|trans({}, 'common') }}"
                    icon="info"
                    variable="{{ 'sentence.password.security.min_char'|trans({'min': enum('App\\Enum\\Password\\PasswordRuleEnum').('MIN_LENGTH').value}, 'common') }}"
                />

                {{ form_start(resetForm) }}
                {{ form_errors(resetForm.plainPassword.first) }}
                {% include 'reset_password/reset/_password_field.html.twig' %}

                {% include 'reset_password/reset/_confirm_password_field.html.twig' %}
                {% include 'partials/_common/_security/_password_strength_indicator.html.twig' %}

                <twig:Button:Primary:Primary
                    message="{{ 'sentence.password.security.valid_new_password'|trans({}, 'common') }}"
                    icon="check"
                    :disabled="true"
                    data-password-validator-target="submitButton"
                />

                {{ form_end(resetForm) }}
            </div>

            {% include 'reset_password/reset/_security_notice.html.twig' %}

            {% include 'partials/_common/_footer.html.twig' %}
        </div>
    </div>
{% endblock %}
