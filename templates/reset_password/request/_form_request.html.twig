{{ form_start(requestForm) }}
<div class="space-y-2">
    {{ form_label(requestForm.email, null) }}
    <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            {% include 'partials/_svg/_envelope.html.twig' with {'extraClass': 'text-slate-400'} only %}
        </div>
        {{ form_widget(requestForm.email) }}
    </div>
</div>
<twig:Button:Secondary:Secondary
    message="{{ 'reset_password_request.send_link'|trans({}, 'navigation') }}"
    icon="envelope"
    data="data-controller=form--submit-spinner"
/>

{{ form_end(requestForm) }}
