{% if next %}
    <a
        href="{{ path(route, routeParams|merge({
            '_locale': app.request.locale,
            'page': next,
            'limit': per_page,
        })) }}"
        class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-white/[0.07] bg-white/[0.03] text-[12.5px] font-medium text-[#8b9bb4] hover:bg-white/[0.08] hover:border-white/[0.15] hover:text-[#f0f4ff] transition-all duration-250"
    >
        {{ 'pagination.next'|trans({}, 'navigation') }}
        {% include 'partials/_svg/_superior.html.twig' only %}
    </a>
{% else %}
    <span class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-white/[0.07] bg-white/[0.02] text-[12.5px] font-medium text-[#4a5568] opacity-40 cursor-not-allowed">
        {{ 'pagination.next'|trans({}, 'navigation') }}
        {% include 'partials/_svg/_superior.html.twig' only %}
    </span>
{% endif %}
