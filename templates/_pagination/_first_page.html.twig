<a
    href="{{ path(route, routeParams|merge({
        '_locale': app.request.locale,
        'page': first,
        'limit': per_page,
    })) }}"
    class="flex items-center justify-center px-2.5 h-8 rounded-lg border border-white/[0.07] bg-white/[0.03] text-[#8b9bb4] hover:bg-white/[0.08] hover:border-white/[0.15] hover:text-[#f0f4ff] transition-all duration-250"
    aria-label="{{ 'pagination.first'|trans({}, 'navigation') }}"
>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="11 17 6 12 11 7"></polyline>
        <polyline points="18 17 13 12 18 7"></polyline>
    </svg>
</a>
