# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
ADMIN_USER_EMAIL=admin-fixture@test.com
# Clé factice — aucun test ne doit réellement appeler l'API DeepL, uniquement suffisante pour que
# DeepLTranslationService puisse être instancié (les tests stubbent le service pour les cas
# multi-langues, cf. ContactBroadcastCrudControllerTest).
DEEPL_API_KEY=test-fake-deepl-key
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# DSN factice — aucun test ne doit réellement notifier Telegram, uniquement suffisant pour que
# le chatter_transport soit résolvable à la compilation du container.
TELEGRAM_DSN=telegram://123456789:test-fake-token@default?channel=123456789
